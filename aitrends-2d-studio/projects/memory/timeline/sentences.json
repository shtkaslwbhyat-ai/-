[
 {
  "i": 0,
  "start": 0.0,
  "end": 2.08,
  "text": "تَسْأَلُكَ أُخْتُكَ سَلْمَى."
 },
 {
  "i": 1,
  "start": 2.08,
  "end": 6.68,
  "text": "مَاذَا أَكَلْنَا يَوْمَ الثُّلَاثَاءِ قَبْلَ أَرْبَعِ سَنَوَاتٍ؟ تُجِيبُ فَوْرًا."
 },
 {
  "i": 2,
  "start": 6.68,
  "end": 8.82,
  "text": "أَرُزًّا وَمُلُوخِيَّةً."
 },
 {
  "i": 3,
  "start": 9.2,
  "end": 11.34,
  "text": "فِي الثَّانِيَةِ وَسَبْعِ دَقَائِقَ."
 },
 {
  "i": 4,
  "start": 12.0,
  "end": 14.24,
  "text": "وَكَانَتِ الْمُلُوخِيَّةُ مَالِحَةً قَلِيلًا."
 },
 {
  "i": 5,
  "start": 15.0,
  "end": 16.28,
  "text": "تَفْتَحُ سَلْمَى فَمَهَا."
 },
 {
  "i": 6,
  "start": 16.88,
  "end": 18.64,
  "text": "ثُمَّ تُغْلِقُهُ."
 },
 {
  "i": 7,
  "start": 18.64,
  "end": 21.9,
  "text": "يَسْأَلُكَ الْمُعَلِّمُ عَنْ دَرْسٍ شَرَحَهُ قَبْلَ عَامَيْنِ."
 },
 {
  "i": 8,
  "start": 21.9,
  "end": 24.62,
  "text": "تُعِيدُهُ كَلِمَةً كَلِمَةً."
 },
 {
  "i": 9,
  "start": 24.62,
  "end": 25.76,
  "text": "بِالنَّبْرَةِ نَفْسِهَا."
 },
 {
  "i": 10,
  "start": 26.48,
  "end": 28.54,
  "text": "وَبِالسُّعَالِ نَفْسِهِ فِي الْمُنْتَصَفِ."
 },
 {
  "i": 11,
  "start": 28.54,
  "end": 31.3,
  "text": "يَضْحَكُ الْفَصْلُ كُلُّهُ."
 },
 {
  "i": 12,
  "start": 31.3,
  "end": 33.34,
  "text": "الْمُعَلِّمُ لَا يَضْحَكُ."
 },
 {
  "i": 13,
  "start": 33.34,
  "end": 35.82,
  "text": "تَبْحَثُ أُمُّكَ عَنْ مَفَاتِيحِهَا."
 },
 {
  "i": 14,
  "start": 35.82,
  "end": 36.88,
  "text": "تَقُولُ لَهَا..."
 },
 {
  "i": 15,
  "start": 37.32,
  "end": 40.28,
  "text": "فِي جَيْبِ الْمِعْطَفِ الرَّمَادِيِّ يَا أُمِّي."
 },
 {
  "i": 16,
  "start": 40.28,
  "end": 42.44,
  "text": "وَضَعْتِهَا هُنَاكَ مَسَاءَ الْخَمِيسِ."
 },
 {
  "i": 17,
  "start": 42.94,
  "end": 45.02,
  "text": "فِي الثَّامِنَةِ وَعَشْرِ دَقَائِقَ."
 },
 {
  "i": 18,
  "start": 45.7,
  "end": 46.42,
  "text": "تَجِدُهَا."
 },
 {
  "i": 19,
  "start": 47.06,
  "end": 49.2,
  "text": "ثُمَّ تَنْظُرُ إِلَيْكَ نَظْرَةً غَرِيبَةً."
 },
 {
  "i": 20,
  "start": 49.72,
  "end": 51.92,
  "text": "فِي الْمَخْبَزِ يُعْطِيكَ الْبَائِعُ الْبَاقِيَ."
 },
 {
  "i": 21,
  "start": 52.7,
  "end": 57.42,
  "text": "فَتُذَكِّرُهُ بِلُطْفٍ أَنَّهُ أَنْقَصَ مِنْ بَاقِيكَ جُنَيْهًا وَاحِدًا قَبْلَ ثَلَاثِ سَنَوَاتٍ."
 },
 {
  "i": 22,
  "start": 57.42,
  "end": 59.56,
  "text": "يَضْحَكُ."
 },
 {
  "i": 23,
  "start": 59.56,
  "end": 61.78,
  "text": "ثُمَّ يُعْطِيكَ الْجُنَيْهَ."
 },
 {
  "i": 24,
  "start": 61.78,
  "end": 67.56,
  "text": "وَجَوْرَبُكَ الْأَزْرَقُ؟ آخِرُ مَرَّةٍ رَأَيْتَهُ فِيهَا كَانَتْ قَبْلَ ثَلَاثَةٍ وَأَرْبَعِينَ يَوْمًا."
 },
 {
  "i": 25,
  "start": 68.34,
  "end": 69.4,
  "text": "تَحْتَ السَّرِيرِ."
 },
 {
  "i": 26,
  "start": 70.06,
  "end": 71.6,
  "text": "وَهُوَ لَيْسَ هُنَاكَ."
 },
 {
  "i": 27,
  "start": 71.6,
  "end": 76.58,
  "text": "مُعْظَمُ النَّاسِ لَا يَتَذَكَّرُونَ مَاذَا فَعَلُوا فِي يَوْمٍ عَادِيٍّ قَبْلَ خَمْسِ سَنَوَاتٍ."
 },
 {
  "i": 28,
  "start": 77.16,
  "end": 84.24,
  "text": "فِي عَامِ 1885 وَصَفَ عَالِمٌ أَلْمَانِيٌّ اسْمُهُ هِيرْمَانُ إِبِنْغْهَاوْس مَا يُسَمَّى مُنْحَنَى النِّسْيَانِ."
 },
 {
  "i": 29,
  "start": 84.95,
  "end": 87.54,
  "text": "نَحْنُ نَفْقِدُ جُزْءًا كَبِيرًا مِمَّا نَتَعَلَّمُهُ."
 },
 {
  "i": 30,
  "start": 87.54,
  "end": 91.14,
  "text": "خِلَالَ السَّاعَاتِ وَالْأَيَّامِ الْأُولَى."
 },
 {
  "i": 31,
  "start": 91.14,
  "end": 94.06,
  "text": "وَأَنْتَ؟ لَا تَفْقِدُ شَيْئًا."
 },
 {
  "i": 32,
  "start": 94.06,
  "end": 95.44,
  "text": "لَا شَيْءَ."
 },
 {
  "i": 33,
  "start": 95.44,
  "end": 99.64,
  "text": "ثَمَانُونَ عَامًا مِنَ الْعُمْرِ تُسَاوِي نَحْوَ مِلْيَارَيْنِ وَنِصْفِ مِلْيَارِ ثَانِيَةٍ."
 },
 {
  "i": 34,
  "start": 100.28,
  "end": 102.46,
  "text": "وَأَنْتَ تَحْفَظُ كُلَّ ثَانِيَةٍ مِنْهَا."
 },
 {
  "i": 35,
  "start": 103.12,
  "end": 104.16,
  "text": "بِتَارِيخِهَا."
 },
 {
  "i": 36,
  "start": 104.84,
  "end": 105.82,
  "text": "بِسَاعَتِهَا."
 },
 {
  "i": 37,
  "start": 106.52,
  "end": 107.54,
  "text": "بِإِحْسَاسِهَا."
 },
 {
  "i": 38,
  "start": 108.19,
  "end": 111.18,
  "text": "لَكِنَّ لِهَذِهِ الْقُدْرَةِ قَاعِدَةً وَاحِدَةً."
 },
 {
  "i": 39,
  "start": 111.18,
  "end": 113.8,
  "text": "أَنْتَ لَا تَسْتَطِيعُ أَنْ تَنْسَى."
 },
 {
  "i": 40,
  "start": 113.8,
  "end": 116.2,
  "text": "وَلَا تَسْتَطِيعُ أَنْ تَخْتَارَ مَا تَتَذَكَّرُ."
 },
 {
  "i": 41,
  "start": 116.96,
  "end": 118.44,
  "text": "وَكُلُّ ذِكْرَى تَفْتَحُهَا..."
 },
 {
  "i": 42,
  "start": 119.14,
  "end": 120.94,
  "text": "تَعُودُ بِمَشَاعِرِهَا كَامِلَةً."
 },
 {
  "i": 43,
  "start": 121.6,
  "end": 123.1,
  "text": "كَأَنَّهَا تَحْدُثُ الْآنَ."
 },
 {
  "i": 44,
  "start": 123.84,
  "end": 126.84,
  "text": "وَسَتَتَعَلَّمُ يَوْمًا شَيْئًا مُهِمًّا."
 },
 {
  "i": 45,
  "start": 126.84,
  "end": 129.32,
  "text": "عَقْلُكَ يَحْفَظُ كُلَّ شَيْءٍ..."
 },
 {
  "i": 46,
  "start": 129.32,
  "end": 132.28,
  "text": "لَكِنَّ قَلْبَكَ هُوَ الَّذِي يَخْتَارُ مَا يَبْقَى."
 },
 {
  "i": 47,
  "start": 132.28,
  "end": 133.4,
  "text": "اسْمُكَ يُوسُفُ."
 },
 {
  "i": 48,
  "start": 134.04,
  "end": 136.46,
  "text": "عُمْرُكَ سَبْعَةَ عَشَرَ عَامًا."
 },
 {
  "i": 49,
  "start": 136.46,
  "end": 141.36,
  "text": "فَمَاذَا لَوْ تَذَكَّرْتَ كُلَّ ثَانِيَةٍ مِنْ حَيَاتِكَ؟ تَبْدَأُ بِالْمَدْرَسَةِ."
 },
 {
  "i": 50,
  "start": 141.7,
  "end": 144.46,
  "text": "تَقْرَأُ الْكِتَابَ مَرَّةً وَاحِدَةً فِي سِبْتَمْبَر."
 },
 {
  "i": 51,
  "start": 144.92,
  "end": 147.72,
  "text": "وَفِي الِامْتِحَانِ تَرَى الصَّفْحَةَ أَمَامَ عَيْنَيْكَ."
 },
 {
  "i": 52,
  "start": 148.52,
  "end": 149.28,
  "text": "بِرَقْمِهَا."
 },
 {
  "i": 53,
  "start": 150.04,
  "end": 152.1,
  "text": "وَبِبُقْعَةِ الشَّايِ فِي زَاوِيَتِهَا."
 },
 {
  "i": 54,
  "start": 152.84,
  "end": 155.84,
  "text": "الدَّرَجَةُ؟ مِئَةٌ مِنْ مِئَةٍ."
 },
 {
  "i": 55,
  "start": 155.84,
  "end": 158.88,
  "text": "زُمَلَاؤُكَ يَسْهَرُونَ أُسْبُوعًا كَامِلًا."
 },
 {
  "i": 56,
  "start": 158.88,
  "end": 161.22,
  "text": "أَنْتَ تَنَامُ مُبَكِّرًا."
 },
 {
  "i": 57,
  "start": 161.22,
  "end": 161.94,
  "text": "أَوْ تُحَاوِلُ."
 },
 {
  "i": 58,
  "start": 162.52,
  "end": 165.18,
  "text": "ثُمَّ يَخْتَبِرُكَ أَصْدِقَاؤُكَ."
 },
 {
  "i": 59,
  "start": 165.18,
  "end": 166.5,
  "text": "يَقُولُ أَحَدُهُمْ."
 },
 {
  "i": 60,
  "start": 167.2,
  "end": 169.52,
  "text": "الْخَامِسَ عَشَرَ مِنْ مَارِس 2019."
 },
 {
  "i": 61,
  "start": 170.52,
  "end": 171.3,
  "text": "تُجِيبُ."
 },
 {
  "i": 62,
  "start": 171.68,
  "end": 173.04,
  "text": "كَانَ يَوْمَ جُمُعَةٍ."
 },
 {
  "i": 63,
  "start": 173.66,
  "end": 175.46,
  "text": "كَانَتِ السَّمَاءُ غَائِمَةً."
 },
 {
  "i": 64,
  "start": 175.46,
  "end": 178.447,
  "text": "وَكُنْتَ تَرْتَدِي قَمِيصًا أَخْضَرَ."
 },
 {
  "i": 65,
  "start": 178.447,
  "end": 181.1,
  "text": "يَفْتَحُ هَاتِفَهُ لِيَتَأَكَّدَ مِنَ الصُّوَرِ."
 },
 {
  "i": 66,
  "start": 181.1,
  "end": 183.64,
  "text": "الْقَمِيصُ أَخْضَرُ."
 },
 {
  "i": 67,
  "start": 183.64,
  "end": 185.62,
  "text": "يُغْلِقُ هَاتِفَهُ بِبُطْءٍ."
 },
 {
  "i": 68,
  "start": 185.62,
  "end": 189.14,
  "text": "أَبُوكَ يُرَاهِنُكَ عَلَى مُبَارَاةِ كُرَةِ قَدَمٍ قَدِيمَةٍ."
 },
 {
  "i": 69,
  "start": 189.56,
  "end": 191.1,
  "text": "قَبْلَ سِتِّ سَنَوَاتٍ."
 },
 {
  "i": 70,
  "start": 191.68,
  "end": 194.12,
  "text": "تَصِفُ لَهُ الْأَهْدَافَ الثَّلَاثَةَ."
 },
 {
  "i": 71,
  "start": 194.12,
  "end": 196.06,
  "text": "وَالتَّمْرِيرَاتِ الَّتِي سَبَقَتْهَا."
 },
 {
  "i": 72,
  "start": 196.64,
  "end": 197.66,
  "text": "وَاسْمَ الْحَكَمِ."
 },
 {
  "i": 73,
  "start": 197.66,
  "end": 202.46,
  "text": "وَمَاذَا صَرَخَ هُوَ فِي وَجْهِ التِّلْفَازِ فِي الدَّقِيقَةِ الْخَامِسَةِ وَالثَّمَانِينَ."
 },
 {
  "i": 74,
  "start": 203.22,
  "end": 204.9,
  "text": "يَدْفَعُ أَبُوكَ ثَمَنَ الْعَشَاءِ."
 },
 {
  "i": 75,
  "start": 205.68,
  "end": 208.44,
  "text": "وَلَا يُرَاهِنُكَ مَرَّةً أُخْرَى."
 },
 {
  "i": 76,
  "start": 208.44,
  "end": 211.28,
  "text": "فِي كُلِّ خِلَافٍ عَائِلِيٍّ يَلْتَفِتُ الْجَمِيعُ إِلَيْكَ."
 },
 {
  "i": 77,
  "start": 211.72,
  "end": 217.04,
  "text": "مَنْ قَالَ مَاذَا؟ وَمَتَى؟ تُعِيدُ الْكَلَامَ حَرْفًا حَرْفًا."
 },
 {
  "i": 78,
  "start": 217.04,
  "end": 219.12,
  "text": "يَنْتَهِي الْخِلَافُ فِي دَقِيقَتَيْنِ."
 },
 {
  "i": 79,
  "start": 219.94,
  "end": 221.32,
  "text": "وَبَعْدَ شَهْرٍ..."
 },
 {
  "i": 80,
  "start": 221.9,
  "end": 224.5,
  "text": "لَمْ يَعُدْ أَحَدٌ يَدْعُوكَ إِلَى أَيِّ خِلَافٍ."
 },
 {
  "i": 81,
  "start": 225.22,
  "end": 228.24,
  "text": "تُشَاهِدُ فِيلْمًا يَابَانِيًّا مُدَّتُهُ تِسْعُونَ دَقِيقَةً."
 },
 {
  "i": 82,
  "start": 228.94,
  "end": 230.44,
  "text": "مَرَّةً وَاحِدَةً."
 },
 {
  "i": 83,
  "start": 230.44,
  "end": 234.52,
  "text": "ثُمَّ تُعِيدُ حِوَارَهُ كُلَّهُ بِالْيَابَانِيَّةِ عَلَى مَائِدَةِ الْغَدَاءِ."
 },
 {
  "i": 84,
  "start": 235.04,
  "end": 238.32,
  "text": "هَلْ فَهِمْتَ كَلِمَةً وَاحِدَةً مِنْهُ؟ لَا."
 },
 {
  "i": 85,
  "start": 238.96,
  "end": 240.38,
  "text": "لَكِنَّ النُّطْقَ مُمْتَازٌ."
 },
 {
  "i": 86,
  "start": 240.98,
  "end": 244.66,
  "text": "ثُمَّ تَأْخُذُكَ أُمُّكَ إِلَى عِيَادَةِ الدُّكْتُورَةِ مَايَا."
 },
 {
  "i": 87,
  "start": 244.66,
  "end": 245.82,
  "text": "طَبِيبَةُ أَعْصَابٍ."
 },
 {
  "i": 88,
  "start": 246.54,
  "end": 250.68,
  "text": "تُخْبِرُكَ أَنَّ فِي الدِّمَاغِ نَحْوَ سِتَّةٍ وَثَمَانِينَ مِلْيَارَ خَلِيَّةٍ عَصَبِيَّةٍ."
 },
 {
  "i": 89,
  "start": 251.27,
  "end": 255.04,
  "text": "وَأَنَّ حَالَاتٍ تُشْبِهُ حَالَتَكَ مَوْجُودَةٌ فِعْلًا."
 },
 {
  "i": 90,
  "start": 255.04,
  "end": 258.22,
  "text": "أَوَّلُ حَالَةٍ وُثِّقَتْ عِلْمِيًّا نُشِرَتْ عَامَ 2006."
 },
 {
  "i": 91,
  "start": 258.22,
  "end": 262.43,
  "text": "لِامْرَأَةٍ أَمْرِيكِيَّةٍ اسْمُهَا جِيل بْرَايْس."
 },
 {
  "i": 92,
  "start": 262.43,
  "end": 265.52,
  "text": "وَعَدَدُ الْحَالَاتِ الْمُؤَكَّدَةِ فِي الْعَالَمِ كُلِّهِ..."
 },
 {
  "i": 93,
  "start": 265.52,
  "end": 266.94,
  "text": "بِضْعُ عَشَرَاتٍ فَقَطْ."
 },
 {
  "i": 94,
  "start": 267.53,
  "end": 269.8,
  "text": "ثُمَّ تَنْظُرُ إِلَى نَتَائِجِكَ وَتَقُولُ..."
 },
 {
  "i": 95,
  "start": 270.57,
  "end": 272.4,
  "text": "أَنْتَ أَبْعَدُ مِنْ كُلِّ هَؤُلَاءِ."
 },
 {
  "i": 96,
  "start": 273.11,
  "end": 274.88,
  "text": "ثُمَّ يَأْتِي يَوْمٌ مُخْتَلِفٌ."
 },
 {
  "i": 97,
  "start": 275.68,
  "end": 277.24,
  "text": "دَرَّاجَةُ جَارِكُمْ تُسْرَقُ."
 },
 {
  "i": 98,
  "start": 277.96,
  "end": 279.76,
  "text": "الشُّرْطَةُ لَا تَمْلِكُ أَيَّ خَيْطٍ."
 },
 {
  "i": 99,
  "start": 280.48,
  "end": 284.22,
  "text": "لَكِنَّكَ رَأَيْتَ سَيَّارَةً غَرِيبَةً فِي الشَّارِعِ قَبْلَ ثَلَاثَةِ أَشْهُرٍ."
 },
 {
  "i": 100,
  "start": 284.22,
  "end": 286.3,
  "text": "لِثَانِيَتَيْنِ فَقَطْ."
 },
 {
  "i": 101,
  "start": 286.3,
  "end": 289.96,
  "text": "وَتَتَذَكَّرُ رَقْمَ لَوْحَتِهَا كَامِلًا."
 },
 {
  "i": 102,
  "start": 289.96,
  "end": 292.48,
  "text": "بَعْدَ يَوْمَيْنِ تَعُودُ الدَّرَّاجَةُ."
 },
 {
  "i": 103,
  "start": 292.48,
  "end": 295.02,
  "text": "ثُمَّ تَدْعُوكَ بُطُولَةٌ دَوْلِيَّةٌ لِلذَّاكِرَةِ."
 },
 {
  "i": 104,
  "start": 295.8,
  "end": 299.12,
  "text": "يُطْلَبُ مِنْكَ حِفْظُ أَلْفِ رَقْمٍ عَشْوَائِيٍّ فِي عَشْرِ دَقَائِقَ."
 },
 {
  "i": 105,
  "start": 299.88,
  "end": 301.02,
  "text": "تَحْفَظُهَا كُلَّهَا."
 },
 {
  "i": 106,
  "start": 301.76,
  "end": 305.44,
  "text": "لِأَنَّكَ عِشْتَ تِلْكَ الدَّقَائِقَ الْعَشْرَ ثَانِيَةً ثَانِيَةً."
 },
 {
  "i": 107,
  "start": 305.44,
  "end": 307.24,
  "text": "الْحُكَّامُ مَذْهُولُونَ."
 },
 {
  "i": 108,
  "start": 307.24,
  "end": 309.87,
  "text": "وَأَنْتَ تَتَسَاءَلُ فِي سِرِّكَ."
 },
 {
  "i": 109,
  "start": 309.87,
  "end": 315.46,
  "text": "هَلْ هَذِهِ مَوْهِبَةٌ؟ أَمْ أَنَّكَ لَا تَسْتَطِيعُ أَنْ تَنْسَى فَقَطْ؟ وَبَعْدَهَا."
 },
 {
  "i": 110,
  "start": 316.16,
  "end": 317.82,
  "text": "الْعَالَمُ كُلُّهُ."
 },
 {
  "i": 111,
  "start": 317.82,
  "end": 320.0,
  "text": "بَرْنَامَجٌ تِلِفِزْيُونِيٌّ يَدْعُوكَ."
 },
 {
  "i": 112,
  "start": 320.56,
  "end": 322.7,
  "text": "الْمُشَاهِدُونَ يُرْسِلُونَ تَوَارِيخَ."
 },
 {
  "i": 113,
  "start": 322.7,
  "end": 326.28,
  "text": "ثَلَاثُمِئَةِ تَارِيخٍ فِي سَاعَةٍ وَاحِدَةٍ."
 },
 {
  "i": 114,
  "start": 326.28,
  "end": 327.96,
  "text": "تُجِيبُ عَنْهَا كُلِّهَا."
 },
 {
  "i": 115,
  "start": 328.72,
  "end": 332.08,
  "text": "الْمَقْطَعُ يَصِلُ إِلَى عِشْرِينَ مِلْيُونَ مُشَاهَدَةٍ فِي أُسْبُوعٍ."
 },
 {
  "i": 116,
  "start": 332.76,
  "end": 335.96,
  "text": "الصُّحُفُ تُسَمِّيكَ الْفَتَى الَّذِي لَا يَنْسَى."
 },
 {
  "i": 117,
  "start": 335.96,
  "end": 338.46,
  "text": "وَأَنْتَ تَبْتَسِمُ لِلْكَامِيرَا."
 },
 {
  "i": 118,
  "start": 338.46,
  "end": 340.7,
  "text": "لَكِنَّكَ مُتْعَبٌ جِدًّا."
 },
 {
  "i": 119,
  "start": 340.7,
  "end": 343.0,
  "text": "لِأَنَّ هُنَاكَ شَيْئًا لَا يَعْرِفُهُ أَحَدٌ."
 },
 {
  "i": 120,
  "start": 343.58,
  "end": 345.58,
  "text": "كُلَّ لَيْلَةٍ تُغْمِضُ عَيْنَيْكَ."
 },
 {
  "i": 121,
  "start": 346.28,
  "end": 347.94,
  "text": "فَيَبْدَأُ الْيَوْمُ مِنْ جَدِيدٍ."
 },
 {
  "i": 122,
  "start": 348.38,
  "end": 349.44,
  "text": "كُلُّ وَجْهٍ."
 },
 {
  "i": 123,
  "start": 349.82,
  "end": 350.82,
  "text": "كُلُّ صَوْتٍ."
 },
 {
  "i": 124,
  "start": 351.34,
  "end": 352.74,
  "text": "كُلُّ كَلِمَةٍ."
 },
 {
  "i": 125,
  "start": 352.74,
  "end": 354.6,
  "text": "تَنَامُ فِي الثَّالِثَةِ فَجْرًا."
 },
 {
  "i": 126,
  "start": 355.5,
  "end": 356.94,
  "text": "وَتَسْتَيْقِظُ فِي السَّابِعَةِ."
 },
 {
  "i": 127,
  "start": 357.66,
  "end": 360.52,
  "text": "وَهُنَاكَ أَشْيَاءُ صَغِيرَةٌ تَخْتَفِي مِنْ حَيَاتِكَ."
 },
 {
  "i": 128,
  "start": 361.16,
  "end": 366.68,
  "text": "فِيلْمُكَ الْمُفَضَّلُ؟ لَا تَسْتَطِيعُ أَنْ تُشَاهِدَهُ مَرَّةً ثَانِيَةً كَأَنَّهُ جَدِيدٌ."
 },
 {
  "i": 129,
  "start": 367.3,
  "end": 370.48,
  "text": "وَحِينَ سَقَطْتَ عَنِ الدَّرَّاجَةِ فِي الْخَامِسَةِ مِنْ عُمْرِكَ..."
 },
 {
  "i": 130,
  "start": 370.96,
  "end": 374.86,
  "text": "مَا زِلْتَ تَشْعُرُ بِحَرَارَةِ الْأَرْضِ عَلَى رُكْبَتِكَ كُلَّمَا تَذَكَّرْتَ."
 },
 {
  "i": 131,
  "start": 374.86,
  "end": 376.82,
  "text": "وَهُنَاكَ مَا هُوَ أَسْوَأُ."
 },
 {
  "i": 132,
  "start": 377.44,
  "end": 378.66,
  "text": "قَبْلَ عَامَيْنِ..."
 },
 {
  "i": 133,
  "start": 379.04,
  "end": 382.56,
  "text": "قَالَ لَكَ صَدِيقُكَ آدَمُ كَلِمَةً جَارِحَةً أَمَامَ الْجَمِيعِ."
 },
 {
  "i": 134,
  "start": 383.22,
  "end": 384.78,
  "text": "اعْتَذَرَ فِي الْيَوْمِ نَفْسِهِ."
 },
 {
  "i": 135,
  "start": 385.34,
  "end": 386.98,
  "text": "النَّاسُ نَسُوا."
 },
 {
  "i": 136,
  "start": 386.98,
  "end": 387.88,
  "text": "آدَمُ نَسِيَ."
 },
 {
  "i": 137,
  "start": 388.58,
  "end": 390.96,
  "text": "وَأَنْتَ؟ تَسْمَعُهَا الْآنَ."
 },
 {
  "i": 138,
  "start": 391.72,
  "end": 392.9,
  "text": "بِالنَّبْرَةِ نَفْسِهَا."
 },
 {
  "i": 139,
  "start": 393.6,
  "end": 394.92,
  "text": "وَبِالْوَجَعِ نَفْسِهِ."
 },
 {
  "i": 140,
  "start": 395.48,
  "end": 397.4,
  "text": "كَأَنَّهَا قِيلَتْ قَبْلَ دَقِيقَةٍ."
 },
 {
  "i": 141,
  "start": 398.04,
  "end": 403.68,
  "text": "فَكَيْفَ تُسَامِحُ عَلَى جُرْحٍ لَا يَشِيخُ أَبَدًا؟ تَشْرَحُ لَكَ الدُّكْتُورَةُ مَايَا."
 },
 {
  "i": 142,
  "start": 403.68,
  "end": 405.94,
  "text": "النِّسْيَانُ لَيْسَ عُطْلًا."
 },
 {
  "i": 143,
  "start": 405.94,
  "end": 409.52,
  "text": "إِنَّهُ يُسَاعِدُ الدِّمَاغَ عَلَى رُؤْيَةِ الصُّورَةِ الْكَبِيرَةِ..."
 },
 {
  "i": 144,
  "start": 409.52,
  "end": 412.36,
  "text": "وَيُخَفِّفُ حِدَّةَ الذِّكْرَيَاتِ الْمُؤْلِمَةِ مَعَ الْوَقْتِ."
 },
 {
  "i": 145,
  "start": 412.96,
  "end": 416.48,
  "text": "وَتُخْبِرُكَ عَنْ عَالِمِ نَفْسٍ سُوفْيِيتِيٍّ اسْمُهُ أَلِكْسَنْدَر لُورْيَا."
 },
 {
  "i": 146,
  "start": 417.23,
  "end": 421.16,
  "text": "دَرَسَ ثَلَاثِينَ عَامًا تَقْرِيبًا رَجُلًا اسْمُهُ شِيرِشِفْسْكِي."
 },
 {
  "i": 147,
  "start": 421.16,
  "end": 424.02,
  "text": "كَانَ يَحْفَظُ كُلَّ شَيْءٍ تَقْرِيبًا."
 },
 {
  "i": 148,
  "start": 424.02,
  "end": 426.0,
  "text": "وَكَانَ يَجِدُ صُعُوبَةً فِي النِّسْيَانِ."
 },
 {
  "i": 149,
  "start": 426.75,
  "end": 429.75,
  "text": "وَفِي فَهْمِ الْمَعَانِي الْمُجَرَّدَةِ."
 },
 {
  "i": 150,
  "start": 429.75,
  "end": 432.36,
  "text": "نَشَرَ لُورْيَا كِتَابَهُ عَنْهُ عَامَ 1968."
 },
 {
  "i": 151,
  "start": 434.41,
  "end": 436.54,
  "text": "ثُمَّ تَقُولُ لَكَ بِهُدُوءٍ..."
 },
 {
  "i": 152,
  "start": 436.54,
  "end": 439.76,
  "text": "التَّفَاصِيلُ الْكَثِيرَةُ قَدْ تُخْفِي عَنْكَ الطَّرِيقَ يَا يُوسُفُ."
 },
 {
  "i": 153,
  "start": 440.48,
  "end": 441.76,
  "text": "وَأَنْتَ لَا تَعْرِفُ بَعْدُ..."
 },
 {
  "i": 154,
  "start": 442.49,
  "end": 444.48,
  "text": "كَمْ سَتَحْتَاجُ إِلَى هَذِهِ الْجُمْلَةِ."
 },
 {
  "i": 155,
  "start": 445.15,
  "end": 450.18,
  "text": "وَمَعَ الْوَقْتِ صِرْتَ الشَّخْصَ الَّذِي يُصَحِّحُ لِلْجَمِيعِ كُلَّ تَارِيخٍ وَكُلَّ كَلِمَةٍ."
 },
 {
  "i": 156,
  "start": 450.18,
  "end": 454.2,
  "text": "وَصَارَ أَصْدِقَاؤُكَ يَخْتَارُونَ كَلِمَاتِهِمْ أَمَامَكَ بِحَذَرٍ شَدِيدٍ."
 },
 {
  "i": 157,
  "start": 454.63,
  "end": 459.92,
  "text": "فَمَنْ يُرِيدُ صَدِيقًا لَا يَنْسَى أَيَّ خَطَأٍ؟ فِي الْبَيْتِ جَدَّتُكَ لَيْلَى."
 },
 {
  "i": 158,
  "start": 459.92,
  "end": 461.38,
  "text": "أَحَبُّ النَّاسِ إِلَيْكَ."
 },
 {
  "i": 159,
  "start": 462.04,
  "end": 464.1,
  "text": "وَأَكْثَرُهُمْ ضَحِكًا."
 },
 {
  "i": 160,
  "start": 464.1,
  "end": 468.52,
  "text": "لَكِنَّ الطَّبِيبَ قَالَ قَبْلَ عَامٍ إِنَّهَا فِي بِدَايَاتِ مَرَضِ الزَّهَايْمَرِ."
 },
 {
  "i": 161,
  "start": 468.52,
  "end": 470.36,
  "text": "تَسْأَلُكَ الْيَوْمَ ثَلَاثَ مَرَّاتٍ..."
 },
 {
  "i": 162,
  "start": 470.89,
  "end": 476.12,
  "text": "هَلْ أَكَلْتَ يَا حَبِيبِي؟ وَتُجِيبُهَا فِي كُلِّ مَرَّةٍ كَأَنَّهَا الْأُولَى."
 },
 {
  "i": 163,
  "start": 476.12,
  "end": 479.4,
  "text": "هِيَ الَّتِي عَلَّمَتْكَ صُنْعَ الشَّايِ وَأَنْتَ فِي السَّادِسَةِ."
 },
 {
  "i": 164,
  "start": 479.4,
  "end": 481.38,
  "text": "مِلْعَقَتَانِ مِنَ السُّكَّرِ."
 },
 {
  "i": 165,
  "start": 482.12,
  "end": 484.48,
  "text": "وَوَرَقَةُ نَعْنَاعٍ وَاحِدَةٌ."
 },
 {
  "i": 166,
  "start": 484.48,
  "end": 486.18,
  "text": "وَالْأُسْبُوعَ الْمَاضِيَ..."
 },
 {
  "i": 167,
  "start": 486.18,
  "end": 488.06,
  "text": "نَادَتْكَ بِاسْمِ أَبِيكَ."
 },
 {
  "i": 168,
  "start": 488.52,
  "end": 491.84,
  "text": "ثُمَّ ضَحِكَتْ وَقَالَتْ إِنَّكُمَا تَتَشَابَهَانِ."
 },
 {
  "i": 169,
  "start": 491.84,
  "end": 493.08,
  "text": "أَنْتَ لَمْ تَضْحَكْ."
 },
 {
  "i": 170,
  "start": 493.5,
  "end": 495.32,
  "text": "هِيَ تَنْسَى كُلَّ يَوْمٍ أَكْثَرَ."
 },
 {
  "i": 171,
  "start": 496.04,
  "end": 498.12,
  "text": "وَأَنْتَ لَا تَنْسَى شَيْئًا."
 },
 {
  "i": 172,
  "start": 498.12,
  "end": 500.66,
  "text": "عِنْدَمَا تَطْبُخُ تُدَنْدِنُ أُغْنِيَةً قَدِيمَةً."
 },
 {
  "i": 173,
  "start": 501.38,
  "end": 503.67,
  "text": "تَسْأَلُهَا عَنِ اسْمِهَا."
 },
 {
  "i": 174,
  "start": 503.67,
  "end": 505.06,
  "text": "فَتَضْحَكُ."
 },
 {
  "i": 175,
  "start": 505.06,
  "end": 505.86,
  "text": "نَسِيتُهُ."
 },
 {
  "i": 176,
  "start": 506.46,
  "end": 508.1,
  "text": "لَكِنَّ اللَّحْنَ لَا يَذْهَبُ."
 },
 {
  "i": 177,
  "start": 508.1,
  "end": 511.36,
  "text": "وَتَحْكِي لَكَ عَنْ مَقْهًى صَغِيرٍ قُرْبَ الْبَحْرِ."
 },
 {
  "i": 178,
  "start": 511.94,
  "end": 513.9,
  "text": "هُنَاكَ الْتَقَتْ بِجَدِّكَ أَوَّلَ مَرَّةٍ."
 },
 {
  "i": 179,
  "start": 514.58,
  "end": 516.98,
  "text": "حَكَتْهَا لَكَ مِئَةً وَسَبْعَ عَشْرَةَ مَرَّةً."
 },
 {
  "i": 180,
  "start": 517.66,
  "end": 519.4,
  "text": "وَأَنْتَ تَتَذَكَّرُ كُلَّ مَرَّةٍ."
 },
 {
  "i": 181,
  "start": 520.02,
  "end": 523.5,
  "text": "حَتَّى الْمَرَّاتِ الَّتِي غَيَّرَتْ فِيهَا لَوْنَ فُسْتَانِهَا."
 },
 {
  "i": 182,
  "start": 523.5,
  "end": 525.62,
  "text": "تَضَعُ يَدَهَا عَلَى صَدْرِكَ وَتَقُولُ..."
 },
 {
  "i": 183,
  "start": 526.38,
  "end": 528.36,
  "text": "الذَّاكِرَةُ صُنْدُوقٌ يَا يُوسُفُ."
 },
 {
  "i": 184,
  "start": 529.08,
  "end": 530.66,
  "text": "وَالْقَلْبُ مِفْتَاحُهُ."
 },
 {
  "i": 185,
  "start": 530.66,
  "end": 532.02,
  "text": "تَبْتَسِمُ لَهَا."
 },
 {
  "i": 186,
  "start": 532.53,
  "end": 533.52,
  "text": "وَلَا تَفْهَمُ."
 },
 {
  "i": 187,
  "start": 534.29,
  "end": 538.18,
  "text": "وَحِينَ تَنَامُ فِي الْمَسَاءِ تَجْلِسُ بِجَانِبِهَا قَلِيلًا..."
 },
 {
  "i": 188,
  "start": 538.18,
  "end": 541.79,
  "text": "وَتَتَمَنَّى لَوْ تَسْتَطِيعُ أَنْ تُعْطِيَهَا نِصْفَ ذَاكِرَتِكَ."
 },
 {
  "i": 189,
  "start": 541.79,
  "end": 543.38,
  "text": "ثُمَّ يَأْتِي يَوْمُ الْجُمُعَةِ."
 },
 {
  "i": 190,
  "start": 544.16,
  "end": 546.12,
  "text": "الرَّابِعَةُ عَصْرًا."
 },
 {
  "i": 191,
  "start": 546.12,
  "end": 547.95,
  "text": "يَرِنُّ هَاتِفُكَ."
 },
 {
  "i": 192,
  "start": 547.95,
  "end": 549.64,
  "text": "صَوْتُ أُمِّكَ يَرْتَجِفُ."
 },
 {
  "i": 193,
  "start": 550.24,
  "end": 552.84,
  "text": "جَدَّتُكَ خَرَجَتْ مِنَ الْبَيْتِ قَبْلَ سَاعَتَيْنِ..."
 },
 {
  "i": 194,
  "start": 553.47,
  "end": 554.4,
  "text": "وَلَمْ تَعُدْ."
 },
 {
  "i": 195,
  "start": 555.2,
  "end": 557.04,
  "text": "هَاتِفُهَا عَلَى الطَّاوِلَةِ."
 },
 {
  "i": 196,
  "start": 557.04,
  "end": 559.84,
  "text": "الشَّمْسُ تَغِيبُ بَعْدَ أَرْبَعِينَ دَقِيقَةً."
 },
 {
  "i": 197,
  "start": 560.39,
  "end": 561.64,
  "text": "وَالْهَوَاءُ بَارِدٌ."
 },
 {
  "i": 198,
  "start": 562.03,
  "end": 565.54,
  "text": "أَنْتَ تَعْرِفُ كُلَّ مَكَانٍ ذَكَرَتْهُ جَدَّتُكَ فِي حَيَاتِهَا."
 },
 {
  "i": 199,
  "start": 566.07,
  "end": 567.88,
  "text": "هَذِهِ قُوَّتُكَ."
 },
 {
  "i": 200,
  "start": 567.88,
  "end": 571.16,
  "text": "أَلَيْسَ كَذَلِكَ؟ تُغْمِضُ عَيْنَيْكَ."
 },
 {
  "i": 201,
  "start": 571.76,
  "end": 573.1,
  "text": "وَيَنْفَتِحُ الْأَرْشِيفُ."
 },
 {
  "i": 202,
  "start": 573.73,
  "end": 574.94,
  "text": "سُوقُ الْخُضَارِ."
 },
 {
  "i": 203,
  "start": 575.41,
  "end": 577.82,
  "text": "بَيْتُ خَالَتِهَا الْقَدِيمُ."
 },
 {
  "i": 204,
  "start": 577.82,
  "end": 580.2,
  "text": "مَحَطَّةُ الْقِطَارِ."
 },
 {
  "i": 205,
  "start": 580.96,
  "end": 582.84,
  "text": "الْمَدْرَسَةُ الَّتِي عَمِلَتْ فِيهَا."
 },
 {
  "i": 206,
  "start": 583.15,
  "end": 588.62,
  "text": "هَلْ ذَهَبَتْ إِلَى الْمَحَطَّةِ؟ إِنَّهَا عَلَى بُعْدِ اثْنَيْ عَشَرَ كِيلُومِتْرًا."
 },
 {
  "i": 207,
  "start": 588.62,
  "end": 592.28,
  "text": "إِلَى السُّوقِ؟ السُّوقُ يُغْلِقُ فِي الْخَامِسَةِ."
 },
 {
  "i": 208,
  "start": 592.28,
  "end": 596.7,
  "text": "إِلَى الْمَدْرَسَةِ؟ لَكِنَّهَا أُغْلِقَتْ مُنْذُ سَنَوَاتٍ طَوِيلَةٍ."
 },
 {
  "i": 209,
  "start": 596.7,
  "end": 598.44,
  "text": "ثَلَاثُمِئَةِ مَكَانٍ."
 },
 {
  "i": 210,
  "start": 598.44,
  "end": 601.63,
  "text": "أَرْبَعُونَ عَامًا مِنَ الْحِكَايَاتِ."
 },
 {
  "i": 211,
  "start": 601.63,
  "end": 603.32,
  "text": "وَكُلُّ ذِكْرَى تَفْتَحُهَا..."
 },
 {
  "i": 212,
  "start": 603.83,
  "end": 605.02,
  "text": "تَعُودُ كَامِلَةً."
 },
 {
  "i": 213,
  "start": 605.8,
  "end": 606.82,
  "text": "بِرَائِحَتِهَا."
 },
 {
  "i": 214,
  "start": 606.82,
  "end": 609.12,
  "text": "بِصَوْتِهَا."
 },
 {
  "i": 215,
  "start": 609.12,
  "end": 610.0,
  "text": "بِضَحْكَتِهَا."
 },
 {
  "i": 216,
  "start": 610.41,
  "end": 612.17,
  "text": "تَمُرُّ دَقِيقَةٌ."
 },
 {
  "i": 217,
  "start": 612.17,
  "end": 613.38,
  "text": "ثُمَّ خَمْسٌ."
 },
 {
  "i": 218,
  "start": 614.02,
  "end": 614.82,
  "text": "ثُمَّ عَشْرٌ."
 },
 {
  "i": 219,
  "start": 615.62,
  "end": 617.94,
  "text": "وَأَنْتَ مَا زِلْتَ وَاقِفًا فِي غُرْفَتِكَ."
 },
 {
  "i": 220,
  "start": 618.58,
  "end": 622.16,
  "text": "تَسْأَلُكَ أُمُّكَ عَلَى الْهَاتِفِ أَيْنَ يُمْكِنُ أَنْ تَكُونَ جَدَّتُكَ الْآنَ."
 },
 {
  "i": 221,
  "start": 622.9,
  "end": 626.28,
  "text": "وَأَنْتَ صَاحِبُ الذَّاكِرَةِ الَّتِي لَا تُخْطِئُ أَبَدًا..."
 },
 {
  "i": 222,
  "start": 626.28,
  "end": 628.9,
  "text": "لَا تَمْلِكُ جَوَابًا وَاحِدًا."
 },
 {
  "i": 223,
  "start": 628.9,
  "end": 630.9,
  "text": "ثَلَاثُونَ دَقِيقَةً عَلَى الْغُرُوبِ."
 },
 {
  "i": 224,
  "start": 631.46,
  "end": 632.78,
  "text": "الْقَاعِدَةُ لَا تَرْحَمُ."
 },
 {
  "i": 225,
  "start": 633.58,
  "end": 636.1,
  "text": "عَقْلُكَ يَحْفَظُ كُلَّ شَيْءٍ..."
 },
 {
  "i": 226,
  "start": 636.1,
  "end": 638.3,
  "text": "وَلِهَذَا لَا يَجِدُ شَيْئًا."
 },
 {
  "i": 227,
  "start": 638.3,
  "end": 639.86,
  "text": "التَّفَاصِيلُ تُغْرِقُكَ."
 },
 {
  "i": 228,
  "start": 640.42,
  "end": 641.42,
  "text": "وَهُنَا تَفْهَمُ."
 },
 {
  "i": 229,
  "start": 642.18,
  "end": 643.82,
  "text": "أَمَامَكَ طَرِيقَانِ فَقَطْ."
 },
 {
  "i": 230,
  "start": 644.34,
  "end": 647.16,
  "text": "إِمَّا أَنْ تَغُوصَ أَعْمَقَ فِي أَرْشِيفٍ لَا قَاعَ لَهُ..."
 },
 {
  "i": 231,
  "start": 648.42,
  "end": 651.5,
  "text": "وَإِمَّا أَنْ تَفْتَحَ عَيْنَيْكَ وَتَطْلُبَ الْمُسَاعَدَةَ."
 },
 {
  "i": 232,
  "start": 651.5,
  "end": 652.96,
  "text": "تَفْتَحُ عَيْنَيْكَ."
 },
 {
  "i": 233,
  "start": 653.52,
  "end": 654.66,
  "text": "تُمْسِكُ الْهَاتِفَ."
 },
 {
  "i": 234,
  "start": 655.38,
  "end": 656.6,
  "text": "وَتَتَّصِلُ بِآدَمَ."
 },
 {
  "i": 235,
  "start": 657.38,
  "end": 658.46,
  "text": "آدَمُ نَفْسُهُ."
 },
 {
  "i": 236,
  "start": 659.06,
  "end": 662.44,
  "text": "صَاحِبُ الْكَلِمَةِ الَّتِي لَمْ تَسْتَطِعْ أَنْ تَنْسَاهَا."
 },
 {
  "i": 237,
  "start": 662.44,
  "end": 664.56,
  "text": "يَرُدُّ مِنَ الرَّنَّةِ الْأُولَى."
 },
 {
  "i": 238,
  "start": 664.56,
  "end": 666.32,
  "text": "أَنَا قَادِمٌ."
 },
 {
  "i": 239,
  "start": 666.32,
  "end": 668.88,
  "text": "وَسَلْمَى تَطْبَعُ صُورَةً حَدِيثَةً لِجَدَّتِكَ..."
 },
 {
  "i": 240,
  "start": 669.64,
  "end": 671.48,
  "text": "وَتَنْشُرُهَا فِي مَجْمُوعَةِ الْحَيِّ."
 },
 {
  "i": 241,
  "start": 672.14,
  "end": 674.32,
  "text": "يَصِلُ آدَمُ بَعْدَ سَبْعِ دَقَائِقَ."
 },
 {
  "i": 242,
  "start": 675.04,
  "end": 677.46,
  "text": "يَسْأَلُكَ سُؤَالًا وَاحِدًا."
 },
 {
  "i": 243,
  "start": 677.46,
  "end": 681.66,
  "text": "مَا الشَّيْءُ الَّذِي لَا تَنْسَاهُ جَدَّتُكَ أَبَدًا؟ لَيْسَ الشَّوَارِعَ."
 },
 {
  "i": 244,
  "start": 682.32,
  "end": 683.46,
  "text": "وَلَيْسَ الْأَسْمَاءَ."
 },
 {
  "i": 245,
  "start": 684.28,
  "end": 685.06,
  "text": "تَتَوَقَّفُ."
 },
 {
  "i": 246,
  "start": 685.62,
  "end": 687.46,
  "text": "ثُمَّ تَسْمَعُهُ فِي رَأْسِكَ."
 },
 {
  "i": 247,
  "start": 688.24,
  "end": 689.2,
  "text": "اللَّحْنُ."
 },
 {
  "i": 248,
  "start": 689.2,
  "end": 691.58,
  "text": "الْأُغْنِيَةُ الَّتِي نَسِيَتِ اسْمَهَا..."
 },
 {
  "i": 249,
  "start": 692.22,
  "end": 693.66,
  "text": "وَلَمْ تَنْسَ لَحْنَهَا."
 },
 {
  "i": 250,
  "start": 694.38,
  "end": 697.0,
  "text": "وَالْمَكَانُ الَّذِي تَعُودُ إِلَيْهِ فِي كُلِّ حِكَايَةٍ."
 },
 {
  "i": 251,
  "start": 697.0,
  "end": 699.6,
  "text": "الْمَقْهَى قُرْبَ الْبَحْرِ."
 },
 {
  "i": 252,
  "start": 699.6,
  "end": 701.32,
  "text": "تُوقِفَانِ سَيَّارَةَ أُجْرَةٍ."
 },
 {
  "i": 253,
  "start": 701.96,
  "end": 703.2,
  "text": "الرِّيحُ بَارِدَةٌ."
 },
 {
  "i": 254,
  "start": 703.71,
  "end": 705.08,
  "text": "الشَّمْسُ تَلْمِسُ الْمَاءَ."
 },
 {
  "i": 255,
  "start": 705.8,
  "end": 706.74,
  "text": "وَهُنَاكَ..."
 },
 {
  "i": 256,
  "start": 707.13,
  "end": 709.74,
  "text": "عَلَى كُرْسِيٍّ خَشَبِيٍّ قُرْبَ النَّافِذَةِ..."
 },
 {
  "i": 257,
  "start": 709.74,
  "end": 711.38,
  "text": "تَجْلِسُ جَدَّتُكَ."
 },
 {
  "i": 258,
  "start": 711.38,
  "end": 713.59,
  "text": "وَتُدَنْدِنُ."
 },
 {
  "i": 259,
  "start": 713.59,
  "end": 716.08,
  "text": "يَقُولُ النَّادِلُ إِنَّهَا هُنَا مُنْذُ سَاعَةٍ."
 },
 {
  "i": 260,
  "start": 716.57,
  "end": 718.12,
  "text": "طَلَبَتْ كُوبَيْنِ مِنَ الشَّايِ."
 },
 {
  "i": 261,
  "start": 718.84,
  "end": 719.84,
  "text": "وَاحِدًا لَهَا..."
 },
 {
  "i": 262,
  "start": 720.56,
  "end": 722.98,
  "text": "وَوَاحِدًا لِلْكُرْسِيِّ الْفَارِغِ أَمَامَهَا."
 },
 {
  "i": 263,
  "start": 723.55,
  "end": 726.32,
  "text": "وَفِي كُلِّ كُوبٍ وَرَقَةُ نَعْنَاعٍ وَاحِدَةٌ."
 },
 {
  "i": 264,
  "start": 726.77,
  "end": 727.82,
  "text": "تَقْتَرِبُ مِنْهَا."
 },
 {
  "i": 265,
  "start": 728.49,
  "end": 730.38,
  "text": "تَنْظُرُ إِلَيْكَ لَحْظَةً..."
 },
 {
  "i": 266,
  "start": 730.38,
  "end": 732.38,
  "text": "كَأَنَّهَا تَبْحَثُ عَنِ اسْمِكَ."
 },
 {
  "i": 267,
  "start": 732.81,
  "end": 733.94,
  "text": "ثُمَّ تَبْتَسِمُ."
 },
 {
  "i": 268,
  "start": 734.63,
  "end": 736.08,
  "text": "جِئْتَ يَا حَبِيبِي."
 },
 {
  "i": 269,
  "start": 736.65,
  "end": 738.24,
  "text": "جَدُّكَ كَانَ يَجْلِسُ هُنَا."
 },
 {
  "i": 270,
  "start": 739.0,
  "end": 740.94,
  "text": "تَسْأَلُهَا عَنِ اسْمِهِ."
 },
 {
  "i": 271,
  "start": 740.94,
  "end": 742.2,
  "text": "فَتَهُزُّ رَأْسَهَا."
 },
 {
  "i": 272,
  "start": 742.69,
  "end": 743.86,
  "text": "لَا تَتَذَكَّرُ."
 },
 {
  "i": 273,
  "start": 744.64,
  "end": 746.62,
  "text": "لَكِنَّهَا تُدَنْدِنُ اللَّحْنَ نَفْسَهُ."
 },
 {
  "i": 274,
  "start": 747.09,
  "end": 748.54,
  "text": "بِلَا خَطَأٍ وَاحِدٍ."
 },
 {
  "i": 275,
  "start": 749.23,
  "end": 751.66,
  "text": "وَفِي طَرِيقِ الْعَوْدَةِ تَنْظُرُ إِلَى آدَمَ."
 },
 {
  "i": 276,
  "start": 752.48,
  "end": 754.42,
  "text": "الْكَلِمَةُ مَا زَالَتْ هُنَاكَ."
 },
 {
  "i": 277,
  "start": 754.42,
  "end": 755.74,
  "text": "لَنْ تَخْتَفِيَ."
 },
 {
  "i": 278,
  "start": 756.46,
  "end": 759.74,
  "text": "لَكِنَّكَ تَخْتَارُ أَلَّا تَحْمِلَهَا بَعْدَ الْيَوْمِ."
 },
 {
  "i": 279,
  "start": 759.74,
  "end": 760.54,
  "text": "تَقُولُ لَهُ..."
 },
 {
  "i": 280,
  "start": 761.64,
  "end": 762.64,
  "text": "شُكْرًا."
 },
 {
  "i": 281,
  "start": 762.64,
  "end": 764.12,
  "text": "لِنَبْدَأْ مِنْ جَدِيدٍ."
 },
 {
  "i": 282,
  "start": 764.12,
  "end": 765.26,
  "text": "يَبْتَسِمُ."
 },
 {
  "i": 283,
  "start": 765.94,
  "end": 772.147,
  "text": "وَفِي الْبَيْتِ تُعَلِّقُ أُمُّكَ فِي حَقِيبَةِ جَدَّتِكَ بِطَاقَةً صَغِيرَةً فِيهَا اسْمُهَا وَرَقْمُ هَاتِفِكَ."
 },
 {
  "i": 284,
  "start": 772.147,
  "end": 775.92,
  "text": "وَسَلْمَى تُعَانِقُهَا طَوِيلًا وَلَا تَقُولُ شَيْئًا."
 },
 {
  "i": 285,
  "start": 775.92,
  "end": 777.46,
  "text": "وَتِلْكَ اللَّيْلَةَ..."
 },
 {
  "i": 286,
  "start": 777.46,
  "end": 780.1,
  "text": "يُعِيدُ عَقْلُكَ الْيَوْمَ كَامِلًا كَالْعَادَةِ."
 },
 {
  "i": 287,
  "start": 780.1,
  "end": 783.36,
  "text": "لَكِنَّكَ تَتَوَقَّفُ عِنْدَ لَحْظَةٍ وَاحِدَةٍ فَقَطْ."
 },
 {
  "i": 288,
  "start": 784.12,
  "end": 785.8,
  "text": "جَدَّتُكَ عِنْدَ النَّافِذَةِ."
 },
 {
  "i": 289,
  "start": 785.8,
  "end": 787.72,
  "text": "تُدَنْدِنُ."
 },
 {
  "i": 290,
  "start": 787.72,
  "end": 789.56,
  "text": "وَتَفْهَمُ أَخِيرًا."
 },
 {
  "i": 291,
  "start": 789.56,
  "end": 792.2,
  "text": "عَقْلُكَ يَحْفَظُ كُلَّ شَيْءٍ..."
 },
 {
  "i": 292,
  "start": 792.2,
  "end": 795.07,
  "text": "لَكِنَّ قَلْبَكَ هُوَ الَّذِي يَخْتَارُ مَا يَبْقَى."
 },
 {
  "i": 293,
  "start": 795.07,
  "end": 801.5,
  "text": "فَمَا الْحَقِيقِيُّ فِي هَذِهِ الْقِصَّةِ؟ الذَّاكِرَةُ الذَّاتِيَّةُ فَائِقَةُ الْقُوَّةِ حَالَةٌ حَقِيقِيَّةٌ."
 },
 {
  "i": 294,
  "start": 801.5,
  "end": 804.04,
  "text": "وَأَصْحَابُهَا يَتَذَكَّرُونَ أَحْدَاثَ"
 },
 {
  "i": 295,
  "start": 804.84,
  "end": 808.24,
  "text": "حَيَاتِهِمْ وَتَوَارِيخَهَا بِدِقَّةٍ مُدْهِشَةٍ."
 },
 {
  "i": 296,
  "start": 808.24,
  "end": 810.48,
  "text": "لَكِنَّهُمْ لَا يَتَذَكَّرُونَ كُلَّ ثَانِيَةٍ."
 },
 {
  "i": 297,
  "start": 811.04,
  "end": 814.38,
  "text": "وَلَا يَتَفَوَّقُونَ عَادَةً فِي حِفْظِ الْقَوَائِمِ وَالْأَرْقَامِ."
 },
 {
  "i": 298,
  "start": 815.04,
  "end": 820.92,
  "text": "بَلْ إِنَّ دِرَاسَةً عَامَ 2013 أَظْهَرَتْ أَنَّهُمْ قَدْ يَحْمِلُونَ ذِكْرَيَاتٍ زَائِفَةً..."
 },
 {
  "i": 299,
  "start": 820.92,
  "end": 822.68,
  "text": "مِثْلَنَا تَمَامًا."
 },
 {
  "i": 300,
  "start": 822.68,
  "end": 826.74,
  "text": "وَجِيل بْرَايْس نَفْسُهَا وَصَفَتْ ذَاكِرَتَهَا بِأَنَّهَا تَعْمَلُ بِلَا تَوَقُّفٍ..."
 },
 {
  "i": 301,
  "start": 827.48,
  "end": 829.62,
  "text": "وَأَنَّهَا مُرْهِقَةٌ أَكْثَرَ مِنْهَا مَوْهِبَةً."
 },
 {
  "i": 302,
  "start": 830.28,
  "end": 835.7,
  "text": "أَمَّا أَنْ تَحْفَظَ كُلَّ لَحْظَةٍ مِنْ مِلْيَارَيْنِ وَنِصْفِ مِلْيَارِ ثَانِيَةٍ؟ فَهَذَا خَيَالٌ."
 },
 {
  "i": 303,
  "start": 836.42,
  "end": 841.44,
  "text": "وَهَلْ كُنْتَ سَتَرْغَبُ فِيهِ أَصْلًا؟ وَيَبْقَى سُؤَالٌ مَفْتُوحٌ."
 },
 {
  "i": 304,
  "start": 841.44,
  "end": 849.82,
  "text": "هَلِ النِّسْيَانُ عَمَلِيَّةٌ يَقُومُ بِهَا الدِّمَاغُ عَنْ قَصْدٍ؟ بَعْضُ الْعُلَمَاءِ يَرَوْنَ أَنَّ النَّوْمَ يُضْعِفُ الرَّوَابِطَ الْعَصَبِيَّةَ الْأَقَلَّ أَهَمِّيَّةً..."
 },
 {
  "i": 305,
  "start": 850.38,
  "end": 852.14,
  "text": "لِيُفْسِحَ الْمَجَالَ لِمَا هُوَ مُهِمٌّ."
 },
 {
  "i": 306,
  "start": 852.14,
  "end": 855.7,
  "text": "وَآخَرُونَ يَرَوْنَ أَنَّ الصُّورَةَ أَعْقَدُ مِنْ ذَلِكَ."
 },
 {
  "i": 307,
  "start": 856.46,
  "end": 858.54,
  "text": "وَالنِّقَاشُ مُسْتَمِرٌّ."
 },
 {
  "i": 308,
  "start": 858.54,
  "end": 861.12,
  "text": "وَنَصِيحَةٌ حَقِيقِيَّةٌ أَخِيرَةٌ."
 },
 {
  "i": 309,
  "start": 861.12,
  "end": 865.08,
  "text": "إِنْ كَانَ فِي عَائِلَتِكَ شَخْصٌ كَبِيرٌ يُعَانِي مِنْ مَشَاكِلَ فِي الذَّاكِرَةِ..."
 },
 {
  "i": 310,
  "start": 865.08,
  "end": 870.32,
  "text": "فَاحْرِصْ عَلَى أَنْ يَحْمِلَ دَائِمًا بِطَاقَةً فِيهَا اسْمُهُ وَرَقْمُ هَاتِفٍ لِلتَّوَاصُلِ."
 },
 {
  "i": 311,
  "start": 870.32,
  "end": 873.64,
  "text": "وَاحْتَفِظْ بِصُورَةٍ حَدِيثَةٍ لَهُ."
 },
 {
  "i": 312,
  "start": 873.64,
  "end": 874.36,
  "text": "وَالْآنَ..."
 },
 {
  "i": 313,
  "start": 875.16,
  "end": 876.75,
  "text": "تَخَيَّلِ الْعَكْسَ."
 },
 {
  "i": 314,
  "start": 876.75,
  "end": 879.98,
  "text": "تَسْتَيْقِظُ كُلَّ صَبَاحٍ وَالْأَمْسُ صَفْحَةٌ بَيْضَاءُ."
 },
 {
  "i": 315,
  "start": 880.8,
  "end": 883.46,
  "text": "مَاذَا لَوْ كَانَ كُلُّ يَوْمٍ يُمْحَى مِنْ ذَاكِرَتِكَ..."
 },
 {
  "i": 316,
  "start": 884.12,
  "end": 888.94,
  "text": "لَحْظَةَ تَنَامُ؟ مَا رَأْيُكَ؟ أَخْبِرْنَا فِي التَّعْلِيقَاتِ..."
 },
 {
  "i": 317,
  "start": 889.64,
  "end": 893.9,
  "text": "وَأَخْبِرْنَا أَيَّ قُدْرَةٍ بَشَرِيَّةٍ نَدْفَعُهَا إِلَى أَقْصَاهَا فِي الْحَلْقَةِ الْقَادِمَةِ."
 },
 {
  "i": 318,
  "start": 894.54,
  "end": 895.98,
  "text": "اضْغَطْ زِرَّ الْإِعْجَابِ..."
 },
 {
  "i": 319,
  "start": 896.66,
  "end": 898.02,
  "text": "وَاشْتَرِكْ لِلْمَزِيدِ."
 }
]