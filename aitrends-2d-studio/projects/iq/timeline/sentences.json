[
 {
  "i": 0,
  "start": 0.0,
  "end": 1.12,
  "text": "الْفُطُورُ لَمْ يَبْدَأْ بَعْدُ."
 },
 {
  "i": 1,
  "start": 1.54,
  "end": 4.1,
  "text": "وَأَنْتَ حَلَلْتَ مُكَعَّبَ رُوبِيكَ فِي ثَلَاثِ ثَوَانٍ."
 },
 {
  "i": 2,
  "start": 4.6,
  "end": 5.7,
  "text": "بِيَدٍ وَاحِدَةٍ."
 },
 {
  "i": 3,
  "start": 5.7,
  "end": 7.94,
  "text": "أُمُّكَ تَسْأَلُكَ عَنْ وَاجِبِ الرِّيَاضِيَّاتِ."
 },
 {
  "i": 4,
  "start": 7.94,
  "end": 9.96,
  "text": "تُجِيبُ قَبْلَ أَنْ تُكْمِلَ السُّؤَالَ."
 },
 {
  "i": 5,
  "start": 10.22,
  "end": 11.62,
  "text": "انْتَهَيْتُ مِنْهُ أَمْسِ..."
 },
 {
  "i": 6,
  "start": 11.88,
  "end": 13.96,
  "text": "وَمِنْ كِتَابِ السَّنَةِ الْقَادِمَةِ أَيْضًا."
 },
 {
  "i": 7,
  "start": 14.5,
  "end": 16.74,
  "text": "الْمُذِيعُ فِي التِّلْفَازِ يُخْطِئُ فِي رَقْمٍ."
 },
 {
  "i": 8,
  "start": 16.76,
  "end": 18.46,
  "text": "تُصَحِّحُهُ لَهُ بِصَوْتٍ عَالٍ."
 },
 {
  "i": 9,
  "start": 18.86,
  "end": 19.9,
  "text": "هُوَ لَا يَسْمَعُكَ."
 },
 {
  "i": 10,
  "start": 19.9,
  "end": 21.88,
  "text": "لَكِنَّ أَبَاكَ يَسْمَعُكَ..."
 },
 {
  "i": 11,
  "start": 21.88,
  "end": 22.66,
  "text": "وَيَتَنَهَّدُ."
 },
 {
  "i": 12,
  "start": 23.18,
  "end": 24.32,
  "text": "تَنْظُرُ مِنَ النَّافِذَةِ."
 },
 {
  "i": 13,
  "start": 24.68,
  "end": 27.32,
  "text": "تَحْسُبُ سُرْعَةَ كُلِّ سَيَّارَةٍ تَمُرُّ فِي الشَّارِعِ..."
 },
 {
  "i": 14,
  "start": 27.32,
  "end": 31.08,
  "text": "وَتَعْرِفُ مَتَى تَتَحَوَّلُ الْإِشَارَةُ إِلَى الْأَخْضَرِ قَبْلَ أَنْ تَتَحَوَّلَ."
 },
 {
  "i": 15,
  "start": 31.38,
  "end": 33.4,
  "text": "ثُمَّ تَدْخُلُ أُخْتُكَ الصَّغِيرَةُ نُورُ."
 },
 {
  "i": 16,
  "start": 33.4,
  "end": 34.82,
  "text": "وَجْهُهَا غَاضِبٌ."
 },
 {
  "i": 17,
  "start": 35.1,
  "end": 36.64,
  "text": "وَتُغْلِقُ الْبَابَ بِقُوَّةٍ."
 },
 {
  "i": 18,
  "start": 37.06,
  "end": 39.78,
  "text": "وَأَنْتَ؟ أَذْكَى إِنْسَانٍ فِي الْمَدِينَةِ..."
 },
 {
  "i": 19,
  "start": 39.78,
  "end": 41.38,
  "text": "وَلَا تَعْرِفُ لِمَاذَا."
 },
 {
  "i": 20,
  "start": 41.38,
  "end": 45.02,
  "text": "مُعْظَمُ النَّاسِ تَقَعُ دَرَجَاتُهُمْ فِي اخْتِبَارَاتِ الذَّكَاءِ قَرِيبًا مِنْ مِئَةٍ."
 },
 {
  "i": 21,
  "start": 45.34,
  "end": 46.62,
  "text": "هَذَا هُوَ الْمُتَوَسِّطُ."
 },
 {
  "i": 22,
  "start": 46.98,
  "end": 50.62,
  "text": "وَنَحْوُ اثْنَيْنِ فَقَطْ مِنْ كُلِّ مِئَةِ شَخْصٍ يَتَجَاوَزُونَ مِئَةً وَثَلَاثِينَ."
 },
 {
  "i": 23,
  "start": 51.1,
  "end": 54.44,
  "text": "وَأَنْتَ؟ عَقْلُكَ أَسْرَعُ مِنْ عُقُولِهِمْ بِعَشَرَةِ أَضْعَافٍ."
 },
 {
  "i": 24,
  "start": 54.58,
  "end": 56.48,
  "text": "تَقْرَأُ الْكِتَابَ فِي سَاعَةٍ."
 },
 {
  "i": 25,
  "start": 56.48,
  "end": 58.22,
  "text": "وَتَفْهَمُهُ أَفْضَلَ مِنْ كَاتِبِهِ."
 },
 {
  "i": 26,
  "start": 58.6,
  "end": 61.24,
  "text": "لَكِنَّ لِهَذِهِ الْقُوَّةِ قَاعِدَةً وَاحِدَةً."
 },
 {
  "i": 27,
  "start": 61.24,
  "end": 62.84,
  "text": "الذَّكَاءُ يُسَرِّعُ التَّفْكِيرَ..."
 },
 {
  "i": 28,
  "start": 63.22,
  "end": 64.74,
  "text": "وَلَا يُسَرِّعُ الْمَشَاعِرَ."
 },
 {
  "i": 29,
  "start": 65.1,
  "end": 66.72,
  "text": "الْحُزْنُ يَحْتَاجُ وَقْتَهُ."
 },
 {
  "i": 30,
  "start": 66.72,
  "end": 68.5,
  "text": "وَالْفَرَحُ يَحْتَاجُ وَقْتَهُ."
 },
 {
  "i": 31,
  "start": 68.5,
  "end": 70.14,
  "text": "وَلَا مُعَادَلَةَ تَخْتَصِرُ ذَلِكَ."
 },
 {
  "i": 32,
  "start": 70.56,
  "end": 71.4,
  "text": "اسْمُكَ سَلِيمٌ."
 },
 {
  "i": 33,
  "start": 71.88,
  "end": 73.34,
  "text": "عُمْرُكَ أَرْبَعَةَ عَشَرَ عَامًا."
 },
 {
  "i": 34,
  "start": 73.78,
  "end": 76.28,
  "text": "وَسَتَتَعَلَّمُ يَوْمًا أَنَّ أَذْكَى إِجَابَةٍ..."
 },
 {
  "i": 35,
  "start": 76.28,
  "end": 77.78,
  "text": "أَحْيَانًا أَنْ تَصْمُتَ."
 },
 {
  "i": 36,
  "start": 77.78,
  "end": 81.7,
  "text": "فَمَاذَا لَوْ كَانَ ذَكَاؤُكَ أَعْلَى بِعَشَرَةِ أَضْعَافٍ؟ تَبْدَأُ بِالْمَدْرَسَةِ."
 },
 {
  "i": 37,
  "start": 81.7,
  "end": 84.28,
  "text": "امْتِحَانُ الْفِيزِيَاءِ مُدَّتُهُ سَاعَتَانِ."
 },
 {
  "i": 38,
  "start": 84.64,
  "end": 86.72,
  "text": "تُسَلِّمُ الْوَرَقَةَ بَعْدَ سَبْعِ دَقَائِقَ."
 },
 {
  "i": 39,
  "start": 87.02,
  "end": 90.02,
  "text": "وَفِي آخِرِهَا سُؤَالٌ إِضَافِيٌّ كَتَبْتَهُ أَنْتَ لِلْمُعَلِّمِ."
 },
 {
  "i": 40,
  "start": 90.48,
  "end": 92.0,
  "text": "هُوَ لَمْ يَحُلَّهُ حَتَّى الْآنَ."
 },
 {
  "i": 41,
  "start": 92.54,
  "end": 94.52,
  "text": "فِي الشَّهْرِ الثَّالِثِ تَنْتَقِلُ إِلَى الْجَامِعَةِ."
 },
 {
  "i": 42,
  "start": 94.98,
  "end": 96.5,
  "text": "أَصْغَرُ طَالِبٍ فِي تَارِيخِهَا."
 },
 {
  "i": 43,
  "start": 96.9,
  "end": 99.34,
  "text": "الطُّلَّابُ يَظُنُّونَكَ ابْنَ أَحَدِ الْأَسَاتِذَةِ."
 },
 {
  "i": 44,
  "start": 99.84,
  "end": 101.88,
  "text": "يَأْخُذُكَ أَبُوكَ إِلَى مَرْكَزٍ لِلْأَبْحَاثِ."
 },
 {
  "i": 45,
  "start": 102.44,
  "end": 103.78,
  "text": "يُعْطُونَكَ اخْتِبَارَ ذَكَاءٍ."
 },
 {
  "i": 46,
  "start": 104.08,
  "end": 105.62,
  "text": "تُنْهِيهِ فِي رُبْعِ الْوَقْتِ."
 },
 {
  "i": 47,
  "start": 105.72,
  "end": 106.94,
  "text": "فَيُعِيدُونَهُ مَرَّتَيْنِ..."
 },
 {
  "i": 48,
  "start": 107.38,
  "end": 109.6,
  "text": "لِأَنَّهُمْ يَظُنُّونَ أَنَّ الْجِهَازَ مُعَطَّلٌ."
 },
 {
  "i": 49,
  "start": 110.06,
  "end": 111.42,
  "text": "الرَّقْمُ خَارِجُ الْمِقْيَاسِ."
 },
 {
  "i": 50,
  "start": 111.82,
  "end": 114.1,
  "text": "ثُمَّ تَدْعُوكَ بُطُولَةُ الشِّطْرَنْجِ الْوَطَنِيَّةُ."
 },
 {
  "i": 51,
  "start": 114.56,
  "end": 117.36,
  "text": "تَلْعَبُ عِشْرِينَ مُبَارَاةً فِي وَقْتٍ وَاحِدٍ."
 },
 {
  "i": 52,
  "start": 117.36,
  "end": 119.4,
  "text": "وَعَيْنَاكَ مُغْمَضَتَانِ."
 },
 {
  "i": 53,
  "start": 119.4,
  "end": 120.98,
  "text": "تَفُوزُ بِهَا كُلِّهَا."
 },
 {
  "i": 54,
  "start": 121.32,
  "end": 123.72,
  "text": "تَتَعَلَّمُ لُغَةً جَدِيدَةً كُلَّ شَهْرٍ."
 },
 {
  "i": 55,
  "start": 123.72,
  "end": 125.9,
  "text": "فِي الشَّهْرِ السَّادِسِ تَتَكَلَّمُ سِتَّ لُغَاتٍ..."
 },
 {
  "i": 56,
  "start": 126.38,
  "end": 128.4,
  "text": "وَلَا تَجِدُ مَنْ تُكَلِّمُهُ بِأَيٍّ مِنْهَا."
 },
 {
  "i": 57,
  "start": 128.7,
  "end": 131.56,
  "text": "ثُمَّ تَقْرَأُ عَنْ قُرًى بَعِيدَةٍ لَا تَجِدُ مَاءً نَظِيفًا."
 },
 {
  "i": 58,
  "start": 131.84,
  "end": 133.6,
  "text": "فِي عُطْلَةِ نِهَايَةِ الْأُسْبُوعِ..."
 },
 {
  "i": 59,
  "start": 134.06,
  "end": 136.52,
  "text": "تُصَمِّمُ مُرَشِّحَ مَاءٍ رَخِيصًا مِنَ الرَّمْلِ وَالْفَحْمِ."
 },
 {
  "i": 60,
  "start": 136.78,
  "end": 139.14,
  "text": "تَكْلُفَتُهُ أَقَلُّ مِنْ ثَمَنِ وَجْبَةٍ."
 },
 {
  "i": 61,
  "start": 139.14,
  "end": 140.84,
  "text": "وَتَنْشُرُ تَصْمِيمَهُ مَجَّانًا."
 },
 {
  "i": 62,
  "start": 141.08,
  "end": 143.84,
  "text": "بَعْدَ شَهْرٍ تَسْتَعْمِلُهُ عَشَرَاتُ الْقُرَى."
 },
 {
  "i": 63,
  "start": 143.84,
  "end": 144.86,
  "text": "الصُّحُفُ تَكْتُبُ عَنْكَ."
 },
 {
  "i": 64,
  "start": 144.86,
  "end": 147.2,
  "text": "الْقَنَوَاتُ تَتَّصِلُ بِأَبِيكَ."
 },
 {
  "i": 65,
  "start": 147.2,
  "end": 149.62,
  "text": "وَالْعُلَمَاءُ يُرْسِلُونَ لَكَ أَسْئِلَتَهُمُ الصَّعْبَةَ."
 },
 {
  "i": 66,
  "start": 150.1,
  "end": 151.28,
  "text": "وَأَنْتَ تُجِيبُ عَنْهَا..."
 },
 {
  "i": 67,
  "start": 151.28,
  "end": 153.34,
  "text": "قَبْلَ أَنْ يَبْرُدَ الشَّايُ."
 },
 {
  "i": 68,
  "start": 153.34,
  "end": 155.04,
  "text": "لَكِنَّ شَيْئًا آخَرَ يَحْدُثُ."
 },
 {
  "i": 69,
  "start": 155.3,
  "end": 157.12,
  "text": "شَيْئًا لَا تَكْتُبُ عَنْهُ الصُّحُفُ."
 },
 {
  "i": 70,
  "start": 157.6,
  "end": 159.78,
  "text": "الْكَلَامُ مَعَ النَّاسِ صَارَ انْتِظَارًا طَوِيلًا."
 },
 {
  "i": 71,
  "start": 159.78,
  "end": 162.22,
  "text": "صَدِيقُكَ هَادِي يَحْكِي لَكَ قِصَّةً."
 },
 {
  "i": 72,
  "start": 162.56,
  "end": 165.24,
  "text": "وَأَنْتَ تَعْرِفُ نِهَايَتَهَا مِنَ الْجُمْلَةِ الْأُولَى."
 },
 {
  "i": 73,
  "start": 165.24,
  "end": 166.66,
  "text": "فَتَقُولُهَا لَهُ."
 },
 {
  "i": 74,
  "start": 166.66,
  "end": 167.42,
  "text": "يَضْحَكُ مَرَّةً."
 },
 {
  "i": 75,
  "start": 168.0,
  "end": 169.36,
  "text": "ثُمَّ يَتَوَقَّفُ عَنِ الضَّحِكِ."
 },
 {
  "i": 76,
  "start": 169.78,
  "end": 171.3,
  "text": "ثُمَّ يَتَوَقَّفُ عَنِ الْحِكَايَةِ."
 },
 {
  "i": 77,
  "start": 171.78,
  "end": 173.62,
  "text": "وَحِينَ يَحْكِي النَّاسُ نُكْتَةً..."
 },
 {
  "i": 78,
  "start": 173.62,
  "end": 174.62,
  "text": "أَنْتَ لَا تَضْحَكُ."
 },
 {
  "i": 79,
  "start": 175.02,
  "end": 175.88,
  "text": "أَنْتَ تُحَلِّلُهَا."
 },
 {
  "i": 80,
  "start": 176.28,
  "end": 178.46,
  "text": "فِي الْفَصْلِ لَمْ يَعُدْ أَحَدٌ يَجْلِسُ بِجَانِبِكَ."
 },
 {
  "i": 81,
  "start": 178.82,
  "end": 180.28,
  "text": "لَيْسَ لِأَنَّهُمْ يَكْرَهُونَكَ..."
 },
 {
  "i": 82,
  "start": 180.64,
  "end": 182.68,
  "text": "بَلْ لِأَنَّكَ تُشْعِرُهُمْ أَنَّهُمْ بَطِيئُونَ."
 },
 {
  "i": 83,
  "start": 183.14,
  "end": 185.72,
  "text": "وَفِي حَفْلَةِ عِيدِ مِيلَادِ هَادِي تَقِفُ فِي الزَّاوِيَةِ."
 },
 {
  "i": 84,
  "start": 186.02,
  "end": 189.28,
  "text": "تَحْسُبُ عَدَدَ الْبَالُونَاتِ وَسُرْعَةَ ذَوَبَانِ الْكَعْكَةِ..."
 },
 {
  "i": 85,
  "start": 189.28,
  "end": 190.5,
  "text": "وَالْجَمِيعُ يَرْقُصُونَ."
 },
 {
  "i": 86,
  "start": 190.88,
  "end": 192.24,
  "text": "وَهُنَاكَ ثَمَنٌ آخَرُ."
 },
 {
  "i": 87,
  "start": 192.8,
  "end": 196.08,
  "text": "دِمَاغُ الْإِنْسَانِ يُشَكِّلُ نَحْوَ اثْنَيْنِ مِنْ كُلِّ مِئَةٍ مِنْ وَزْنِ الْجِسْمِ..."
 },
 {
  "i": 88,
  "start": 196.42,
  "end": 198.68,
  "text": "لَكِنَّهُ يَسْتَهْلِكُ نَحْوَ خُمْسِ طَاقَتِهِ."
 },
 {
  "i": 89,
  "start": 199.06,
  "end": 200.48,
  "text": "وَدِمَاغُكَ لَا يَتَوَقَّفُ."
 },
 {
  "i": 90,
  "start": 200.94,
  "end": 201.82,
  "text": "تَأْكُلُ كَثِيرًا."
 },
 {
  "i": 91,
  "start": 202.32,
  "end": 203.44,
  "text": "وَتَتْعَبُ سَرِيعًا."
 },
 {
  "i": 92,
  "start": 203.84,
  "end": 205.86,
  "text": "وَتَسْهَرُ وَأَفْكَارُكَ تَرْكُضُ أَمَامَكَ."
 },
 {
  "i": 93,
  "start": 206.32,
  "end": 208.46,
  "text": "وَحِينَ تَسْأَلُكَ أُمُّكَ كَيْفَ كَانَ يَوْمُكَ..."
 },
 {
  "i": 94,
  "start": 208.78,
  "end": 210.86,
  "text": "تُعْطِيهَا تَقْرِيرًا مِنْ ثَلَاثِ صَفَحَاتٍ."
 },
 {
  "i": 95,
  "start": 211.46,
  "end": 213.44,
  "text": "وَهِيَ كَانَتْ تُرِيدُ كَلِمَةً وَاحِدَةً."
 },
 {
  "i": 96,
  "start": 213.76,
  "end": 215.52,
  "text": "صِرْتَ تَعْرِفُ كُلَّ شَيْءٍ..."
 },
 {
  "i": 97,
  "start": 215.52,
  "end": 217.26,
  "text": "إِلَّا كَيْفَ تَكُونُ قَرِيبًا مِنْ أَحَدٍ."
 },
 {
  "i": 98,
  "start": 217.62,
  "end": 218.34,
  "text": "فِي الْبَيْتِ..."
 },
 {
  "i": 99,
  "start": 218.34,
  "end": 219.5,
  "text": "أُخْتُكَ نُورُ."
 },
 {
  "i": 100,
  "start": 219.5,
  "end": 220.78,
  "text": "سَبْعُ سَنَوَاتٍ."
 },
 {
  "i": 101,
  "start": 221.06,
  "end": 223.88,
  "text": "هِيَ الْوَحِيدَةُ الَّتِي لَا تُبْهِرُهَا عَبْقَرِيَّتُكَ."
 },
 {
  "i": 102,
  "start": 223.88,
  "end": 225.9,
  "text": "تُعَلِّمُكَ لُعْبَةً سَخِيفَةً..."
 },
 {
  "i": 103,
  "start": 225.9,
  "end": 229.06,
  "text": "وَتَفُوزُ عَلَيْكَ دَائِمًا لِأَنَّهَا تُغَيِّرُ الْقَوَاعِدَ كُلَّ مَرَّةٍ."
 },
 {
  "i": 104,
  "start": 229.48,
  "end": 232.56,
  "text": "أَذْكَى إِنْسَانٍ فِي الْمَدِينَةِ يَخْسَرُ أَمَامَ طِفْلَةٍ فِي السَّابِعَةِ."
 },
 {
  "i": 105,
  "start": 232.92,
  "end": 234.92,
  "text": "وَهِيَ تَضْحَكُ حَتَّى تَسْقُطَ عَلَى الْأَرْضِ."
 },
 {
  "i": 106,
  "start": 235.32,
  "end": 236.98,
  "text": "كُلَّ مَسَاءٍ تَرْسُمُ لَكَ رَسْمَةً."
 },
 {
  "i": 107,
  "start": 237.24,
  "end": 238.3,
  "text": "شَمْسٌ صَفْرَاءُ."
 },
 {
  "i": 108,
  "start": 238.66,
  "end": 239.54,
  "text": "وَوَلَدٌ طَوِيلٌ."
 },
 {
  "i": 109,
  "start": 239.94,
  "end": 242.02,
  "text": "وَبِنْتٌ صَغِيرَةٌ تُمْسِكُ يَدَهُ."
 },
 {
  "i": 110,
  "start": 242.02,
  "end": 244.28,
  "text": "وَكُلَّ مَسَاءٍ تَسْأَلُكَ السُّؤَالَ نَفْسَهُ."
 },
 {
  "i": 111,
  "start": 244.4,
  "end": 247.16,
  "text": "هَلْ أَنْتَ سَعِيدٌ؟ وَأَنْتَ تُجِيبُهَا بِدِقَّةٍ."
 },
 {
  "i": 112,
  "start": 247.68,
  "end": 249.66,
  "text": "السَّعَادَةُ حَالَةٌ نِسْبِيَّةٌ يَا نُورُ..."
 },
 {
  "i": 113,
  "start": 249.96,
  "end": 251.86,
  "text": "تَعْتَمِدُ عَلَى مُتَغَيِّرَاتٍ كَثِيرَةٍ."
 },
 {
  "i": 114,
  "start": 252.32,
  "end": 253.74,
  "text": "فَتَنْظُرُ إِلَيْكَ طَوِيلًا."
 },
 {
  "i": 115,
  "start": 254.22,
  "end": 256.44,
  "text": "ثُمَّ تَضَعُ الرَّسْمَةَ عَلَى مَكْتَبِكَ وَتَذْهَبُ."
 },
 {
  "i": 116,
  "start": 256.86,
  "end": 259.04,
  "text": "عِنْدَكَ الْآنَ مِئَةٌ وَعِشْرُونَ رَسْمَةً."
 },
 {
  "i": 117,
  "start": 259.04,
  "end": 261.16,
  "text": "تَحْفَظُ أَلْوَانَهَا وَتَوَارِيخَهَا كُلَّهَا."
 },
 {
  "i": 118,
  "start": 261.16,
  "end": 263.96,
  "text": "لَكِنَّكَ لَمْ تُجِبْهَا مَرَّةً وَاحِدَةً..."
 },
 {
  "i": 119,
  "start": 263.96,
  "end": 265.76,
  "text": "بِكَلِمَةٍ وَاحِدَةٍ."
 },
 {
  "i": 120,
  "start": 266.02,
  "end": 267.48,
  "text": "ثُمَّ يَأْتِي ذَلِكَ الصَّبَاحُ."
 },
 {
  "i": 121,
  "start": 267.92,
  "end": 269.14,
  "text": "سَمَكَةُ نُورَ الصَّغِيرَةُ..."
 },
 {
  "i": 122,
  "start": 269.66,
  "end": 270.38,
  "text": "لَا تَتَحَرَّكُ."
 },
 {
  "i": 123,
  "start": 270.82,
  "end": 271.96,
  "text": "نُورُ تَبْكِي."
 },
 {
  "i": 124,
  "start": 272.1,
  "end": 273.7,
  "text": "وَأَنْتَ تَعْرِفُ الْجَوَابَ فَوْرًا."
 },
 {
  "i": 125,
  "start": 274.08,
  "end": 274.88,
  "text": "تَشْرَحُ لَهَا."
 },
 {
  "i": 126,
  "start": 275.38,
  "end": 278.42,
  "text": "هَذَا النَّوْعُ مِنَ السَّمَكِ يَعِيشُ عَادَةً عَامَيْنِ أَوْ ثَلَاثَةً."
 },
 {
  "i": 127,
  "start": 278.62,
  "end": 280.9,
  "text": "وَسَمَكَتُكِ عَاشَتْ أَكْثَرَ مِنَ الْمُتَوَسِّطِ."
 },
 {
  "i": 128,
  "start": 281.3,
  "end": 282.86,
  "text": "هَذَا أَمْرٌ جَيِّدٌ إِحْصَائِيًّا."
 },
 {
  "i": 129,
  "start": 283.28,
  "end": 284.52,
  "text": "تَنْظُرُ إِلَيْكَ نُورُ."
 },
 {
  "i": 130,
  "start": 284.88,
  "end": 286.0,
  "text": "ثُمَّ تَبْكِي أَكْثَرَ."
 },
 {
  "i": 131,
  "start": 286.38,
  "end": 287.86,
  "text": "ثُمَّ تَرْكُضُ إِلَى غُرْفَتِهَا..."
 },
 {
  "i": 132,
  "start": 288.16,
  "end": 289.34,
  "text": "وَتُغْلِقُ الْبَابَ."
 },
 {
  "i": 133,
  "start": 289.74,
  "end": 291.02,
  "text": "تَقِفُ وَحْدَكَ فِي الْمَمَرِّ."
 },
 {
  "i": 134,
  "start": 291.36,
  "end": 293.22,
  "text": "عَقْلُكَ يَعْمَلُ بِأَقْصَى سُرْعَتِهِ."
 },
 {
  "i": 135,
  "start": 293.22,
  "end": 295.42,
  "text": "مِئَةُ حَلٍّ فِي ثَانِيَةٍ وَاحِدَةٍ."
 },
 {
  "i": 136,
  "start": 295.74,
  "end": 296.76,
  "text": "سَمَكَةٌ جَدِيدَةٌ."
 },
 {
  "i": 137,
  "start": 297.3,
  "end": 298.68,
  "text": "كِتَابٌ عَنِ الْأَسْمَاكِ."
 },
 {
  "i": 138,
  "start": 298.68,
  "end": 301.32,
  "text": "خُطَّةٌ مِنْ عَشْرِ خُطُوَاتٍ لِلتَّعَامُلِ مَعَ الْحُزْنِ."
 },
 {
  "i": 139,
  "start": 301.7,
  "end": 304.62,
  "text": "وَكُلُّ حَلٍّ تَعْرِفُ أَنَّهُ سَيَجْعَلُ الْأَمْرَ أَسْوَأَ."
 },
 {
  "i": 140,
  "start": 304.62,
  "end": 308.68,
  "text": "وَتَتَذَكَّرُ أَنَّ هَادِيًا اتَّصَلَ بِكَ قَبْلَ أُسْبُوعٍ حَزِينًا لِأَنَّ جَدَّهُ مَرِيضٌ."
 },
 {
  "i": 141,
  "start": 309.1,
  "end": 311.32,
  "text": "فَأَرْسَلْتَ لَهُ جَدْوَلًا بِأَفْضَلِ الْمُسْتَشْفَيَاتِ."
 },
 {
  "i": 142,
  "start": 311.62,
  "end": 314.1,
  "text": "وَلَمْ يَرُدَّ عَلَيْكَ مُنْذُ ذَلِكَ الْيَوْمِ."
 },
 {
  "i": 143,
  "start": 314.1,
  "end": 315.48,
  "text": "لِأَنَّ الْقَاعِدَةَ لَا تَرْحَمُ."
 },
 {
  "i": 144,
  "start": 316.02,
  "end": 317.0,
  "text": "الْحُزْنُ لَا يُحَلُّ..."
 },
 {
  "i": 145,
  "start": 317.4,
  "end": 318.54,
  "text": "الْحُزْنُ يُرَافَقُ."
 },
 {
  "i": 146,
  "start": 318.82,
  "end": 319.64,
  "text": "وَهُنَا تَفْهَمُ."
 },
 {
  "i": 147,
  "start": 320.18,
  "end": 321.24,
  "text": "أَمَامَكَ طَرِيقَانِ."
 },
 {
  "i": 148,
  "start": 321.68,
  "end": 324.18,
  "text": "إِمَّا أَنْ تَطْرُقَ الْبَابَ بِحَلٍّ ذَكِيٍّ جَدِيدٍ..."
 },
 {
  "i": 149,
  "start": 324.26,
  "end": 327.1,
  "text": "وَإِمَّا أَنْ تَفْعَلَ الشَّيْءَ الْوَحِيدَ الَّذِي لَمْ تَتَعَلَّمْهُ أَبَدًا."
 },
 {
  "i": 150,
  "start": 327.66,
  "end": 328.4,
  "text": "أَنْ تَجْلِسَ."
 },
 {
  "i": 151,
  "start": 328.86,
  "end": 329.56,
  "text": "وَتَصْمُتَ."
 },
 {
  "i": 152,
  "start": 329.98,
  "end": 331.54,
  "text": "تَجْلِسُ عَلَى الْأَرْضِ أَمَامَ بَابِهَا."
 },
 {
  "i": 153,
  "start": 331.96,
  "end": 333.02,
  "text": "لَا تَقُولُ شَيْئًا."
 },
 {
  "i": 154,
  "start": 333.52,
  "end": 334.1,
  "text": "دَقِيقَةٌ."
 },
 {
  "i": 155,
  "start": 334.64,
  "end": 335.22,
  "text": "ثُمَّ عَشْرٌ."
 },
 {
  "i": 156,
  "start": 335.66,
  "end": 336.66,
  "text": "ثُمَّ نِصْفُ سَاعَةٍ."
 },
 {
  "i": 157,
  "start": 337.14,
  "end": 339.2,
  "text": "تَسْمَعُ بُكَاءَهَا يَخِفُّ شَيْئًا فَشَيْئًا."
 },
 {
  "i": 158,
  "start": 339.7,
  "end": 340.52,
  "text": "وَلِأَوَّلِ مَرَّةٍ..."
 },
 {
  "i": 159,
  "start": 340.98,
  "end": 342.24,
  "text": "لَا تُحَاوِلُ أَنْ تَفْهَمَ."
 },
 {
  "i": 160,
  "start": 342.7,
  "end": 344.02,
  "text": "تَكْتَفِي بِأَنْ تَكُونَ هُنَا."
 },
 {
  "i": 161,
  "start": 344.58,
  "end": 346.12,
  "text": "ثُمَّ تَأْخُذُ وَرَقَةً وَقَلَمًا."
 },
 {
  "i": 162,
  "start": 346.62,
  "end": 348.3,
  "text": "وَلِأَوَّلِ مَرَّةٍ فِي حَيَاتِكَ..."
 },
 {
  "i": 163,
  "start": 348.52,
  "end": 350.22,
  "text": "تَرْسُمُ رَسْمَةً سَيِّئَةً جِدًّا."
 },
 {
  "i": 164,
  "start": 350.56,
  "end": 351.98,
  "text": "شَمْسٌ صَفْرَاءُ."
 },
 {
  "i": 165,
  "start": 352.1,
  "end": 353.1,
  "text": "وَوَلَدٌ طَوِيلٌ."
 },
 {
  "i": 166,
  "start": 353.54,
  "end": 355.68,
  "text": "وَبِنْتٌ صَغِيرَةٌ تُمْسِكُ يَدَهُ."
 },
 {
  "i": 167,
  "start": 355.68,
  "end": 358.08,
  "text": "وَسَمَكَةٌ صَغِيرَةٌ تَسْبَحُ فِي السَّمَاءِ."
 },
 {
  "i": 168,
  "start": 358.08,
  "end": 359.58,
  "text": "تُدْخِلُهَا مِنْ تَحْتِ الْبَابِ."
 },
 {
  "i": 169,
  "start": 359.98,
  "end": 361.18,
  "text": "يَمُرُّ وَقْتٌ طَوِيلٌ."
 },
 {
  "i": 170,
  "start": 361.56,
  "end": 362.78,
  "text": "ثُمَّ يُفْتَحُ الْبَابُ."
 },
 {
  "i": 171,
  "start": 363.14,
  "end": 365.02,
  "text": "نُورُ تَجْلِسُ بِجَانِبِكَ عَلَى الْأَرْضِ."
 },
 {
  "i": 172,
  "start": 365.38,
  "end": 366.88,
  "text": "وَتَضَعُ رَأْسَهَا عَلَى كَتِفِكَ."
 },
 {
  "i": 173,
  "start": 367.24,
  "end": 368.9,
  "text": "لَا أَحَدَ مِنْكُمَا يَقُولُ شَيْئًا."
 },
 {
  "i": 174,
  "start": 369.42,
  "end": 370.66,
  "text": "وَبَعْدَ قَلِيلٍ..."
 },
 {
  "i": 175,
  "start": 370.66,
  "end": 372.14,
  "text": "تَسْأَلُكَ بِصَوْتٍ صَغِيرٍ."
 },
 {
  "i": 176,
  "start": 372.58,
  "end": 374.7,
  "text": "هَلْ أَنْتَ سَعِيدٌ؟ وَلِأَوَّلِ مَرَّةٍ..."
 },
 {
  "i": 177,
  "start": 375.14,
  "end": 376.26,
  "text": "لَا تَحْسُبُ شَيْئًا."
 },
 {
  "i": 178,
  "start": 376.76,
  "end": 377.24,
  "text": "نَعَمْ."
 },
 {
  "i": 179,
  "start": 377.68,
  "end": 379.28,
  "text": "وَفِي الْمَسَاءِ تَتَّصِلُ بِهَادِي."
 },
 {
  "i": 180,
  "start": 379.52,
  "end": 382.52,
  "text": "وَتَطْلُبُ مِنْهُ أَنْ يَحْكِيَ لَكَ قِصَّتَهُ مِنَ الْبِدَايَةِ."
 },
 {
  "i": 181,
  "start": 382.74,
  "end": 384.64,
  "text": "وَتَسْتَمِعُ لَهَا حَتَّى النِّهَايَةِ."
 },
 {
  "i": 182,
  "start": 384.8,
  "end": 386.3,
  "text": "دُونَ أَنْ تَقُولَهَا قَبْلَهُ."
 },
 {
  "i": 183,
  "start": 386.66,
  "end": 389.82,
  "text": "وَتَضَعُ رَسْمَةَ نُورَ الْجَدِيدَةَ فِي إِطَارٍ فَوْقَ سَرِيرِكَ..."
 },
 {
  "i": 184,
  "start": 389.82,
  "end": 391.4,
  "text": "بِجَانِبِ شَهَادَةِ الْجَامِعَةِ."
 },
 {
  "i": 185,
  "start": 391.82,
  "end": 392.74,
  "text": "وَالرَّسْمَةُ أَكْبَرُ."
 },
 {
  "i": 186,
  "start": 392.74,
  "end": 395.42,
  "text": "ذَكَاؤُكَ مَا زَالَ أَعْلَى بِعَشَرَةِ أَضْعَافٍ."
 },
 {
  "i": 187,
  "start": 395.84,
  "end": 398.88,
  "text": "لَكِنَّكَ تَعَلَّمْتَ الشَّيْءَ الْوَحِيدَ الَّذِي لَا يُعَلِّمُهُ الذَّكَاءُ."
 },
 {
  "i": 188,
  "start": 399.28,
  "end": 400.5,
  "text": "أَنَّ أَذْكَى إِجَابَةٍ..."
 },
 {
  "i": 189,
  "start": 400.5,
  "end": 401.8,
  "text": "أَحْيَانًا أَنْ تَصْمُتَ..."
 },
 {
  "i": 190,
  "start": 402.1,
  "end": 403.68,
  "text": "وَتَجْلِسَ بِجَانِبِ مَنْ تُحِبُّ."
 },
 {
  "i": 191,
  "start": 404.12,
  "end": 408.48,
  "text": "فَمَا الْحَقِيقِيُّ فِي هَذِهِ الْقِصَّةِ؟ اخْتِبَارَاتُ الذَّكَاءِ تُقَارِنُكَ بِغَيْرِكَ."
 },
 {
  "i": 192,
  "start": 408.74,
  "end": 411.24,
  "text": "وَالْمُتَوَسِّطُ فِيهَا مِئَةٌ بِالتَّعْرِيفِ."
 },
 {
  "i": 193,
  "start": 411.26,
  "end": 413.58,
  "text": "لِذَلِكَ فَذَكَاءٌ أَعْلَى بِعَشَرَةِ أَضْعَافٍ..."
 },
 {
  "i": 194,
  "start": 414.0,
  "end": 416.54,
  "text": "لَا تَسْتَطِيعُ هَذِهِ الِاخْتِبَارَاتُ قِيَاسَهُ أَصْلًا."
 },
 {
  "i": 195,
  "start": 416.54,
  "end": 420.58,
  "text": "وَالدِّمَاغُ يَسْتَهْلِكُ فِعْلًا نَحْوَ خُمْسِ طَاقَةِ الْجِسْمِ."
 },
 {
  "i": 196,
  "start": 421.06,
  "end": 427.0,
  "text": "وَمِنَ الْحَقَائِقِ الْغَرِيبَةِ أَنَّ مُتَوَسِّطَ دَرَجَاتِ اخْتِبَارَاتِ الذَّكَاءِ ارْتَفَعَ فِي بُلْدَانٍ كَثِيرَةٍ خِلَالَ الْقَرْنِ الْعِشْرِينَ..."
 },
 {
  "i": 197,
  "start": 427.44,
  "end": 429.64,
  "text": "بِنَحْوِ ثَلَاثِ نِقَاطٍ كُلَّ عَشْرِ سَنَوَاتٍ."
 },
 {
  "i": 198,
  "start": 430.22,
  "end": 432.34,
  "text": "وَيُسَمَّى هَذَا أَثَرَ فْلِين."
 },
 {
  "i": 199,
  "start": 432.34,
  "end": 434.38,
  "text": "وَيَخْتَلِفُ الْعُلَمَاءُ فِي سَبَبِهِ."
 },
 {
  "i": 200,
  "start": 434.38,
  "end": 448.1,
  "text": "هَلْ هُوَ التَّعْلِيمُ؟ أَمِ التَّغْذِيَةُ؟ أَمْ تَغَيُّرُ طَرِيقَةِ تَفْكِيرِنَا؟ وَفِي عَامِ 1921 بَدَأَ الْعَالِمُ الْأَمْرِيكِيُّ لُوِيس تِرْمَان دِرَاسَةً تَابَعَ فِيهَا أَكْثَرَ مِنْ أَلْفٍ وَخَمْسِمِئَةِ طِفْلٍ ذَكِيٍّ جِدًّا لِسَنَوَاتٍ طَوِيلَةٍ."
 },
 {
  "i": 201,
  "start": 448.2,
  "end": 449.5,
  "text": "نَجَحَ كَثِيرٌ مِنْهُمْ..."
 },
 {
  "i": 202,
  "start": 449.88,
  "end": 453.36,
  "text": "لَكِنَّ الذَّكَاءَ الْعَالِيَ وَحْدَهُ لَمْ يَضْمَنْ لَهُمْ إِنْجَازًا اسْتِثْنَائِيًّا."
 },
 {
  "i": 203,
  "start": 453.74,
  "end": 457.38,
  "text": "وَمِنَ الْمُفَارَقَاتِ أَنَّ طِفْلَيْنِ اخْتُبِرَا وَلَمْ يُخْتَارَا لِلدِّرَاسَةِ..."
 },
 {
  "i": 204,
  "start": 457.38,
  "end": 460.26,
  "text": "فَازَا لَاحِقًا بِجَائِزَةِ نُوبِلَ فِي الْفِيزِيَاءِ."
 },
 {
  "i": 205,
  "start": 460.26,
  "end": 461.48,
  "text": "أَمَّا الذَّكَاءُ الْعَاطِفِيُّ..."
 },
 {
  "i": 206,
  "start": 461.48,
  "end": 465.32,
  "text": "فَقَدْ طَرَحَهُ بَاحِثَانِ عَامَ 1990."
 },
 {
  "i": 207,
  "start": 465.32,
  "end": 469.58,
  "text": "وَانْتَشَرَ بَعْدَ كِتَابِ دَانْيِيل جُولْمَان عَامَ 1995."
 },
 {
  "i": 208,
  "start": 469.58,
  "end": 472.5,
  "text": "يَرَاهُ بَعْضُ الْعُلَمَاءِ قُدْرَةً مُسْتَقِلَّةً مُهِمَّةً..."
 },
 {
  "i": 209,
  "start": 472.5,
  "end": 475.9,
  "text": "وَيَرَى آخَرُونَ أَنَّهُ يَتَدَاخَلُ مَعَ سِمَاتٍ أُخْرَى فِي الشَّخْصِيَّةِ."
 },
 {
  "i": 210,
  "start": 476.38,
  "end": 478.1,
  "text": "وَالنِّقَاشُ مُسْتَمِرٌّ."
 },
 {
  "i": 211,
  "start": 478.1,
  "end": 479.28,
  "text": "وَفِي الْحَلْقَةِ الْقَادِمَةِ..."
 },
 {
  "i": 212,
  "start": 479.76,
  "end": 484.28,
  "text": "مَاذَا لَوْ لَمْ تَشْعُرْ بِالْأَلَمِ أَبَدًا؟ مَا رَأْيُكَ؟ أَخْبِرْنَا فِي التَّعْلِيقَاتِ..."
 },
 {
  "i": 213,
  "start": 484.68,
  "end": 486.98,
  "text": "وَأَخْبِرْنَا أَيَّ قُدْرَةٍ نُجَرِّبُهَا بَعْدَ ذَلِكَ."
 },
 {
  "i": 214,
  "start": 486.98,
  "end": 488.46,
  "text": "اضْغَطْ زِرَّ الْإِعْجَابِ..."
 },
 {
  "i": 215,
  "start": 488.84,
  "end": 489.9,
  "text": "وَاشْتَرِكْ لِلْمَزِيدِ."
 }
]