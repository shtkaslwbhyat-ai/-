[
 {
  "i": 0,
  "start": 0.0,
  "end": 1.06,
  "text": "تَفْتَحُ عَيْنَيْكَ."
 },
 {
  "i": 1,
  "start": 1.06,
  "end": 2.0,
  "text": "السَّقْفُ أَبْيَضُ."
 },
 {
  "i": 2,
  "start": 2.54,
  "end": 3.48,
  "text": "الْغُرْفَةُ غُرْفَتُكَ..."
 },
 {
  "i": 3,
  "start": 3.8,
  "end": 6.54,
  "text": "لَكِنَّ عَلَى الْمِرْآةِ وَرَقَةً صَفْرَاءَ بِخَطِّ يَدِكَ."
 },
 {
  "i": 4,
  "start": 6.84,
  "end": 7.54,
  "text": "لَا تَخَفْ."
 },
 {
  "i": 5,
  "start": 7.54,
  "end": 9.12,
  "text": "اقْرَأْ هَذَا أَوَّلًا."
 },
 {
  "i": 6,
  "start": 9.52,
  "end": 10.04,
  "text": "تَقْتَرِبُ."
 },
 {
  "i": 7,
  "start": 10.44,
  "end": 12.02,
  "text": "تَحْتَهَا وَرَقَةٌ ثَانِيَةٌ."
 },
 {
  "i": 8,
  "start": 12.3,
  "end": 13.26,
  "text": "اسْمُكَ كَرِيمٌ."
 },
 {
  "i": 9,
  "start": 13.62,
  "end": 15.34,
  "text": "عُمْرُكَ سِتَّةٌ وَعِشْرُونَ عَامًا."
 },
 {
  "i": 10,
  "start": 15.76,
  "end": 17.52,
  "text": "وَالْيَوْمُ هُوَ الْيَوْمُ الْمِئَةُ."
 },
 {
  "i": 11,
  "start": 17.6,
  "end": 18.38,
  "text": "تَضْحَكُ."
 },
 {
  "i": 12,
  "start": 18.38,
  "end": 19.66,
  "text": "مُزْحَةٌ سَخِيفَةٌ."
 },
 {
  "i": 13,
  "start": 19.9,
  "end": 22.12,
  "text": "ثُمَّ تَرَى الدَّفْتَرَ الْأَزْرَقَ عَلَى الْوِسَادَةِ."
 },
 {
  "i": 14,
  "start": 22.42,
  "end": 23.54,
  "text": "مِئَةُ صَفْحَةٍ."
 },
 {
  "i": 15,
  "start": 23.54,
  "end": 24.58,
  "text": "بِخَطِّكَ أَنْتَ."
 },
 {
  "i": 16,
  "start": 24.98,
  "end": 27.04,
  "text": "وَكُلُّ صَفْحَةٍ تَبْدَأُ بِالْجُمْلَةِ نَفْسِهَا..."
 },
 {
  "i": 17,
  "start": 27.04,
  "end": 28.16,
  "text": "لَا تَخَفْ."
 },
 {
  "i": 18,
  "start": 28.16,
  "end": 30.78,
  "text": "فِي اللَّيْلِ لَا يَنَامُ دِمَاغُكَ تَمَامًا."
 },
 {
  "i": 19,
  "start": 30.78,
  "end": 33.06,
  "text": "إِنَّهُ يُعِيدُ تَشْغِيلَ مَا عِشْتَهُ فِي النَّهَارِ..."
 },
 {
  "i": 20,
  "start": 33.38,
  "end": 36.16,
  "text": "وَيُثَبِّتُ الْمُهِمَّ مِنْهُ فِي ذَاكِرَةٍ أَطْوَلَ عُمْرًا."
 },
 {
  "i": 21,
  "start": 36.52,
  "end": 40.52,
  "text": "وَلِجُزْءٍ صَغِيرٍ فِي عُمْقِ الدِّمَاغِ اسْمُهُ الْحُصَيْنُ دَوْرٌ كَبِيرٌ فِي ذَلِكَ."
 },
 {
  "i": 22,
  "start": 40.9,
  "end": 42.72,
  "text": "هَكَذَا يَصِيرُ يَوْمُكَ ذِكْرَى."
 },
 {
  "i": 23,
  "start": 42.72,
  "end": 46.0,
  "text": "أَمَّا أَنْتَ؟ فَكُلُّ مَا عِشْتَهُ قَبْلَ الْحَادِثِ بَاقٍ."
 },
 {
  "i": 24,
  "start": 46.0,
  "end": 46.72,
  "text": "اسْمُكَ."
 },
 {
  "i": 25,
  "start": 46.98,
  "end": 47.44,
  "text": "أَهْلُكَ."
 },
 {
  "i": 26,
  "start": 47.68,
  "end": 48.36,
  "text": "طُفُولَتُكَ."
 },
 {
  "i": 27,
  "start": 48.68,
  "end": 50.26,
  "text": "لَكِنَّ كُلَّ يَوْمٍ جَدِيدٍ..."
 },
 {
  "i": 28,
  "start": 50.26,
  "end": 51.98,
  "text": "يُمْحَى لَحْظَةَ تَنَامُ."
 },
 {
  "i": 29,
  "start": 52.32,
  "end": 53.96,
  "text": "وَهُنَاكَ قَاعِدَةٌ وَاحِدَةٌ."
 },
 {
  "i": 30,
  "start": 54.06,
  "end": 55.82,
  "text": "مَا يَحْفَظُهُ عَقْلُكَ يَضِيعُ."
 },
 {
  "i": 31,
  "start": 56.16,
  "end": 58.88,
  "text": "لَكِنَّ مَا تَتَعَلَّمُهُ يَدَاكَ وَقَدَمَاكَ..."
 },
 {
  "i": 32,
  "start": 58.88,
  "end": 59.64,
  "text": "يَبْقَى."
 },
 {
  "i": 33,
  "start": 59.72,
  "end": 61.9,
  "text": "فَالذَّاكِرَةُ لَيْسَتْ فِي الرَّأْسِ وَحْدَهُ."
 },
 {
  "i": 34,
  "start": 61.9,
  "end": 67.08,
  "text": "فَمَاذَا لَوْ كَانَ كُلُّ يَوْمٍ يُمْحَى مِنْ ذَاكِرَتِكَ لَحْظَةَ تَنَامُ؟ تَبْدَأُ كُلَّ صَبَاحٍ بِالدَّفْتَرِ."
 },
 {
  "i": 35,
  "start": 67.58,
  "end": 69.26,
  "text": "ثَلَاثُونَ دَقِيقَةً مِنَ الْقِرَاءَةِ..."
 },
 {
  "i": 36,
  "start": 69.26,
  "end": 71.52,
  "text": "قَبْلَ أَنْ تَعْرِفَ مَنْ أَنْتَ الْيَوْمَ."
 },
 {
  "i": 37,
  "start": 71.52,
  "end": 74.58,
  "text": "صَدِيقُكَ سَامِرٌ يَحْكِي لَكَ النُّكْتَةَ نَفْسَهَا مُنْذُ شَهْرَيْنِ."
 },
 {
  "i": 38,
  "start": 75.06,
  "end": 77.72,
  "text": "وَأَنْتَ تَضْحَكُ كُلَّ مَرَّةٍ حَتَّى تَدْمَعَ عَيْنَاكَ."
 },
 {
  "i": 39,
  "start": 77.72,
  "end": 79.34,
  "text": "هُوَ أَسْعَدُ صَدِيقٍ فِي الْعَالَمِ."
 },
 {
  "i": 40,
  "start": 79.8,
  "end": 82.04,
  "text": "تَذْهَبُ إِلَى السُّوقِ بِقَائِمَةٍ مَكْتُوبَةٍ."
 },
 {
  "i": 41,
  "start": 82.24,
  "end": 83.16,
  "text": "تَشْتَرِي الْخُبْزَ."
 },
 {
  "i": 42,
  "start": 83.16,
  "end": 86.72,
  "text": "ثُمَّ تَجِدُ فِي الْمَطْبَخِ ثَلَاثَةَ أَرْغِفَةٍ اشْتَرَيْتَهَا فِي الصَّبَاحِ."
 },
 {
  "i": 43,
  "start": 86.98,
  "end": 89.16,
  "text": "فَتُضِيفُ إِلَى الدَّفْتَرِ قَاعِدَةً جَدِيدَةً."
 },
 {
  "i": 44,
  "start": 89.42,
  "end": 91.88,
  "text": "لَا تَشْتَرِ الْخُبْزَ قَبْلَ أَنْ تَنْظُرَ فِي الْمَطْبَخِ."
 },
 {
  "i": 45,
  "start": 91.88,
  "end": 95.38,
  "text": "فِيلْمُكَ الْمُفَضَّلُ؟ شَاهَدْتَهُ سَبْعًا وَعِشْرِينَ مَرَّةً."
 },
 {
  "i": 46,
  "start": 95.92,
  "end": 96.78,
  "text": "وَفِي كُلِّ مَرَّةٍ..."
 },
 {
  "i": 47,
  "start": 97.16,
  "end": 98.28,
  "text": "تُفَاجِئُكَ النِّهَايَةُ."
 },
 {
  "i": 48,
  "start": 98.78,
  "end": 99.98,
  "text": "وَهُنَاكَ مَا هُوَ أَغْرَبُ."
 },
 {
  "i": 49,
  "start": 100.5,
  "end": 102.4,
  "text": "أُمُّكَ تَضَعُ أَمَامَكَ بِيَانُو قَدِيمًا."
 },
 {
  "i": 50,
  "start": 102.78,
  "end": 105.44,
  "text": "فِي الْيَوْمِ الْأَوَّلِ لَا تَعْرِفُ أَيْنَ تَضَعُ أَصَابِعَكَ."
 },
 {
  "i": 51,
  "start": 105.44,
  "end": 106.7,
  "text": "فِي الْيَوْمِ السِّتِّينَ..."
 },
 {
  "i": 52,
  "start": 107.08,
  "end": 108.32,
  "text": "تَعْزِفُ لَحْنًا كَامِلًا."
 },
 {
  "i": 53,
  "start": 108.92,
  "end": 110.94,
  "text": "وَلَا تَتَذَكَّرُ أَنَّكَ تَعَلَّمْتَهُ يَوْمًا."
 },
 {
  "i": 54,
  "start": 111.46,
  "end": 112.8,
  "text": "يَدَاكَ تَتَذَكَّرَانِ عَنْكَ."
 },
 {
  "i": 55,
  "start": 112.8,
  "end": 116.02,
  "text": "وَالْأَجْمَلُ؟ أَنْتَ لَا تَحْمِلُ ضَغِينَةً لِأَحَدٍ."
 },
 {
  "i": 56,
  "start": 116.4,
  "end": 118.18,
  "text": "الْخِلَافُ الَّذِي حَدَثَ أَمْسِ..."
 },
 {
  "i": 57,
  "start": 118.28,
  "end": 121.32,
  "text": "لَمْ يَحْدُثْ أَبَدًا بِالنِّسْبَةِ إِلَيْكَ."
 },
 {
  "i": 58,
  "start": 121.32,
  "end": 122.9,
  "text": "كُلُّ صَبَاحٍ صَفْحَةٌ بَيْضَاءُ."
 },
 {
  "i": 59,
  "start": 123.28,
  "end": 125.78,
  "text": "وَفِي الْعِيَادَةِ يُعْطِيكَ طَبِيبُكَ اخْتِبَارًا غَرِيبًا."
 },
 {
  "i": 60,
  "start": 126.18,
  "end": 129.42,
  "text": "تَرْسُمُ نَجْمَةً وَأَنْتَ لَا تَرَى يَدَكَ إِلَّا فِي مِرْآةٍ."
 },
 {
  "i": 61,
  "start": 129.42,
  "end": 131.8,
  "text": "فِي الْيَوْمِ الْأَوَّلِ تَرْسُمُهَا فِي سِتِّ دَقَائِقَ."
 },
 {
  "i": 62,
  "start": 132.06,
  "end": 133.46,
  "text": "فِي الْيَوْمِ الْعَاشِرِ..."
 },
 {
  "i": 63,
  "start": 133.46,
  "end": 135.06,
  "text": "فِي دَقِيقَةٍ وَاحِدَةٍ."
 },
 {
  "i": 64,
  "start": 135.08,
  "end": 137.9,
  "text": "وَأَنْتَ تُقْسِمُ أَنَّكَ تَرَى هَذَا الِاخْتِبَارَ لِأَوَّلِ مَرَّةٍ."
 },
 {
  "i": 65,
  "start": 138.32,
  "end": 140.74,
  "text": "يَقُولُ لَكَ طَبِيبُكَ إِنَّ حَالَتَكَ خَيَالِيَّةٌ..."
 },
 {
  "i": 66,
  "start": 140.94,
  "end": 143.22,
  "text": "لَكِنَّهَا تُشْبِهُ حَالَاتٍ حَقِيقِيَّةً."
 },
 {
  "i": 67,
  "start": 143.66,
  "end": 146.38,
  "text": "أَشْخَاصٌ فَقَدُوا الْقُدْرَةَ عَلَى صُنْعِ ذِكْرَيَاتٍ جَدِيدَةٍ."
 },
 {
  "i": 68,
  "start": 146.78,
  "end": 147.76,
  "text": "وَيُرِيكَ رَقْمًا."
 },
 {
  "i": 69,
  "start": 148.26,
  "end": 150.96,
  "text": "ثَلَاثَةُ آلَافٍ وَمِئَتَا سَطْرٍ فِي دَفْتَرِكَ."
 },
 {
  "i": 70,
  "start": 150.96,
  "end": 152.68,
  "text": "كُلُّهَا لِرَجُلٍ لَا تَتَذَكَّرُهُ..."
 },
 {
  "i": 71,
  "start": 153.06,
  "end": 153.66,
  "text": "هُوَ أَنْتَ."
 },
 {
  "i": 72,
  "start": 154.04,
  "end": 155.68,
  "text": "لَكِنَّ لِلصَّفْحَةِ الْبَيْضَاءِ ثَمَنًا."
 },
 {
  "i": 73,
  "start": 156.26,
  "end": 157.66,
  "text": "هُنَاكَ امْرَأَةٌ فِي الصُّوَرِ."
 },
 {
  "i": 74,
  "start": 157.66,
  "end": 158.94,
  "text": "اسْمُهَا مَرْيَمُ."
 },
 {
  "i": 75,
  "start": 159.34,
  "end": 160.14,
  "text": "خَطِيبَتُكَ."
 },
 {
  "i": 76,
  "start": 160.4,
  "end": 161.92,
  "text": "كُلَّ صَبَاحٍ تَطْرُقُ الْبَابَ..."
 },
 {
  "i": 77,
  "start": 162.32,
  "end": 164.16,
  "text": "وَتُعَرِّفُكَ بِنَفْسِهَا مِنْ جَدِيدٍ."
 },
 {
  "i": 78,
  "start": 164.5,
  "end": 166.52,
  "text": "تَبْتَسِمُ لَكَ كَأَنَّ الْأَمْرَ سَهْلٌ."
 },
 {
  "i": 79,
  "start": 166.94,
  "end": 169.26,
  "text": "وَفِي الصَّفْحَةِ السَّبْعِينَ كَتَبْتَ سَطْرًا وَاحِدًا."
 },
 {
  "i": 80,
  "start": 169.64,
  "end": 172.58,
  "text": "رَأَيْتُهَا تَبْكِي فِي الْمَطْبَخِ حِينَ ظَنَّتْ أَنِّي لَا أَرَاهَا."
 },
 {
  "i": 81,
  "start": 172.98,
  "end": 174.2,
  "text": "أَنْتَ لَا تَكْبُرُ مَعَهَا."
 },
 {
  "i": 82,
  "start": 174.4,
  "end": 176.14,
  "text": "كُلُّ يَوْمٍ هُوَ الْيَوْمُ الْأَوَّلُ."
 },
 {
  "i": 83,
  "start": 176.38,
  "end": 179.08,
  "text": "صِرْتَ تُسَجِّلُ لِنَفْسِكَ مَقْطَعًا كُلَّ لَيْلَةٍ."
 },
 {
  "i": 84,
  "start": 179.08,
  "end": 180.88,
  "text": "وَجْهُكَ يَقُولُ لِوَجْهِكَ..."
 },
 {
  "i": 85,
  "start": 180.88,
  "end": 182.0,
  "text": "كَانَ يَوْمًا جَمِيلًا."
 },
 {
  "i": 86,
  "start": 182.0,
  "end": 183.44,
  "text": "ثِقْ بِي."
 },
 {
  "i": 87,
  "start": 183.44,
  "end": 185.68,
  "text": "لَكِنَّكَ فِي الصَّبَاحِ تَنْظُرُ إِلَى الشَّاشَةِ..."
 },
 {
  "i": 88,
  "start": 185.92,
  "end": 188.18,
  "text": "كَأَنَّكَ تَنْظُرُ إِلَى غَرِيبٍ يُشْبِهُكَ."
 },
 {
  "i": 89,
  "start": 188.18,
  "end": 189.9,
  "text": "فَكَيْفَ تَعِدُ امْرَأَةً بِالْغَدِ..."
 },
 {
  "i": 90,
  "start": 190.42,
  "end": 193.66,
  "text": "وَأَنْتَ لَا تَمْلِكُ أَمْسَ؟ لَكِنَّ مَرْيَمَ لَا تَسْتَسْلِمُ."
 },
 {
  "i": 91,
  "start": 194.08,
  "end": 196.49,
  "text": "كُلَّ مَسَاءٍ تَأْخُذُكَ فِي الطَّرِيقِ نَفْسِهِ إِلَى الْبَحْرِ."
 },
 {
  "i": 92,
  "start": 196.44,
  "end": 198.08,
  "text": "شَارِعُ الْمَخْبَزِ."
 },
 {
  "i": 93,
  "start": 198.28,
  "end": 199.72,
  "text": "ثُمَّ الْجِسْرُ الصَّغِيرُ."
 },
 {
  "i": 94,
  "start": 200.02,
  "end": 201.22,
  "text": "ثُمَّ الدَّرَجُ الْحَجَرِيُّ."
 },
 {
  "i": 95,
  "start": 201.72,
  "end": 203.78,
  "text": "ثُمَّ الصَّخْرَةُ الْكَبِيرَةُ عِنْدَ الْمَاءِ."
 },
 {
  "i": 96,
  "start": 204.0,
  "end": 204.98,
  "text": "هُنَاكَ تَجْلِسَانِ."
 },
 {
  "i": 97,
  "start": 205.44,
  "end": 207.62,
  "text": "وَتَحْكِي لَكَ كَيْفَ الْتَقَيْتُمَا أَوَّلَ مَرَّةٍ."
 },
 {
  "i": 98,
  "start": 208.12,
  "end": 209.44,
  "text": "فِي مَحَطَّةِ الْحَافِلَاتِ."
 },
 {
  "i": 99,
  "start": 209.72,
  "end": 210.54,
  "text": "تَحْتَ الْمَطَرِ."
 },
 {
  "i": 100,
  "start": 211.0,
  "end": 213.22,
  "text": "وَأَنْتَ تَسْمَعُ الْقِصَّةَ كَأَنَّهَا فِيلْمٌ جَدِيدٌ."
 },
 {
  "i": 101,
  "start": 213.56,
  "end": 215.4,
  "text": "وَتَقَعُ فِي حُبِّهَا مِنْ جَدِيدٍ..."
 },
 {
  "i": 102,
  "start": 215.6,
  "end": 216.26,
  "text": "كُلَّ مَسَاءٍ."
 },
 {
  "i": 103,
  "start": 216.7,
  "end": 218.3,
  "text": "وَهُنَاكَ تَقُولُ لَكَ كُلَّ مَرَّةٍ..."
 },
 {
  "i": 104,
  "start": 218.8,
  "end": 219.94,
  "text": "أَنْتَ لَا تَتَذَكَّرُنِي..."
 },
 {
  "i": 105,
  "start": 220.36,
  "end": 221.82,
  "text": "لَكِنَّكَ تَجِدُنِي دَائِمًا."
 },
 {
  "i": 106,
  "start": 221.82,
  "end": 224.18,
  "text": "مِئَةُ مَسَاءٍ عَلَى الطَّرِيقِ نَفْسِهِ."
 },
 {
  "i": 107,
  "start": 224.46,
  "end": 226.94,
  "text": "وَأَنْتَ لَا تَتَذَكَّرُ خُطْوَةً وَاحِدَةً مِنْهُ."
 },
 {
  "i": 108,
  "start": 227.18,
  "end": 229.38,
  "text": "لَكِنَّ قَدَمَيْكَ تَمْشِيَانِهِ كُلَّ يَوْمٍ."
 },
 {
  "i": 109,
  "start": 229.72,
  "end": 232.18,
  "text": "ثُمَّ يَأْتِي الْيَوْمُ الْوَاحِدُ بَعْدَ الْمِئَةِ."
 },
 {
  "i": 110,
  "start": 232.3,
  "end": 233.14,
  "text": "يَرِنُّ هَاتِفُكَ."
 },
 {
  "i": 111,
  "start": 233.14,
  "end": 234.84,
  "text": "صَوْتُ مَرْيَمَ يَرْتَجِفُ."
 },
 {
  "i": 112,
  "start": 235.22,
  "end": 236.1,
  "text": "أَخُوهَا يُونُسُ."
 },
 {
  "i": 113,
  "start": 236.1,
  "end": 237.56,
  "text": "ثَمَانِي سَنَوَاتٍ."
 },
 {
  "i": 114,
  "start": 238.1,
  "end": 239.28,
  "text": "ضَاعَ عَلَى الشَّاطِئِ..."
 },
 {
  "i": 115,
  "start": 239.58,
  "end": 241.7,
  "text": "وَهِيَ عَالِقَةٌ فِي الْمُسْتَشْفَى مَعَ أَبِيهَا."
 },
 {
  "i": 116,
  "start": 242.12,
  "end": 243.48,
  "text": "أَنْتَ الْأَقْرَبُ إِلَى الْبَحْرِ."
 },
 {
  "i": 117,
  "start": 243.86,
  "end": 245.7,
  "text": "الشَّمْسُ تَغِيبُ بَعْدَ عِشْرِينَ دَقِيقَةً."
 },
 {
  "i": 118,
  "start": 246.04,
  "end": 247.48,
  "text": "ثُمَّ يَنْطَفِئُ الْهَاتِفُ."
 },
 {
  "i": 119,
  "start": 247.9,
  "end": 248.94,
  "text": "لَا خَرِيطَةَ."
 },
 {
  "i": 120,
  "start": 248.94,
  "end": 250.2,
  "text": "لَا طَرِيقَ تَعْرِفُهُ."
 },
 {
  "i": 121,
  "start": 250.54,
  "end": 251.58,
  "text": "وَالشَّاطِئُ طَوِيلٌ."
 },
 {
  "i": 122,
  "start": 252.06,
  "end": 254.16,
  "text": "كِيلُومِتْرَانِ مِنَ الرَّمْلِ وَالصُّخُورِ."
 },
 {
  "i": 123,
  "start": 254.16,
  "end": 255.02,
  "text": "تَفْتَحُ الدَّفْتَرَ."
 },
 {
  "i": 124,
  "start": 255.48,
  "end": 257.08,
  "text": "الطَّرِيقُ مَكْتُوبٌ فِي مَكَانٍ مَا..."
 },
 {
  "i": 125,
  "start": 257.58,
  "end": 259.22,
  "text": "بَيْنَ ثَلَاثَةِ آلَافِ سَطْرٍ."
 },
 {
  "i": 126,
  "start": 259.6,
  "end": 260.8,
  "text": "صَفْحَةُ الْيَوْمِ الثَّالِثِ."
 },
 {
  "i": 127,
  "start": 261.22,
  "end": 262.54,
  "text": "صَفْحَةُ الْيَوْمِ الْعِشْرِينَ."
 },
 {
  "i": 128,
  "start": 262.98,
  "end": 264.78,
  "text": "صَفْحَةُ الْيَوْمِ السِّتِّينَ."
 },
 {
  "i": 129,
  "start": 264.78,
  "end": 265.92,
  "text": "لَا شَيْءَ عَنِ الطَّرِيقِ."
 },
 {
  "i": 130,
  "start": 266.26,
  "end": 267.46,
  "text": "خَمْسُ دَقَائِقَ تَضِيعُ."
 },
 {
  "i": 131,
  "start": 268.0,
  "end": 268.8,
  "text": "وَهُنَا تَفْهَمُ."
 },
 {
  "i": 132,
  "start": 269.34,
  "end": 270.36,
  "text": "أَمَامَكَ طَرِيقَانِ."
 },
 {
  "i": 133,
  "start": 270.9,
  "end": 273.34,
  "text": "إِمَّا أَنْ تَبْحَثَ فِي ذَاكِرَةٍ مَكْتُوبَةٍ لَا تَنْتَهِي..."
 },
 {
  "i": 134,
  "start": 273.76,
  "end": 275.2,
  "text": "وَإِمَّا أَنْ تُغْلِقَ الدَّفْتَرَ..."
 },
 {
  "i": 135,
  "start": 275.52,
  "end": 277.13,
  "text": "وَتَثِقَ بِمَا لَا يُمْحَى."
 },
 {
  "i": 136,
  "start": 277.13,
  "end": 278.26,
  "text": "تُغْلِقُ الدَّفْتَرَ."
 },
 {
  "i": 137,
  "start": 278.5,
  "end": 279.08,
  "text": "تَخْرُجُ."
 },
 {
  "i": 138,
  "start": 279.52,
  "end": 281.1,
  "text": "وَتَتْرُكُ قَدَمَيْكَ تَمْشِيَانِ."
 },
 {
  "i": 139,
  "start": 281.54,
  "end": 282.6,
  "text": "شَارِعُ الْمَخْبَزِ."
 },
 {
  "i": 140,
  "start": 282.6,
  "end": 285.3,
  "text": "قَدَمَاكَ تَنْعَطِفَانِ وَحْدَهُمَا."
 },
 {
  "i": 141,
  "start": 285.3,
  "end": 286.26,
  "text": "الْجِسْرُ الصَّغِيرُ."
 },
 {
  "i": 142,
  "start": 286.6,
  "end": 288.22,
  "text": "لَا تَعْرِفُ لِمَاذَا تَعْرِفُهُ..."
 },
 {
  "i": 143,
  "start": 288.22,
  "end": 289.753,
  "text": "لَكِنَّكَ تَعْرِفُهُ."
 },
 {
  "i": 144,
  "start": 289.753,
  "end": 291.0,
  "text": "الدَّرَجُ الْحَجَرِيُّ."
 },
 {
  "i": 145,
  "start": 291.42,
  "end": 293.12,
  "text": "تَعُدُّ الدَّرَجَاتِ دُونَ أَنْ تُفَكِّرَ."
 },
 {
  "i": 146,
  "start": 293.66,
  "end": 294.46,
  "text": "وَهُنَاكَ..."
 },
 {
  "i": 147,
  "start": 294.46,
  "end": 295.66,
  "text": "عِنْدَ الصَّخْرَةِ الْكَبِيرَةِ..."
 },
 {
  "i": 148,
  "start": 295.66,
  "end": 298.18,
  "text": "يَجْلِسُ وَلَدٌ صَغِيرٌ يَبْكِي."
 },
 {
  "i": 149,
  "start": 298.2,
  "end": 299.54,
  "text": "يَرْفَعُ رَأْسَهُ وَيَقُولُ..."
 },
 {
  "i": 150,
  "start": 299.54,
  "end": 301.74,
  "text": "أُخْتِي تَأْتِي إِلَى هُنَا كُلَّ يَوْمٍ."
 },
 {
  "i": 151,
  "start": 302.12,
  "end": 302.98,
  "text": "فَانْتَظَرْتُهَا."
 },
 {
  "i": 152,
  "start": 303.38,
  "end": 304.42,
  "text": "تَجْلِسُ بِجَانِبِهِ."
 },
 {
  "i": 153,
  "start": 304.76,
  "end": 306.54,
  "text": "يَضَعُ يَدَهُ الصَّغِيرَةَ فِي يَدِكَ."
 },
 {
  "i": 154,
  "start": 306.54,
  "end": 308.2,
  "text": "وَالشَّمْسُ تَغْرَقُ فِي الْمَاءِ."
 },
 {
  "i": 155,
  "start": 308.62,
  "end": 311.1,
  "text": "وَبَعْدَ نِصْفِ سَاعَةٍ تَرْكُضُ نَحْوَكُمَا امْرَأَةٌ."
 },
 {
  "i": 156,
  "start": 311.34,
  "end": 312.48,
  "text": "لَا تَعْرِفُ وَجْهَهَا."
 },
 {
  "i": 157,
  "start": 312.86,
  "end": 314.74,
  "text": "لَكِنَّ يَدَكَ تَمْتَدُّ إِلَى يَدِهَا..."
 },
 {
  "i": 158,
  "start": 315.04,
  "end": 316.92,
  "text": "كَأَنَّهَا فَعَلَتْ ذَلِكَ مِئَةَ مَرَّةٍ."
 },
 {
  "i": 159,
  "start": 317.42,
  "end": 319.42,
  "text": "تَبْتَسِمُ مَرْيَمُ وَالدُّمُوعُ فِي عَيْنَيْهَا."
 },
 {
  "i": 160,
  "start": 319.8,
  "end": 322.66,
  "text": "أَلَمْ أَقُلْ لَكَ؟ أَنْتَ لَا تَتَذَكَّرُنِي..."
 },
 {
  "i": 161,
  "start": 322.66,
  "end": 324.04,
  "text": "لَكِنَّكَ تَجِدُنِي دَائِمًا."
 },
 {
  "i": 162,
  "start": 324.56,
  "end": 325.88,
  "text": "وَفِي تِلْكَ اللَّيْلَةِ..."
 },
 {
  "i": 163,
  "start": 325.88,
  "end": 328.42,
  "text": "تَكْتُبُ وَرَقَةً جَدِيدَةً عَلَى الْمِرْآةِ."
 },
 {
  "i": 164,
  "start": 328.42,
  "end": 329.08,
  "text": "لَا تَخَفْ."
 },
 {
  "i": 165,
  "start": 329.58,
  "end": 330.5,
  "text": "أَنْتَ لَسْتَ وَحْدَكَ."
 },
 {
  "i": 166,
  "start": 330.82,
  "end": 332.72,
  "text": "فَالذَّاكِرَةُ لَيْسَتْ فِي الرَّأْسِ وَحْدَهُ."
 },
 {
  "i": 167,
  "start": 332.74,
  "end": 338.52,
  "text": "فَمَا الْحَقِيقِيُّ فِي هَذِهِ الْقِصَّةِ؟ فُقْدَانُ الْقُدْرَةِ عَلَى صُنْعِ ذِكْرَيَاتٍ جَدِيدَةٍ حَالَةٌ حَقِيقِيَّةٌ."
 },
 {
  "i": 168,
  "start": 338.86,
  "end": 341.92,
  "text": "أَشْهَرُ مِثَالٍ عَلَيْهَا رَجُلٌ عُرِفَ بِاسْمِ هِنْرِي مُولَيْسُون."
 },
 {
  "i": 169,
  "start": 341.92,
  "end": 346.34,
  "text": "بَعْدَ جِرَاحَةٍ فِي دِمَاغِهِ عَامَ 1953..."
 },
 {
  "i": 170,
  "start": 346.34,
  "end": 349.9,
  "text": "لَمْ يَعُدْ قَادِرًا عَلَى حِفْظِ ذِكْرَيَاتٍ جَدِيدَةٍ طَوِيلَةِ الْأَمَدِ."
 },
 {
  "i": 171,
  "start": 349.9,
  "end": 352.14,
  "text": "وَمَعَ ذَلِكَ تَعَلَّمَ مَهَارَةَ رَسْمٍ صَعْبَةً..."
 },
 {
  "i": 172,
  "start": 352.46,
  "end": 354.5,
  "text": "وَتَحَسَّنَ فِيهَا يَوْمًا بَعْدَ يَوْمٍ..."
 },
 {
  "i": 173,
  "start": 354.72,
  "end": 356.96,
  "text": "دُونَ أَنْ يَتَذَكَّرَ أَنَّهُ تَدَرَّبَ عَلَيْهَا."
 },
 {
  "i": 174,
  "start": 357.32,
  "end": 364.02,
  "text": "وَالْعَازِفُ الْبِرِيطَانِيُّ كْلَايْف وِيرِينْغ فَقَدَ ذَاكِرَتَهُ عَامَ 1985 بِسَبَبِ عَدْوَى أَصَابَتْ دِمَاغَهُ..."
 },
 {
  "i": 175,
  "start": 364.02,
  "end": 365.76,
  "text": "لَكِنَّهُ ظَلَّ يَعْزِفُ..."
 },
 {
  "i": 176,
  "start": 365.96,
  "end": 368.98,
  "text": "وَظَلَّ يَسْتَقْبِلُ زَوْجَتَهُ بِفَرَحٍ كَبِيرٍ كُلَّمَا رَآهَا."
 },
 {
  "i": 177,
  "start": 368.98,
  "end": 372.68,
  "text": "أَمَّا أَنْ تُمْحَى الذَّاكِرَةُ بِالضَّبْطِ لَحْظَةَ النَّوْمِ؟ فَهَذَا خَيَالٌ."
 },
 {
  "i": 178,
  "start": 373.1,
  "end": 375.76,
  "text": "لَكِنَّ دَوْرَ النَّوْمِ فِي تَثْبِيتِ الذِّكْرَيَاتِ حَقِيقِيٌّ..."
 },
 {
  "i": 179,
  "start": 376.14,
  "end": 379.52,
  "text": "وَمَا زَالَ الْعُلَمَاءُ يَبْحَثُونَ كَيْفَ يَحْدُثُ ذَلِكَ بِالضَّبْطِ."
 },
 {
  "i": 180,
  "start": 379.52,
  "end": 380.68,
  "text": "وَفِي الْحَلْقَةِ الْقَادِمَةِ..."
 },
 {
  "i": 181,
  "start": 381.24,
  "end": 386.3,
  "text": "مَاذَا لَوْ كَانَ ذَكَاؤُكَ أَعْلَى بِعَشَرَةِ أَضْعَافٍ؟ مَا رَأْيُكَ؟ أَخْبِرْنَا فِي التَّعْلِيقَاتِ..."
 },
 {
  "i": 182,
  "start": 386.68,
  "end": 389.26,
  "text": "وَأَخْبِرْنَا أَيَّ قُدْرَةٍ نُجَرِّبُهَا بَعْدَ ذَلِكَ."
 },
 {
  "i": 183,
  "start": 389.26,
  "end": 390.52,
  "text": "اضْغَطْ زِرَّ الْإِعْجَابِ..."
 },
 {
  "i": 184,
  "start": 390.78,
  "end": 391.96,
  "text": "وَاشْتَرِكْ لِلْمَزِيدِ."
 }
]