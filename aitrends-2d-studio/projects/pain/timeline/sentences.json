[
 {
  "i": 0,
  "start": 0.0,
  "end": 2.42,
  "text": "الْمِقْلَاةُ عَلَى النَّارِ مُنْذُ عَشْرِ دَقَائِقَ."
 },
 {
  "i": 1,
  "start": 2.44,
  "end": 3.3,
  "text": "تَمُدُّ يَدَكَ..."
 },
 {
  "i": 2,
  "start": 3.58,
  "end": 5.56,
  "text": "وَتُمْسِكُهَا مِنْ حَافَّتِهَا الْحَدِيدِيَّةِ."
 },
 {
  "i": 3,
  "start": 6.04,
  "end": 6.92,
  "text": "أُمُّكَ تَصْرُخُ."
 },
 {
  "i": 4,
  "start": 7.28,
  "end": 9.02,
  "text": "وَأَنْتَ تَنْظُرُ إِلَى يَدِكَ بِاسْتِغْرَابٍ."
 },
 {
  "i": 5,
  "start": 9.52,
  "end": 10.24,
  "text": "الْجِلْدُ يَحْمَرُّ..."
 },
 {
  "i": 6,
  "start": 10.72,
  "end": 11.58,
  "text": "ثُمَّ يَنْتَفِخُ..."
 },
 {
  "i": 7,
  "start": 11.96,
  "end": 13.72,
  "text": "وَأَنْتَ لَا تَشْعُرُ بِشَيْءٍ."
 },
 {
  "i": 8,
  "start": 13.72,
  "end": 14.82,
  "text": "لَا لَسْعَ."
 },
 {
  "i": 9,
  "start": 14.82,
  "end": 15.82,
  "text": "لَا وَخْزَ."
 },
 {
  "i": 10,
  "start": 15.82,
  "end": 16.78,
  "text": "لَا شَيْءَ."
 },
 {
  "i": 11,
  "start": 16.78,
  "end": 19.14,
  "text": "فِي الْمَدْرَسَةِ تَصْطَدِمُ كُرَةٌ بِوَجْهِكَ بِقُوَّةٍ."
 },
 {
  "i": 12,
  "start": 19.6,
  "end": 21.1,
  "text": "الْجَمِيعُ يَتَأَلَّمُونَ لِأَجْلِكَ."
 },
 {
  "i": 13,
  "start": 21.54,
  "end": 22.44,
  "text": "وَأَنْتَ تَضْحَكُ..."
 },
 {
  "i": 14,
  "start": 22.8,
  "end": 24.24,
  "text": "وَتُكْمِلُ اللَّعِبَ."
 },
 {
  "i": 15,
  "start": 24.24,
  "end": 26.94,
  "text": "فِي عِيَادَةِ الْأَسْنَانِ يَرْفَعُ الطَّبِيبُ إِبْرَةَ التَّخْدِيرِ."
 },
 {
  "i": 16,
  "start": 27.3,
  "end": 29.2,
  "text": "تَقُولُ لَهُ: لَا دَاعِيَ."
 },
 {
  "i": 17,
  "start": 29.2,
  "end": 30.4,
  "text": "وَتَفْتَحُ فَمَكَ."
 },
 {
  "i": 18,
  "start": 30.7,
  "end": 31.84,
  "text": "أَنْتَ لَا تَشْعُرُ بِالْأَلَمِ."
 },
 {
  "i": 19,
  "start": 32.24,
  "end": 32.66,
  "text": "أَبَدًا."
 },
 {
  "i": 20,
  "start": 33.12,
  "end": 36.2,
  "text": "لَا جُرْحَ يُؤْلِمُكَ، وَلَا كَسْرَ، وَلَا حَرْقَ."
 },
 {
  "i": 21,
  "start": 36.2,
  "end": 43.46,
  "text": "فَهَلْ هَذِهِ أَعْظَمُ قُوَّةٍ يُمْكِنُ أَنْ يَمْلِكَهَا إِنْسَانٌ؟ أَمْ أَخْطَرُ لَعْنَةٍ؟ لَكِنَّ لِهَذِهِ الْقُوَّةِ قَاعِدَةً وَاحِدَةً."
 },
 {
  "i": 22,
  "start": 43.58,
  "end": 45.2,
  "text": "الْأَلَمُ لَيْسَ عَدُوَّكَ."
 },
 {
  "i": 23,
  "start": 45.2,
  "end": 46.4,
  "text": "الْأَلَمُ جَرَسُ إِنْذَارٍ."
 },
 {
  "i": 24,
  "start": 46.92,
  "end": 48.14,
  "text": "وَمَنْ لَا يَسْمَعُ الْجَرَسَ..."
 },
 {
  "i": 25,
  "start": 48.56,
  "end": 50.26,
  "text": "لَا يَعْرِفُ أَنَّ الْبَيْتَ يَحْتَرِقُ."
 },
 {
  "i": 26,
  "start": 50.26,
  "end": 51.72,
  "text": "اسْمُكَ يَزَنُ."
 },
 {
  "i": 27,
  "start": 51.72,
  "end": 52.98,
  "text": "خَمْسَةَ عَشَرَ عَامًا."
 },
 {
  "i": 28,
  "start": 53.44,
  "end": 55.88,
  "text": "وَسَتَتَعَلَّمُ يَوْمًا أَنَّ أَخْطَرَ الْجُرُوحِ..."
 },
 {
  "i": 29,
  "start": 55.88,
  "end": 57.38,
  "text": "هُوَ الْجُرْحُ الَّذِي لَا تَشْعُرُ بِهِ."
 },
 {
  "i": 30,
  "start": 57.84,
  "end": 59.64,
  "text": "فَمَاذَا لَوْ لَمْ تَشْعُرْ بِالْأَلَمِ أَبَدًا..."
 },
 {
  "i": 31,
  "start": 60.2,
  "end": 64.02,
  "text": "حَتَّى عِنْدَمَا يَجِبُ أَنْ تَشْعُرَ؟ فِي الْمَلْعَبِ أَنْتَ اللَّاعِبُ الَّذِي لَا يَسْقُطُ."
 },
 {
  "i": 32,
  "start": 64.46,
  "end": 68.3,
  "text": "يَدْفَعُونَكَ، يَرْكُلُونَ سَاقَيْكَ، تَقَعُ عَلَى الْأَرْضِ الصُّلْبَةِ..."
 },
 {
  "i": 33,
  "start": 68.4,
  "end": 70.28,
  "text": "ثُمَّ تَقُومُ فِي ثَانِيَةٍ وَتَرْكُضُ."
 },
 {
  "i": 34,
  "start": 70.68,
  "end": 73.18,
  "text": "الْمُدَرِّبُ يَبْتَسِمُ لِأَوَّلِ مَرَّةٍ مُنْذُ سَنَوَاتٍ."
 },
 {
  "i": 35,
  "start": 73.18,
  "end": 76.16,
  "text": "وَزُمَلَاؤُكَ يُسَمُّونَكَ: الرَّجُلَ الْحَدِيدِيَّ."
 },
 {
  "i": 36,
  "start": 76.62,
  "end": 79.74,
  "text": "وَحِينَ يَسْقُطُ زَمِيلٌ لَكَ وَيَصْرُخُ مِنْ إِصَابَةٍ صَغِيرَةٍ..."
 },
 {
  "i": 37,
  "start": 80.14,
  "end": 81.62,
  "text": "تَنْظُرُ إِلَيْهِ وَلَا تَفْهَمُ."
 },
 {
  "i": 38,
  "start": 82.12,
  "end": 88.0,
  "text": "لِمَاذَا كُلُّ هَذَا الصُّرَاخِ؟ صَدِيقُكَ طَارِقٌ يُصَوِّرُكَ وَأَنْتَ تَمْشِي حَافِيًا عَلَى الْإِسْفَلْتِ فِي ظُهْرِ الصَّيْفِ."
 },
 {
  "i": 39,
  "start": 88.34,
  "end": 89.46,
  "text": "الْمَقْطَعُ يَنْتَشِرُ."
 },
 {
  "i": 40,
  "start": 89.46,
  "end": 91.72,
  "text": "مِئَةُ أَلْفِ مُشَاهَدَةٍ فِي يَوْمَيْنِ."
 },
 {
  "i": 41,
  "start": 92.16,
  "end": 97.68,
  "text": "وَالتَّعْلِيقَاتُ تَسْأَلُ: هَلْ هَذَا حَقِيقِيٌّ؟ فِي يَوْمِ التَّطْعِيمِ تَقِفُ فِي أَوَّلِ الطَّابُورِ."
 },
 {
  "i": 42,
  "start": 97.68,
  "end": 100.36,
  "text": "وَفِي النَّادِي تَرْفَعُ أَوْزَانًا لَا يَرْفَعُهَا غَيْرُكَ..."
 },
 {
  "i": 43,
  "start": 100.36,
  "end": 102.6,
  "text": "وَلَا تَتَوَقَّفُ حِينَ تَصْرُخُ عَضَلَاتُكَ..."
 },
 {
  "i": 44,
  "start": 102.6,
  "end": 104.08,
  "text": "لِأَنَّكَ لَا تَسْمَعُهَا."
 },
 {
  "i": 45,
  "start": 104.44,
  "end": 109.54,
  "text": "وَفِي الصَّفِّ يَتَحَدَّاكَ طَارِقٌ أَمَامَ الْجَمِيعِ: ضَعْ يَدَكَ فِي الْمَاءِ الْمُثَلَّجِ دَقِيقَةً كَامِلَةً."
 },
 {
  "i": 46,
  "start": 109.92,
  "end": 111.32,
  "text": "تَضَعُهَا خَمْسَ دَقَائِقَ."
 },
 {
  "i": 47,
  "start": 111.66,
  "end": 113.06,
  "text": "الْجَمِيعُ يُصَفِّقُونَ..."
 },
 {
  "i": 48,
  "start": 113.42,
  "end": 115.82,
  "text": "وَيَدُكَ تَتَحَوَّلُ إِلَى لَوْنٍ لَمْ تَرَهُ مِنْ قَبْلُ."
 },
 {
  "i": 49,
  "start": 116.12,
  "end": 118.84,
  "text": "لَكِنَّ أُمَّكَ هُدَى لَا تَضْحَكُ مَعَ أَحَدٍ."
 },
 {
  "i": 50,
  "start": 119.28,
  "end": 121.68,
  "text": "كُلَّ مَسَاءٍ تُمْسِكُ وَرَقَةً قَدِيمَةً..."
 },
 {
  "i": 51,
  "start": 121.68,
  "end": 124.98,
  "text": "وَتَفْحَصُكَ كَمَا يَفْحَصُ الطَّيَّارُ طَائِرَتَهُ قَبْلَ الْإِقْلَاعِ."
 },
 {
  "i": 52,
  "start": 125.26,
  "end": 125.94,
  "text": "الْقَدَمَانِ."
 },
 {
  "i": 53,
  "start": 125.94,
  "end": 127.64,
  "text": "الرُّكْبَتَانِ."
 },
 {
  "i": 54,
  "start": 127.64,
  "end": 128.14,
  "text": "الْيَدَانِ."
 },
 {
  "i": 55,
  "start": 128.66,
  "end": 129.2,
  "text": "اللِّسَانُ."
 },
 {
  "i": 56,
  "start": 129.74,
  "end": 130.38,
  "text": "الْعَيْنَانِ."
 },
 {
  "i": 57,
  "start": 130.84,
  "end": 133.3,
  "text": "وَفِي إِحْدَى اللَّيَالِي تَسْمَعُهَا تَبْكِي فِي الْمَطْبَخِ."
 },
 {
  "i": 58,
  "start": 133.62,
  "end": 137.38,
  "text": "تَقُولُ لِأَبِيكَ: كُلُّ أُمٍّ تَعْرِفُ أَنَّ طِفْلَهَا مَرِيضٌ حِينَ يَبْكِي..."
 },
 {
  "i": 59,
  "start": 137.76,
  "end": 139.04,
  "text": "وَيَزَنُ لَا يَبْكِي أَبَدًا."
 },
 {
  "i": 60,
  "start": 139.58,
  "end": 141.62,
  "text": "هِيَ تَعْرِفُ مَا لَا يَعْرِفُهُ زُمَلَاؤُكَ."
 },
 {
  "i": 61,
  "start": 141.62,
  "end": 144.38,
  "text": "حِينَ كُنْتَ رَضِيعًا عَضَضْتَ لِسَانَكَ حَتَّى نَزَفَ..."
 },
 {
  "i": 62,
  "start": 144.7,
  "end": 145.76,
  "text": "وَلَمْ تَبْكِ."
 },
 {
  "i": 63,
  "start": 145.76,
  "end": 148.06,
  "text": "وَحِينَ بَدَأْتَ تَمْشِي، كُسِرَتْ قَدَمُكَ..."
 },
 {
  "i": 64,
  "start": 148.32,
  "end": 152.28,
  "text": "وَمَشَيْتَ عَلَيْهَا أُسْبُوعًا كَامِلًا قَبْلَ أَنْ يُلَاحِظَ أَحَدٌ أَنَّهَا مُتَوَرِّمَةٌ."
 },
 {
  "i": 65,
  "start": 152.76,
  "end": 155.26,
  "text": "وَذَاتَ مَسَاءٍ تَتَوَقَّفُ أُمُّكَ عِنْدَ كَاحِلِكَ."
 },
 {
  "i": 66,
  "start": 155.62,
  "end": 157.76,
  "text": "الْكَاحِلُ مُنْتَفِخٌ، وَلَوْنُهُ أَزْرَقُ."
 },
 {
  "i": 67,
  "start": 158.0,
  "end": 160.8,
  "text": "تَسْأَلُكَ: مُنْذُ مَتَى؟ وَأَنْتَ لَا تَعْرِفُ."
 },
 {
  "i": 68,
  "start": 160.8,
  "end": 164.26,
  "text": "فِي الْمُسْتَشْفَى يَضَعُ الطَّبِيبُ صُورَةَ الْأَشِعَّةِ عَلَى الضَّوْءِ."
 },
 {
  "i": 69,
  "start": 164.26,
  "end": 165.5,
  "text": "ثُمَّ يَصْمُتُ طَوِيلًا."
 },
 {
  "i": 70,
  "start": 165.82,
  "end": 167.44,
  "text": "كَسْرٌ جَدِيدٌ فِي الْكَاحِلِ..."
 },
 {
  "i": 71,
  "start": 167.7,
  "end": 170.24,
  "text": "وَثَلَاثَةُ كُسُورٍ قَدِيمَةٍ الْتَأَمَتْ وَحْدَهَا..."
 },
 {
  "i": 72,
  "start": 170.68,
  "end": 172.3,
  "text": "وَأَنْتَ لَمْ تَعْرِفْ بِأَيٍّ مِنْهَا."
 },
 {
  "i": 73,
  "start": 172.78,
  "end": 175.36,
  "text": "يَقُولُ الطَّبِيبُ: جِسْمُكَ يَصْرُخُ يَا يَزَنُ..."
 },
 {
  "i": 74,
  "start": 175.72,
  "end": 177.46,
  "text": "لَكِنْ لَا أَحَدَ يَسْمَعُهُ."
 },
 {
  "i": 75,
  "start": 177.48,
  "end": 178.48,
  "text": "وَلَا حَتَّى أَنْتَ."
 },
 {
  "i": 76,
  "start": 178.96,
  "end": 180.32,
  "text": "سِتَّةُ أَسَابِيعَ بِلَا كُرَةٍ."
 },
 {
  "i": 77,
  "start": 180.74,
  "end": 182.68,
  "text": "وَأَنْتَ تَرَى فَرِيقَكَ مِنَ الْمُدَرَّجَاتِ."
 },
 {
  "i": 78,
  "start": 182.68,
  "end": 183.96,
  "text": "الرَّجُلُ الْحَدِيدِيُّ..."
 },
 {
  "i": 79,
  "start": 183.96,
  "end": 185.82,
  "text": "يَجْلِسُ وَحْدَهُ."
 },
 {
  "i": 80,
  "start": 185.82,
  "end": 188.92,
  "text": "وَالْمَقَاطِعُ الَّتِي ضَحِكَ عَلَيْهَا النَّاسُ صَارَتْ تُخِيفُكَ."
 },
 {
  "i": 81,
  "start": 188.92,
  "end": 196.46,
  "text": "كُلَّمَا رَأَيْتَ قَدَمَيْكَ عَلَى الْإِسْفَلْتِ الْحَارِّ تَتَسَاءَلُ: مَاذَا احْتَرَقَ يَوْمَهَا وَلَمْ أَعْرِفْ؟ ثُمَّ يَأْتِي طَارِقٌ وَيَجْلِسُ بِجَانِبِكَ."
 },
 {
  "i": 82,
  "start": 196.46,
  "end": 199.66,
  "text": "يَحْذِفُ الْمَقْطَعَ أَمَامَكَ وَيَقُولُ: كُنَّا نَضْحَكُ..."
 },
 {
  "i": 83,
  "start": 199.66,
  "end": 200.68,
  "text": "وَلَمْ نَكُنْ نَعْرِفُ."
 },
 {
  "i": 84,
  "start": 201.1,
  "end": 202.96,
  "text": "مِنَ الْيَوْمِ أَنَا عَيْنُكَ فِي الْمَلْعَبِ."
 },
 {
  "i": 85,
  "start": 203.32,
  "end": 204.28,
  "text": "إِذَا رَأَيْتُ شَيْئًا..."
 },
 {
  "i": 86,
  "start": 204.82,
  "end": 205.54,
  "text": "سَأَقُولُهُ."
 },
 {
  "i": 87,
  "start": 205.9,
  "end": 207.0,
  "text": "ثُمَّ يَعُودُ الْمَوْسِمُ."
 },
 {
  "i": 88,
  "start": 207.54,
  "end": 208.82,
  "text": "وَيَأْتِي يَوْمُ النِّهَائِيِّ."
 },
 {
  "i": 89,
  "start": 209.14,
  "end": 210.88,
  "text": "فِي الصَّبَاحِ لَا تَأْكُلُ فُطُورَكَ."
 },
 {
  "i": 90,
  "start": 211.24,
  "end": 212.12,
  "text": "لَا جُوعَ عِنْدَكَ."
 },
 {
  "i": 91,
  "start": 212.52,
  "end": 214.48,
  "text": "أُمُّكَ تَضَعُ يَدَهَا عَلَى جَبِينِكَ..."
 },
 {
  "i": 92,
  "start": 214.48,
  "end": 216.22,
  "text": "ثُمَّ تُحْضِرُ مِقْيَاسَ الْحَرَارَةِ."
 },
 {
  "i": 93,
  "start": 216.22,
  "end": 217.96,
  "text": "تِسْعٌ وَثَلَاثُونَ دَرَجَةً."
 },
 {
  "i": 94,
  "start": 218.1,
  "end": 220.08,
  "text": "تَقُولُ: لَنْ تَلْعَبَ الْيَوْمَ."
 },
 {
  "i": 95,
  "start": 220.52,
  "end": 222.9,
  "text": "وَأَنْتَ تَقُولُ: أَنَا بِخَيْرٍ يَا أُمِّي."
 },
 {
  "i": 96,
  "start": 223.38,
  "end": 224.84,
  "text": "أَنَا لَا أَشْعُرُ بِشَيْءٍ."
 },
 {
  "i": 97,
  "start": 224.84,
  "end": 229.82,
  "text": "فَتَنْظُرُ إِلَيْكَ وَتَقُولُ الْجُمْلَةَ الَّتِي سَتَتَذَكَّرُهَا طَوِيلًا: وَهَذِهِ هِيَ الْمُشْكِلَةُ."
 },
 {
  "i": 98,
  "start": 230.16,
  "end": 231.22,
  "text": "لَكِنَّكَ تَذْهَبُ."
 },
 {
  "i": 99,
  "start": 231.6,
  "end": 233.1,
  "text": "تَعِدُهَا أَنْ تُرَاقِبَ نَفْسَكَ..."
 },
 {
  "i": 100,
  "start": 233.5,
  "end": 234.3,
  "text": "وَتَلْعَبُ."
 },
 {
  "i": 101,
  "start": 234.58,
  "end": 235.68,
  "text": "الشَّوْطُ الْأَوَّلُ جَيِّدٌ."
 },
 {
  "i": 102,
  "start": 236.08,
  "end": 237.06,
  "text": "تُسَجِّلُ هَدَفًا."
 },
 {
  "i": 103,
  "start": 237.62,
  "end": 239.44,
  "text": "الْمُدَرَّجَاتُ تَهْتِفُ بِاسْمِكَ."
 },
 {
  "i": 104,
  "start": 239.44,
  "end": 241.36,
  "text": "لَكِنَّ الْعَرَقَ بَارِدٌ عَلَى جَبِينِكَ."
 },
 {
  "i": 105,
  "start": 241.76,
  "end": 244.2,
  "text": "وَالْمَلْعَبُ يَمِيلُ قَلِيلًا كُلَّمَا رَكَضْتَ."
 },
 {
  "i": 106,
  "start": 244.2,
  "end": 248.08,
  "text": "فِي الِاسْتِرَاحَةِ يَنْظُرُ إِلَيْكَ طَارِقٌ وَيَقُولُ: وَجْهُكَ أَصْفَرُ يَا يَزَنُ."
 },
 {
  "i": 107,
  "start": 248.42,
  "end": 249.24,
  "text": "أَصْفَرُ جِدًّا."
 },
 {
  "i": 108,
  "start": 249.64,
  "end": 252.24,
  "text": "وَالْمُدَرِّبُ يَنْظُرُ إِلَى لَوْحَةِ النَّتِيجَةِ..."
 },
 {
  "i": 109,
  "start": 252.24,
  "end": 253.36,
  "text": "ثُمَّ إِلَيْكَ."
 },
 {
  "i": 110,
  "start": 253.36,
  "end": 255.38,
  "text": "هَدَفٌ وَاحِدٌ يَفْصِلُكُمْ عَنِ الْكَأْسِ."
 },
 {
  "i": 111,
  "start": 255.38,
  "end": 258.16,
  "text": "وَتَرَى فِي عَيْنَيْهِ أَنَّهُ يُرِيدُكَ فِي الْمَلْعَبِ."
 },
 {
  "i": 112,
  "start": 258.62,
  "end": 259.46,
  "text": "وَهُنَا تَفْهَمُ."
 },
 {
  "i": 113,
  "start": 259.98,
  "end": 261.04,
  "text": "أَمَامَكَ طَرِيقَانِ."
 },
 {
  "i": 114,
  "start": 261.56,
  "end": 263.42,
  "text": "إِمَّا أَنْ تَسْمَعَ الصَّمْتَ فِي دَاخِلِكَ..."
 },
 {
  "i": 115,
  "start": 263.42,
  "end": 265.76,
  "text": "وَتُكْمِلَ لِأَنَّكَ لَا تَشْعُرُ بِشَيْءٍ."
 },
 {
  "i": 116,
  "start": 265.94,
  "end": 269.46,
  "text": "وَإِمَّا أَنْ تَسْمَعَ مَا يَقُولُهُ جِسْمُكَ بِلُغَةٍ أُخْرَى."
 },
 {
  "i": 117,
  "start": 269.78,
  "end": 270.62,
  "text": "الْحَرَارَةُ."
 },
 {
  "i": 118,
  "start": 270.7,
  "end": 271.62,
  "text": "الْعَرَقُ الْبَارِدُ."
 },
 {
  "i": 119,
  "start": 272.08,
  "end": 272.6,
  "text": "الدُّوَارُ."
 },
 {
  "i": 120,
  "start": 272.6,
  "end": 274.62,
  "text": "وَوَجْهُ صَدِيقِكَ الْخَائِفُ."
 },
 {
  "i": 121,
  "start": 274.88,
  "end": 275.64,
  "text": "تَرْفَعُ يَدَكَ."
 },
 {
  "i": 122,
  "start": 276.02,
  "end": 277.12,
  "text": "وَتَطْلُبُ التَّبْدِيلَ."
 },
 {
  "i": 123,
  "start": 277.34,
  "end": 279.14,
  "text": "لِأَوَّلِ مَرَّةٍ فِي حَيَاتِكَ..."
 },
 {
  "i": 124,
  "start": 279.14,
  "end": 281.82,
  "text": "يَخْرُجُ الرَّجُلُ الْحَدِيدِيُّ مِنَ الْمَلْعَبِ."
 },
 {
  "i": 125,
  "start": 281.82,
  "end": 284.34,
  "text": "بَعْدَ سَاعَةٍ أَنْتَ فِي غُرْفَةِ الْعَمَلِيَّاتِ."
 },
 {
  "i": 126,
  "start": 284.34,
  "end": 286.1,
  "text": "الزَّائِدَةُ الدُّودِيَّةُ مُلْتَهِبَةٌ."
 },
 {
  "i": 127,
  "start": 286.46,
  "end": 290.0,
  "text": "وَالْجَرَّاحُ يَقُولُ لِأُمِّكَ: لَوْ تَأَخَّرَ قَلِيلًا لَانْفَجَرَتْ."
 },
 {
  "i": 128,
  "start": 290.0,
  "end": 293.5,
  "text": "أَيُّ إِنْسَانٍ آخَرَ كَانَ سَيَصْرُخُ مِنَ الْأَلَمِ مُنْذُ الْأَمْسِ."
 },
 {
  "i": 129,
  "start": 293.52,
  "end": 294.56,
  "text": "أَمَّا ابْنُكِ..."
 },
 {
  "i": 130,
  "start": 294.56,
  "end": 296.28,
  "text": "فَأَنْقَذَهُ أَنَّهُ أَصْغَى."
 },
 {
  "i": 131,
  "start": 296.28,
  "end": 299.12,
  "text": "حِينَ تَفْتَحُ عَيْنَيْكَ تَجِدُهَا بِجَانِبِ السَّرِيرِ."
 },
 {
  "i": 132,
  "start": 299.12,
  "end": 300.44,
  "text": "لَا تَصْرُخُ هَذِهِ الْمَرَّةَ."
 },
 {
  "i": 133,
  "start": 301.0,
  "end": 306.76,
  "text": "تُمْسِكُ يَدَكَ وَتَسْأَلُ: كَيْفَ عَرَفْتَ يَا يَزَنُ؟ فَتُجِيبُهَا: لَمْ أَسْمَعِ الْأَلَمَ يَا أُمِّي..."
 },
 {
  "i": 134,
  "start": 306.76,
  "end": 307.94,
  "text": "سَمِعْتُ طَارِقًا."
 },
 {
  "i": 135,
  "start": 308.48,
  "end": 309.24,
  "text": "وَسَمِعْتُكِ."
 },
 {
  "i": 136,
  "start": 309.56,
  "end": 312.62,
  "text": "فِي الْمَسَاءِ يَدْخُلُ طَارِقٌ وَبَقِيَّةُ الْفَرِيقِ إِلَى غُرْفَتِكَ."
 },
 {
  "i": 137,
  "start": 312.62,
  "end": 314.52,
  "text": "لَقَدْ فَازُوا بِالنِّهَائِيِّ."
 },
 {
  "i": 138,
  "start": 314.52,
  "end": 316.54,
  "text": "وَيَضَعُونَ الْمِيدَالِيَةَ عَلَى صَدْرِكَ."
 },
 {
  "i": 139,
  "start": 316.54,
  "end": 320.76,
  "text": "يَقُولُ الْمُدَرِّبُ: أَشْجَعُ شَيْءٍ فَعَلْتَهُ هَذَا الْمَوْسِمَ لَمْ يَكُنِ الْهَدَفَ."
 },
 {
  "i": 140,
  "start": 321.04,
  "end": 322.4,
  "text": "كَانَ أَنْ تَخْرُجَ."
 },
 {
  "i": 141,
  "start": 322.4,
  "end": 325.1,
  "text": "وَفِي تِلْكَ اللَّيْلَةِ تَطْلُبُ مِنْ أُمِّكَ الْوَرَقَةَ الْقَدِيمَةَ."
 },
 {
  "i": 142,
  "start": 325.6,
  "end": 326.46,
  "text": "وَلِأَوَّلِ مَرَّةٍ..."
 },
 {
  "i": 143,
  "start": 326.7,
  "end": 328.26,
  "text": "تَفْحَصُ نَفْسَكَ بِنَفْسِكَ."
 },
 {
  "i": 144,
  "start": 328.58,
  "end": 329.32,
  "text": "الْقَدَمَانِ."
 },
 {
  "i": 145,
  "start": 329.32,
  "end": 331.06,
  "text": "الرُّكْبَتَانِ."
 },
 {
  "i": 146,
  "start": 331.06,
  "end": 331.74,
  "text": "الْحَرَارَةُ."
 },
 {
  "i": 147,
  "start": 331.74,
  "end": 334.0,
  "text": "ثُمَّ تُخْبِرُهَا بِكُلِّ شَيْءٍ."
 },
 {
  "i": 148,
  "start": 334.0,
  "end": 335.52,
  "text": "أَنْتَ لَا تَمْلِكُ جَرَسَ إِنْذَارٍ..."
 },
 {
  "i": 149,
  "start": 335.92,
  "end": 337.08,
  "text": "فَصِرْتَ أَنْتَ الْجَرَسَ."
 },
 {
  "i": 150,
  "start": 337.6,
  "end": 338.92,
  "text": "لَمْ تَشْعُرْ بِالْأَلَمِ يَوْمًا."
 },
 {
  "i": 151,
  "start": 339.4,
  "end": 342.62,
  "text": "لَكِنَّكَ تَعَلَّمْتَ أَخِيرًا أَنْ تَسْمَعَ مَا كَانَ يُرِيدُ أَنْ يَقُولَهُ."
 },
 {
  "i": 152,
  "start": 343.04,
  "end": 350.52,
  "text": "فَمَا الْحَقِيقِيُّ فِي هَذِهِ الْقِصَّةِ؟ عَدَمُ الْإِحْسَاسِ بِالْأَلَمِ حَالَةٌ حَقِيقِيَّةٌ، لَكِنَّهَا نَادِرَةٌ جِدًّا، وَيُولَدُ بِهَا الْإِنْسَانُ."
 },
 {
  "i": 153,
  "start": 351.0,
  "end": 357.48,
  "text": "وَمِنْ أَشْهَرِ أَسْبَابِهَا خَلَلٌ فِي جِينٍ وَاحِدٍ يَصْنَعُ بَوَّابَةً صَغِيرَةً فِي أَعْصَابِ الْأَلَمِ، تَنْقُلُ الْإِشَارَةَ إِلَى الدِّمَاغِ."
 },
 {
  "i": 154,
  "start": 357.78,
  "end": 359.28,
  "text": "حِينَ تَتَعَطَّلُ الْبَوَّابَةُ..."
 },
 {
  "i": 155,
  "start": 359.76,
  "end": 360.94,
  "text": "لَا تَصِلُ الرِّسَالَةُ."
 },
 {
  "i": 156,
  "start": 361.32,
  "end": 364.62,
  "text": "وَفِي الْجِسْمِ السَّلِيمِ تَعْمَلُ هَذِهِ الرِّسَالَةُ بِسُرْعَةٍ مُدْهِشَةٍ."
 },
 {
  "i": 157,
  "start": 364.74,
  "end": 371.5,
  "text": "حِينَ تَلْمِسُ شَيْئًا حَارًّا تَسْحَبُ يَدَكَ قَبْلَ أَنْ تُفَكِّرَ، لِأَنَّ الْحَبْلَ الشَّوْكِيَّ يُصْدِرُ الْأَمْرَ قَبْلَ أَنْ يَصِلَ الْخَبَرُ إِلَى الدِّمَاغِ."
 },
 {
  "i": 158,
  "start": 371.86,
  "end": 376.22,
  "text": "وَفِي عَامِ أَلْفَيْنِ وَسِتَّةٍ نَشَرَ الْعُلَمَاءُ دِرَاسَةً عَنْ عَائِلَاتٍ فِي شَمَالِ بَاكِسْتَانَ."
 },
 {
  "i": 159,
  "start": 376.72,
  "end": 382.98,
  "text": "بَدَأَتِ الْقِصَّةُ بِصَبِيٍّ كَانَ يُقَدِّمُ عُرُوضًا فِي الشَّارِعِ: يَمْشِي عَلَى الْجَمْرِ، وَيَغْرِسُ السَّكَاكِينَ فِي ذِرَاعَيْهِ..."
 },
 {
  "i": 160,
  "start": 382.98,
  "end": 383.92,
  "text": "وَلَا يَتَأَلَّمُ."
 },
 {
  "i": 161,
  "start": 383.92,
  "end": 388.48,
  "text": "وَمَاتَ قَبْلَ أَنْ يُكْمِلَ الرَّابِعَةَ عَشْرَةَ، بَعْدَ أَنْ قَفَزَ مِنْ فَوْقِ سَطْحِ بَيْتٍ."
 },
 {
  "i": 162,
  "start": 388.86,
  "end": 391.12,
  "text": "وَمَا تَعِيشُهُ أُمُّ يَزَنَ حَقِيقِيٌّ أَيْضًا."
 },
 {
  "i": 163,
  "start": 391.6,
  "end": 400.28,
  "text": "فَالْأَطْفَالُ الْمُصَابُونَ كَثِيرًا مَا يَعَضُّونَ أَلْسِنَتَهُمْ وَشِفَاهَهُمْ، وَتُصَابُ عِظَامُهُمْ بِكُسُورٍ لَا يُلَاحِظُهَا أَحَدٌ، وَتَتَضَرَّرُ مَفَاصِلُهُمْ وَعُيُونُهُمْ."
 },
 {
  "i": 164,
  "start": 400.28,
  "end": 403.04,
  "text": "لِذَلِكَ تَتَعَلَّمُ الْعَائِلَاتُ فَحْصَ الْجِسْمِ بِانْتِظَامٍ."
 },
 {
  "i": 165,
  "start": 403.36,
  "end": 409.38,
  "text": "وَكَثِيرٌ مِنْهُمْ لَا يَشُمُّونَ الرَّوَائِحَ أَيْضًا، لِأَنَّ الْبَوَّابَةَ نَفْسَهَا تَعْمَلُ فِي أَعْصَابِ الشَّمِّ."
 },
 {
  "i": 166,
  "start": 409.82,
  "end": 415.38,
  "text": "وَفِي عَامِ أَلْفَيْنِ وَتِسْعَةَ عَشَرَ وَصَفَ الْعُلَمَاءُ حَالَةَ امْرَأَةٍ إِسْكُتْلَنْدِيَّةٍ اسْمُهَا جُو كَامِيرُونَ."
 },
 {
  "i": 167,
  "start": 415.38,
  "end": 421.02,
  "text": "اكْتَشَفَتْ فِي السِّتِّينِيَّاتِ مِنْ عُمُرِهَا أَنَّهَا لَا تَحْتَاجُ إِلَى مُسَكِّنَاتٍ بَعْدَ عَمَلِيَّةٍ جِرَاحِيَّةٍ فِي يَدِهَا."
 },
 {
  "i": 168,
  "start": 421.38,
  "end": 423.94,
  "text": "وَتَبَيَّنَ أَنَّ عِنْدَهَا تَغَيُّرًا جِينِيًّا نَادِرًا..."
 },
 {
  "i": 169,
  "start": 424.5,
  "end": 426.72,
  "text": "وَأَنَّهَا نَادِرًا مَا تَشْعُرُ بِالْقَلَقِ أَيْضًا."
 },
 {
  "i": 170,
  "start": 427.24,
  "end": 439.1,
  "text": "وَهُنَا سُؤَالٌ مَا زَالَ مَفْتُوحًا: هَلْ يُمْكِنُ أَنْ نَصْنَعَ مِنْ هَذِهِ الْجِينَاتِ مُسَكِّنَاتٍ جَدِيدَةً لِمَلَايِينِ الْمَرْضَى الَّذِينَ يَعِيشُونَ مَعَ أَلَمٍ مُزْمِنٍ؟ بَعْضُ الْأَدْوِيَةِ الَّتِي جُرِّبَتْ حَتَّى الْآنَ لَمْ تَنْجَحْ كَمَا كَانَ مُتَوَقَّعًا..."
 },
 {
  "i": 171,
  "start": 439.64,
  "end": 441.34,
  "text": "وَالْبَحْثُ مُسْتَمِرٌّ."
 },
 {
  "i": 172,
  "start": 441.34,
  "end": 442.5,
  "text": "فَالْأَلَمُ الَّذِي نَكْرَهُهُ..."
 },
 {
  "i": 173,
  "start": 442.5,
  "end": 445.5,
  "text": "هُوَ نَفْسُهُ الْحَارِسُ الَّذِي يُبْقِينَا أَحْيَاءً."
 },
 {
  "i": 174,
  "start": 445.5,
  "end": 453.56,
