[
 {
  "i": 0,
  "start": 0.0,
  "end": 1.86,
  "text": "السَّاعَةُ الثَّالِثَةُ فَجْرًا."
 },
 {
  "i": 1,
  "start": 1.86,
  "end": 3.0,
  "text": "الْبَيْتُ صَامِتٌ..."
 },
 {
  "i": 2,
  "start": 3.06,
  "end": 3.8,
  "text": "إِلَّا عِنْدَكَ."
 },
 {
  "i": 3,
  "start": 4.16,
  "end": 6.22,
  "text": "تَسْمَعُ قَلْبَ جَارِكَ يَدُقُّ خَلْفَ الْجِدَارِ."
 },
 {
  "i": 4,
  "start": 6.58,
  "end": 8.86,
  "text": "تَسْمَعُ نَمْلَةً تَمْشِي عَلَى زُجَاجِ النَّافِذَةِ."
 },
 {
  "i": 5,
  "start": 9.18,
  "end": 12.62,
  "text": "وَالثَّلَّاجَةُ فِي الْمَطْبَخِ تَهْدِرُ كَأَنَّهَا قِطَارٌ يَمُرُّ فِي غُرْفَتِكَ."
 },
 {
  "i": 6,
  "start": 12.94,
  "end": 14.08,
  "text": "ثُمَّ تَسْمَعُ أُمَّكَ."
 },
 {
  "i": 7,
  "start": 14.08,
  "end": 18.0,
  "text": "هِيَ فِي الطَّابِقِ الْأَرْضِيِّ، تَتَكَلَّمُ فِي الْهَاتِفِ بِصَوْتٍ خَافِتٍ جِدًّا..."
 },
 {
  "i": 8,
  "start": 18.34,
  "end": 19.94,
  "text": "حَتَّى لَا يَسْمَعَهَا أَحَدٌ."
 },
 {
  "i": 9,
  "start": 20.6,
  "end": 22.16,
  "text": "وَأَنْتَ تَسْمَعُ كُلَّ كَلِمَةٍ."
 },
 {
  "i": 10,
  "start": 22.38,
  "end": 26.38,
  "text": "فِي الصَّبَاحِ تَعْرِفُ أَنَّ الْحَافِلَةَ سَتَتَأَخَّرُ قَبْلَ أَنْ تَخْرُجَ مِنَ الْبَيْتِ."
 },
 {
  "i": 11,
  "start": 26.38,
  "end": 28.34,
  "text": "تَسْمَعُ مُحَرِّكَهَا عَالِقًا فِي الزِّحَامِ..."
 },
 {
  "i": 12,
  "start": 28.54,
  "end": 30.56,
  "text": "عَلَى بُعْدِ ثَلَاثَةِ كِيلُومِتْرَاتٍ."
 },
 {
  "i": 13,
  "start": 30.86,
  "end": 33.68,
  "text": "سَمْعُكَ أَقْوَى مِنْ سَمْعِ أَيِّ إِنْسَانٍ بِمِلْيُونِ مَرَّةٍ."
 },
 {
  "i": 14,
  "start": 33.96,
  "end": 36.06,
  "text": "تَسْمَعُ كُلَّ سِرٍّ فِي الْمَدِينَةِ."
 },
 {
  "i": 15,
  "start": 36.06,
  "end": 36.86,
  "text": "كُلَّ هَمْسَةٍ."
 },
 {
  "i": 16,
  "start": 37.18,
  "end": 37.9,
  "text": "كُلَّ كِذْبَةٍ."
 },
 {
  "i": 17,
  "start": 38.3,
  "end": 39.48,
  "text": "إِلَّا شَيْئًا وَاحِدًا."
 },
 {
  "i": 18,
  "start": 40.02,
  "end": 41.44,
  "text": "الصَّوْتَ الَّذِي يُكَلِّمُكَ أَنْتَ."
 },
 {
  "i": 19,
  "start": 41.44,
  "end": 44.5,
  "text": "لِأَنَّ لِهَذِهِ الْقُوَّةِ قَاعِدَةً وَاحِدَةً."
 },
 {
  "i": 20,
  "start": 44.5,
  "end": 45.46,
  "text": "الْأُذُنُ تَسْمَعُ..."
 },
 {
  "i": 21,
  "start": 45.88,
  "end": 48.1,
  "text": "لَكِنَّ الدِّمَاغَ هُوَ الَّذِي يُنْصِتُ."
 },
 {
  "i": 22,
  "start": 48.1,
  "end": 50.3,
  "text": "وَحِينَ يَصِلُ إِلَيْهِ كُلُّ صَوْتٍ فِي الْعَالَمِ..."
 },
 {
  "i": 23,
  "start": 50.68,
  "end": 51.96,
  "text": "يَضِيعُ الصَّوْتُ الْأَقْرَبُ."
 },
 {
  "i": 24,
  "start": 52.4,
  "end": 53.16,
  "text": "اسْمُكَ عُمَرُ."
 },
 {
  "i": 25,
  "start": 53.7,
  "end": 54.78,
  "text": "سَبْعَةَ عَشَرَ عَامًا."
 },
 {
  "i": 26,
  "start": 55.22,
  "end": 58.8,
  "text": "وَسَتَتَعَلَّمُ يَوْمًا أَنَّ أَصْعَبَ شَيْءٍ لَيْسَ أَنْ تَسْمَعَ كُلَّ شَيْءٍ..."
 },
 {
  "i": 27,
  "start": 58.8,
  "end": 60.36,
  "text": "بَلْ أَنْ تَخْتَارَ مَا تَسْمَعُهُ."
 },
 {
  "i": 28,
  "start": 60.36,
  "end": 64.96,
  "text": "فَمَاذَا لَوْ كَانَ سَمْعُكَ أَقْوَى بِمِلْيُونِ مَرَّةٍ؟ فِي الْبِدَايَةِ تَبْدُو الْحَيَاةُ لُعْبَةً."
 },
 {
  "i": 29,
  "start": 65.48,
  "end": 68.02,
  "text": "فِي الْحَفْلَةِ الْمُوسِيقِيَّةِ تَسْمَعُ كُلَّ آلَةٍ وَحْدَهَا."
 },
 {
  "i": 30,
  "start": 68.24,
  "end": 73.08,
  "text": "تَعْرِفُ أَنَّ عَازِفَ الْكَمَانِ الثَّالِثَ مُتَوَتِّرٌ، لِأَنَّكَ تَسْمَعُ أَنْفَاسَهُ بَيْنَ النَّغَمَاتِ."
 },
 {
  "i": 31,
  "start": 73.48,
  "end": 77.12,
  "text": "وَتَعْرِفُ أَنَّ سَيَّارَةَ أَبِيكَ سَتَتَعَطَّلُ قَبْلَ أُسْبُوعٍ مِنْ تَعَطُّلِهَا."
 },
 {
  "i": 32,
  "start": 77.48,
  "end": 78.98,
  "text": "فِي الْمُحَرِّكِ صَوْتٌ صَغِيرٌ..."
 },
 {
  "i": 33,
  "start": 79.3,
  "end": 81.1,
  "text": "لَا يَسْمَعُهُ الْمِيكَانِيكِيُّ نَفْسُهُ."
 },
 {
  "i": 34,
  "start": 81.1,
  "end": 84.2,
  "text": "وَفِي الصَّفِّ لَا يَسْتَطِيعُ أَحَدٌ أَنْ يَكْذِبَ عَلَيْكَ."
 },
 {
  "i": 35,
  "start": 84.2,
  "end": 85.76,
  "text": "حِينَ يَكْذِبُ زَمِيلُكَ..."
 },
 {
  "i": 36,
  "start": 85.76,
  "end": 86.86,
  "text": "يَتَسَارَعُ قَلْبُهُ."
 },
 {
  "i": 37,
  "start": 87.28,
  "end": 88.88,
  "text": "وَأَنْتَ تَسْمَعُ ذَلِكَ بِوُضُوحٍ."
 },
 {
  "i": 38,
  "start": 89.26,
  "end": 91.46,
  "text": "وَخَلْفَ الْحَيِّ تَسْمَعُ مُوَاءً ضَعِيفًا جِدًّا..."
 },
 {
  "i": 39,
  "start": 91.82,
  "end": 95.4,
  "text": "قِطَّةً صَغِيرَةً عَالِقَةً فِي أُنْبُوبٍ تَحْتَ الْأَرْضِ مُنْذُ يَوْمَيْنِ."
 },
 {
  "i": 40,
  "start": 95.76,
  "end": 97.5,
  "text": "تَحْفِرُ بِيَدَيْكَ سَاعَةً كَامِلَةً..."
 },
 {
  "i": 41,
  "start": 97.5,
  "end": 99.16,
  "text": "وَتُخْرِجُهَا."
 },
 {
  "i": 42,
  "start": 99.16,
  "end": 100.5,
  "text": "تُسَمِّيهَا هَمْسَةَ."
 },
 {
  "i": 43,
  "start": 100.7,
  "end": 102.12,
  "text": "وَتَصِيرُ قِطَّتَكَ."
 },
 {
  "i": 44,
  "start": 102.12,
  "end": 105.26,
  "text": "لَكِنَّ اللَّيْلَةَ الَّتِي غَيَّرَتْ كُلَّ شَيْءٍ كَانَتْ لَيْلَةَ الْغَازِ."
 },
 {
  "i": 45,
  "start": 105.86,
  "end": 108.02,
  "text": "كُنْتَ عَائِدًا إِلَى الْبَيْتِ حِينَ سَمِعْتَهُ."
 },
 {
  "i": 46,
  "start": 108.1,
  "end": 109.16,
  "text": "فَحِيحٌ رَفِيعٌ..."
 },
 {
  "i": 47,
  "start": 109.16,
  "end": 112.84,
  "text": "يَخْرُجُ مِنْ أُنْبُوبٍ مَكْسُورٍ فِي الطَّابِقِ الْخَامِسِ."
 },
 {
  "i": 48,
  "start": 113.36,
  "end": 114.52,
  "text": "الْجَمِيعُ نَائِمُونَ."
 },
 {
  "i": 49,
  "start": 114.94,
  "end": 115.8,
  "text": "تَطْرُقُ الْأَبْوَابَ."
 },
 {
  "i": 50,
  "start": 116.24,
  "end": 116.7,
  "text": "تَصْرُخُ."
 },
 {
  "i": 51,
  "start": 117.2,
  "end": 119.6,
  "text": "وَيَنْزِلُ السُّكَّانُ إِلَى الشَّارِعِ بِمَلَابِسِ النَّوْمِ..."
 },
 {
  "i": 52,
  "start": 120.12,
  "end": 120.74,
  "text": "غَاضِبِينَ."
 },
 {
  "i": 53,
  "start": 121.18,
  "end": 123.1,
  "text": "ثُمَّ يَصِلُ رِجَالُ الطَّوَارِئِ."
 },
 {
  "i": 54,
  "start": 123.1,
  "end": 125.48,
  "text": "وَيَجِدُونَ التَّسَرُّبَ تَمَامًا حَيْثُ قُلْتَ."
 },
 {
  "i": 55,
  "start": 125.48,
  "end": 128.8,
  "text": "فِي الصَّبَاحِ تَكْتُبُ الصُّحُفُ عَنِ الْفَتَى الَّذِي أَنْقَذَ عِمَارَةً كَامِلَةً."
 },
 {
  "i": 56,
  "start": 129.2,
  "end": 131.36,
  "text": "وَيُسَمِّيكَ أَصْدِقَاؤُكَ: الرَّادَارَ."
 },
 {
  "i": 57,
  "start": 131.8,
  "end": 134.24,
  "text": "لَكِنَّ الرَّادَارَ لَا يَعْرِفُ كَيْفَ يُطْفِئُ نَفْسَهُ."
 },
 {
  "i": 58,
  "start": 134.66,
  "end": 136.98,
  "text": "الْمَدِينَةُ عِنْدَكَ لَا تَنَامُ أَبَدًا."
 },
 {
  "i": 59,
  "start": 136.98,
  "end": 138.34,
  "text": "أَبْوَاقُ السَّيَّارَاتِ."
 },
 {
  "i": 60,
  "start": 138.34,
  "end": 139.96,
  "text": "أَجْهِزَةُ التَّكْيِيفِ."
 },
 {
  "i": 61,
  "start": 139.96,
  "end": 141.36,
  "text": "شَخِيرُ عِمَارَةٍ كَامِلَةٍ."
 },
 {
  "i": 62,
  "start": 141.84,
  "end": 145.76,
  "text": "صِرْتَ تَنَامُ وَعَلَى أُذُنَيْكَ سَمَّاعَتَانِ كَبِيرَتَانِ تَعْزِلَانِ الصَّوْتَ..."
 },
 {
  "i": 63,
  "start": 145.76,
  "end": 146.98,
  "text": "وَمَعَ ذَلِكَ تَسْمَعُ."
 },
 {
  "i": 64,
  "start": 147.38,
  "end": 150.86,
  "text": "وَفِي الِامْتِحَانِ تَسْمَعُ أَقْلَامَ ثَلَاثِينَ طَالِبًا تَكْتُبُ فِي وَقْتٍ وَاحِدٍ..."
 },
 {
  "i": 65,
  "start": 151.32,
  "end": 153.52,
  "text": "فَلَا تَسْتَطِيعُ أَنْ تَقْرَأَ سُؤَالًا وَاحِدًا."
 },
 {
  "i": 66,
  "start": 154.04,
  "end": 156.44,
  "text": "وَدَرَجَاتُكَ تَهْبِطُ شَهْرًا بَعْدَ شَهْرٍ."
 },
 {
  "i": 67,
  "start": 156.44,
  "end": 158.38,
  "text": "يَأْخُذُكَ أَبُوكَ إِلَى طَبِيبِ الْأُذُنِ."
 },
 {
  "i": 68,
  "start": 158.84,
  "end": 163.1,
  "text": "يَفْحَصُكَ طَوِيلًا، ثُمَّ يَقُولُ: أُذُنَاكَ سَلِيمَتَانِ تَمَامًا."
 },
 {
  "i": 69,
  "start": 163.1,
  "end": 165.08,
  "text": "الْمُشْكِلَةُ لَيْسَتْ فِي مَا تَسْمَعُهُ..."
 },
 {
  "i": 70,
  "start": 165.08,
  "end": 167.48,
  "text": "بَلْ فِي أَنَّ دِمَاغَكَ لَا يَعْرِفُ مَاذَا يَتْرُكُ."
 },
 {
  "i": 71,
  "start": 167.96,
  "end": 170.28,
  "text": "وَالْأَسْرَارُ لَيْسَتْ مُمْتِعَةً كَمَا كُنْتَ تَظُنُّ."
 },
 {
  "i": 72,
  "start": 170.68,
  "end": 174.04,
  "text": "تَسْمَعُ أَصْدِقَاءَكَ فِي الْمَقْهَى يَضْحَكُونَ عَلَيْكَ بَعْدَ أَنْ تَخْرُجَ."
 },
 {
  "i": 73,
  "start": 174.04,
  "end": 177.34,
  "text": "وَتَسْمَعُ أُمَّكَ تَبْكِي لَيْلًا مِنْ دُيُونٍ لَا تُرِيدُ أَنْ تُخْبِرَكَ بِهَا."
 },
 {
  "i": 74,
  "start": 177.34,
  "end": 179.82,
  "text": "صِرْتَ تَعْرِفُ كُلَّ شَيْءٍ عَنِ النَّاسِ..."
 },
 {
  "i": 75,
  "start": 180.12,
  "end": 182.54,
  "text": "وَلَا تَسْتَطِيعُ أَنْ تَقُولَ لَهُمْ إِنَّكَ تَعْرِفُ."
 },
 {
  "i": 76,
  "start": 182.98,
  "end": 184.5,
  "text": "لَكِنَّ أَصْعَبَ مَا فِي الْأَمْرِ..."
 },
 {
  "i": 77,
  "start": 184.92,
  "end": 185.7,
  "text": "جَدُّكَ يُوسُفُ."
 },
 {
  "i": 78,
  "start": 186.14,
  "end": 188.34,
  "text": "جَدُّكَ يَتَكَلَّمُ بِصَوْتٍ هَادِئٍ مُنْخَفِضٍ."
 },
 {
  "i": 79,
  "start": 188.58,
  "end": 191.58,
  "text": "وَكُلَّ مَسَاءٍ يَجْلِسُ بِجَانِبِكَ لِيَحْكِيَ لَكَ حِكَايَةً."
 },
 {
  "i": 80,
  "start": 191.58,
  "end": 196.72,
  "text": "حِكَايَاتٌ عَنِ الْبَحْرِ، وَعَنْ أَبِيهِ الصَّيَّادِ، وَعَنِ الْيَوْمِ الَّذِي وُلِدْتَ فِيهِ."
 },
 {
  "i": 81,
  "start": 196.72,
  "end": 198.8,
  "text": "وَأَنْتَ تَسْمَعُ كُلَّ شَيْءٍ إِلَّا صَوْتَهُ."
 },
 {
  "i": 82,
  "start": 199.14,
  "end": 204.94,
  "text": "يَضِيعُ بَيْنَ دَقَّاتِ سَاعَةِ الْجِدَارِ، وَصَوْتِ التِّلْفَازِ عِنْدَ الْجِيرَانِ، وَبُكَاءِ طِفْلٍ فِي الشَّارِعِ الْمُجَاوِرِ."
 },
 {
  "i": 83,
  "start": 205.32,
  "end": 208.68,
  "text": "فَتَقُولُ لَهُ: مَاذَا يَا جَدِّي؟ وَيُعِيدُ."
 },
 {
  "i": 84,
  "start": 208.68,
  "end": 211.38,
  "text": "ثُمَّ تَقُولُ: مَاذَا؟ فَيَبْتَسِمُ..."
 },
 {
  "i": 85,
  "start": 211.94,
  "end": 212.52,
  "text": "وَيَسْكُتُ."
 },
 {
  "i": 86,
  "start": 212.96,
  "end": 216.28,
  "text": "وَالْغَرِيبُ أَنَّ جَدَّكَ نَفْسَهُ يَضَعُ سَمَّاعَةً طِبِّيَّةً فِي أُذُنِهِ."
 },
 {
  "i": 87,
  "start": 216.62,
  "end": 217.8,
  "text": "هُوَ لَا يَسْمَعُ جَيِّدًا..."
 },
 {
  "i": 88,
  "start": 218.26,
  "end": 220.12,
  "text": "وَأَنْتَ تَسْمَعُ أَكْثَرَ مِنَ اللَّازِمِ."
 },
 {
  "i": 89,
  "start": 220.48,
  "end": 221.28,
  "text": "وَمَعَ ذَلِكَ..."
 },
 {
  "i": 90,
  "start": 221.28,
  "end": 223.46,
  "text": "هُوَ الَّذِي يَفْهَمُكَ دَائِمًا."
 },
 {
  "i": 91,
  "start": 223.46,
  "end": 225.02,
  "text": "ثُمَّ يَأْتِي ذَلِكَ الْمَسَاءُ."
 },
 {
  "i": 92,
  "start": 225.36,
  "end": 227.64,
  "text": "جَدُّكَ يُمْسِكُ صَدْرَهُ وَيَجْلِسُ عَلَى الْأَرْضِ."
 },
 {
  "i": 93,
  "start": 228.04,
  "end": 229.22,
  "text": "وَأَنْتَ تَسْمَعُ قَلْبَهُ."
 },
 {
  "i": 94,
  "start": 229.52,
  "end": 230.5,
  "text": "يَدُقُّ بِسُرْعَةٍ..."
 },
 {
  "i": 95,
  "start": 230.92,
  "end": 232.06,
  "text": "ثُمَّ يَبْطُؤُ..."
 },
 {
  "i": 96,
  "start": 232.06,
  "end": 232.94,
  "text": "ثُمَّ يَتَعَثَّرُ."
 },
 {
  "i": 97,
  "start": 233.54,
  "end": 235.56,
  "text": "سَيَّارَةُ الْإِسْعَافِ تَصِلُ بَعْدَ دَقَائِقَ."
 },
 {
  "i": 98,
  "start": 235.86,
  "end": 237.56,
  "text": "وَفِي الْمُسْتَشْفَى يَبْدَأُ الْجَحِيمُ."
 },
 {
  "i": 99,
  "start": 238.08,
  "end": 240.14,
  "text": "مِئَاتُ الْأَجْهِزَةِ تُصْدِرُ أَصْوَاتَهَا."
 },
 {
  "i": 100,
  "start": 240.14,
  "end": 241.96,
  "text": "مِئَاتُ الْقُلُوبِ تَدُقُّ فِي الْغُرَفِ."
 },
 {
  "i": 101,
  "start": 242.5,
  "end": 243.66,
  "text": "أَطِبَّاءُ يَرْكُضُونَ."
 },
 {
  "i": 102,
  "start": 244.14,
  "end": 245.46,
  "text": "أَبْوَابٌ تُفْتَحُ وَتُغْلَقُ."
 },
 {
  "i": 103,
  "start": 245.46,
  "end": 247.56,
  "text": "وَصُرَاخٌ فِي قِسْمِ الطَّوَارِئِ."
 },
 {
  "i": 104,
  "start": 247.7,
  "end": 249.52,
  "text": "تَضَعُ يَدَيْكَ عَلَى أُذُنَيْكَ..."
 },
 {
  "i": 105,
  "start": 249.52,
  "end": 251.12,
  "text": "وَلَا يَتَوَقَّفُ شَيْءٌ."
 },
 {
  "i": 106,
  "start": 251.12,
  "end": 252.54,
  "text": "ثُمَّ يُسْمَحُ لَكَ بِالدُّخُولِ."
 },
 {
  "i": 107,
  "start": 253.08,
  "end": 255.38,
  "text": "جَدُّكَ عَلَى السَّرِيرِ، وَوَجْهُهُ شَاحِبٌ."
 },
 {
  "i": 108,
  "start": 255.64,
  "end": 257.06,
  "text": "يُشِيرُ إِلَيْكَ أَنْ تَقْتَرِبَ."
 },
 {
  "i": 109,
  "start": 257.56,
  "end": 259.34,
  "text": "يُحَرِّكُ شَفَتَيْهِ..."
 },
 {
  "i": 110,
  "start": 259.34,
  "end": 261.08,
  "text": "يَهْمِسُ لَكَ بِشَيْءٍ."
 },
 {
  "i": 111,
  "start": 261.08,
  "end": 262.46,
  "text": "وَأَنْتَ لَا تَسْمَعُهُ."
 },
 {
  "i": 112,
  "start": 262.6,
  "end": 264.64,
  "text": "الصَّوْتُ الْوَحِيدُ الَّذِي تُرِيدُهُ فِي الْعَالَمِ..."
 },
 {
  "i": 113,
  "start": 265.08,
  "end": 267.06,
  "text": "هُوَ الصَّوْتُ الْوَحِيدُ الَّذِي لَا تَسْمَعُهُ."
 },
 {
  "i": 114,
  "start": 267.32,
  "end": 268.24,
  "text": "وَهُنَا تَفْهَمُ."
 },
 {
  "i": 115,
  "start": 268.78,
  "end": 269.82,
  "text": "أَمَامَكَ طَرِيقَانِ."
 },
 {
  "i": 116,
  "start": 270.34,
  "end": 273.02,
  "text": "إِمَّا أَنْ تُحَاوِلَ أَنْ تَسْمَعَ كُلَّ شَيْءٍ كَمَا تَفْعَلُ دَائِمًا..."
 },
 {
  "i": 117,
  "start": 273.64,
  "end": 275.78,
  "text": "فَيَضِيعَ صَوْتُهُ كَمَا يَضِيعُ كُلَّ مَسَاءٍ."
 },
 {
  "i": 118,
  "start": 276.1,
  "end": 278.48,
  "text": "وَإِمَّا أَنْ تَفْعَلَ شَيْئًا لَمْ تَفْعَلْهُ مِنْ قَبْلُ."
 },
 {
  "i": 119,
  "start": 278.78,
  "end": 279.52,
  "text": "أَنْ تَخْتَارَ."
 },
 {
  "i": 120,
  "start": 279.96,
  "end": 281.18,
  "text": "تُغْمِضُ عَيْنَيْكَ."
 },
 {
  "i": 121,
  "start": 281.18,
  "end": 285.0,
  "text": "وَتَبْحَثُ بَيْنَ آلَافِ الْأَصْوَاتِ عَنْ صَوْتٍ وَاحِدٍ تَعْرِفُهُ مُنْذُ طُفُولَتِكَ."
 },
 {
  "i": 122,
  "start": 285.34,
  "end": 286.04,
  "text": "قَلْبُ جَدِّكَ."
 },
 {
  "i": 123,
  "start": 286.42,
  "end": 290.3,
  "text": "الْقَلْبُ الَّذِي كُنْتَ تَنَامُ عَلَيْهِ وَأَنْتَ صَغِيرٌ، وَرَأْسُكَ عَلَى صَدْرِهِ."
 },
 {
  "i": 124,
  "start": 290.3,
  "end": 290.96,
  "text": "تَجِدُهُ."
 },
 {
  "i": 125,
  "start": 291.3,
  "end": 291.68,
  "text": "دَقَّةً..."
 },
 {
  "i": 126,
  "start": 292.16,
  "end": 292.86,
  "text": "ثُمَّ دَقَّةً."
 },
 {
  "i": 127,
  "start": 293.5,
  "end": 294.22,
  "text": "وَتَتْبَعُهُ."
 },
 {
  "i": 128,
  "start": 294.44,
  "end": 295.5,
  "text": "وَشَيْئًا فَشَيْئًا..."
 },
 {
  "i": 129,
  "start": 295.74,
  "end": 297.52,
  "text": "يَبْتَعِدُ كُلُّ شَيْءٍ آخَرَ."
 },
 {
  "i": 130,
  "start": 298.18,
  "end": 298.94,
  "text": "الْأَجْهِزَةُ."
 },
 {
  "i": 131,
  "start": 299.14,
  "end": 299.66,
  "text": "الْأَبْوَابُ."
 },
 {
  "i": 132,
  "start": 300.16,
  "end": 300.78,
  "text": "الصُّرَاخُ."
 },
 {
  "i": 133,
  "start": 301.24,
  "end": 302.7,
  "text": "لِأَوَّلِ مَرَّةٍ فِي حَيَاتِكَ..."
 },
 {
  "i": 134,
  "start": 302.96,
  "end": 304.4,
  "text": "يَصِيرُ الْعَالَمُ هَادِئًا."
 },
 {
  "i": 135,
  "start": 305.0,
  "end": 305.76,
  "text": "وَتَسْمَعُهُ."
 },
 {
  "i": 136,
  "start": 306.12,
  "end": 309.5,
  "text": "يَقُولُ لَكَ: لَا تَحْتَاجُ أَنْ تَسْمَعَ كُلَّ شَيْءٍ يَا عُمَرُ..."
 },
 {
  "i": 137,
  "start": 309.5,
  "end": 310.38,
  "text": "اسْمَعْ مَنْ تُحِبُّ."
 },
 {
  "i": 138,
  "start": 310.94,
  "end": 313.36,
  "text": "بَعْدَ أُسْبُوعٍ يَعُودُ جَدُّكَ إِلَى الْبَيْتِ."
 },
 {
  "i": 139,
  "start": 313.36,
  "end": 316.38,
  "text": "وَفِي أَوَّلِ مَسَاءٍ يَجْلِسُ بِجَانِبِكَ وَيَبْدَأُ حِكَايَتَهُ."
 },
 {
  "i": 140,
  "start": 316.38,
  "end": 317.56,
  "text": "وَهَذِهِ الْمَرَّةَ..."
 },
 {
  "i": 141,
  "start": 317.94,
  "end": 324.34,
  "text": "لَا تَقُولُ: مَاذَا؟ تُغْمِضُ عَيْنَيْكَ، وَتَخْتَارُ صَوْتَهُ، وَتَسْمَعُ الْحِكَايَةَ كُلَّهَا لِأَوَّلِ مَرَّةٍ."
 },
 {
  "i": 142,
  "start": 324.82,
  "end": 329.26,
  "text": "وَفِي الْيَوْمِ التَّالِي تَذْهَبُ إِلَى أُمِّكَ وَتَقُولُ لَهَا: أَعْرِفُ عَنِ الدُّيُونِ..."
 },
 {
  "i": 143,
  "start": 329.26,
  "end": 330.38,
  "text": "وَسَنَحُلُّهَا مَعًا."
 },
 {
  "i": 144,
  "start": 330.76,
  "end": 332.72,
  "text": "وَحِينَ يَضْحَكُ أَصْدِقَاؤُكَ خَلْفَ ظَهْرِكَ..."
 },
 {
  "i": 145,
  "start": 333.1,
  "end": 334.3,
  "text": "تَخْتَارُ أَلَّا تَسْمَعَ."
 },
 {
  "i": 146,
  "start": 334.68,
  "end": 336.94,
  "text": "وَفِي اللَّيْلِ تَنَامُ هَمْسَةُ عَلَى صَدْرِكَ..."
 },
 {
  "i": 147,
  "start": 336.94,
  "end": 339.32,
  "text": "وَتَسْمَعُ قَلْبَهَا الصَّغِيرَ، وَتَبْتَسِمُ."
 },
 {
  "i": 148,
  "start": 339.8,
  "end": 342.54,
  "text": "مَا زِلْتَ تَسْمَعُ أَقْوَى مِنْ أَيِّ إِنْسَانٍ بِمِلْيُونِ مَرَّةٍ."
 },
 {
  "i": 149,
  "start": 343.06,
  "end": 345.72,
  "text": "لَكِنَّكَ تَعَلَّمْتَ أَخِيرًا أَنَّ السَّمْعَ شَيْءٌ..."
 },
 {
  "i": 150,
  "start": 345.72,
  "end": 347.06,
  "text": "وَالْإِنْصَاتَ شَيْءٌ آخَرُ."
 },
 {
  "i": 151,
  "start": 347.48,
  "end": 354.98,
  "text": "فَمَا الْحَقِيقِيُّ فِي هَذِهِ الْقِصَّةِ؟ أُذُنُ الْإِنْسَانِ تَسْمَعُ الْأَصْوَاتَ الَّتِي تَتَرَاوَحُ تَرَدُّدَاتُهَا تَقْرِيبًا بَيْنَ عِشْرِينَ وَعِشْرِينَ أَلْفَ هِرْتِزٍ."
 },
 {
  "i": 152,
  "start": 355.36,
  "end": 357.88,
  "text": "وَيَقِلُّ الْحَدُّ الْأَعْلَى مَعَ التَّقَدُّمِ فِي الْعُمُرِ."
 },
 {
  "i": 153,
  "start": 358.16,
  "end": 362.06,
  "text": "أَمَّا قُوَّةُ الصَّوْتِ فَتُقَاسُ بِالدِّيسِيبِلِ، وَهُوَ مِقْيَاسٌ غَرِيبٌ."
 },
 {
  "i": 154,
  "start": 362.26,
  "end": 365.72,
  "text": "كُلُّ عَشَرَةِ دِيسِيبِلَاتٍ زِيَادَةً تَعْنِي صَوْتًا أَقْوَى بِعَشْرِ مَرَّاتٍ."
 },
 {
  "i": 155,
  "start": 366.18,
  "end": 368.38,
  "text": "لِذَلِكَ فَالصَّوْتُ الْأَقْوَى بِمِلْيُونِ مَرَّةٍ..."
 },
 {
  "i": 156,
  "start": 368.78,
  "end": 370.58,
  "text": "يَزِيدُ سِتِّينَ دِيسِيبِلًا فَقَطْ."
 },
 {
  "i": 157,
  "start": 370.92,
  "end": 373.94,
  "text": "وَأُذُنُكَ حَسَّاسَةٌ أَصْلًا إِلَى دَرَجَةٍ مُدْهِشَةٍ."
 },
 {
  "i": 158,
  "start": 373.94,
  "end": 380.82,
  "text": "يَرَى بَعْضُ الْعُلَمَاءِ أَنَّهَا لَوْ كَانَتْ أَحَسَّ بِكَثِيرٍ، لَرُبَّمَا سَمِعْنَا حَرَكَةَ جُزَيْئَاتِ الْهَوَاءِ نَفْسِهَا كَهَسْهَسَةٍ لَا تَتَوَقَّفُ."
 },
 {
  "i": 159,
  "start": 381.16,
  "end": 390.02,
  "text": "وَفِي أَهْدَإِ الْغُرَفِ الَّتِي بَنَاهَا الْإِنْسَانُ، وَهِيَ غُرَفٌ خَاصَّةٌ تَمْتَصُّ الصَّدَى، يَقُولُ الزُّوَّارُ إِنَّهُمْ يَبْدَؤُونَ بِسَمَاعِ دَقَّاتِ قُلُوبِهِمْ وَأَصْوَاتِ أَجْسَامِهِمْ."
 },
 {
  "i": 160,
  "start": 390.02,
  "end": 399.18,
  "text": "أَمَّا أَقْوَى سَمْعٍ عُرِفَ فِي عَالَمِ الْحَيَوَانِ، فَقَدْ وَجَدَهُ الْعُلَمَاءُ عَامَ أَلْفَيْنِ وَثَلَاثَةَ عَشَرَ عِنْدَ فَرَاشَةٍ لَيْلِيَّةٍ صَغِيرَةٍ اسْمُهَا عُثَّةُ الشَّمْعِ الْكَبِيرَةُ."
 },
 {
  "i": 161,
  "start": 399.18,
  "end": 402.52,
  "text": "تَسْمَعُ تَرَدُّدَاتٍ تَصِلُ إِلَى ثَلَاثِمِئَةِ أَلْفِ هِرْتِزٍ."
 },
 {
  "i": 162,
  "start": 402.68,
  "end": 405.2,
  "text": "أَيْ أَعْلَى مِنْ حَدِّ سَمْعِكَ بِخَمْسَ عَشْرَةَ مَرَّةً."
 },
 {
  "i": 163,
  "start": 405.64,
  "end": 410.04,
  "text": "وَيُرَجِّحُ الْعُلَمَاءُ أَنَّ ذَلِكَ يُسَاعِدُهَا عَلَى سَمَاعِ الْخَفَافِيشِ الَّتِي تَصْطَادُهَا."
 },
 {
  "i": 164,
  "start": 410.04,
  "end": 412.72,
  "text": "وَمُعَانَاةُ عُمَرَ لَهَا أَصْلٌ حَقِيقِيٌّ أَيْضًا."
 },
 {
  "i": 165,
  "start": 413.16,
  "end": 421.08,
  "text": "فَهُنَاكَ حَالَةٌ اسْمُهَا فَرْطُ السَّمْعِ، تَصِيرُ فِيهَا الْأَصْوَاتُ الْعَادِيَّةُ مُزْعِجَةً أَوْ مُؤْلِمَةً لِصَاحِبِهَا، مِثْلَ صَوْتِ الْأَطْبَاقِ أَوْ حَرَكَةِ الْمُرُورِ."
 },
 {
  "i": 166,
  "start": 421.4,
  "end": 424.6,
  "text": "أَمَّا قُدْرَةُ عُمَرَ الْأَخِيرَةُ فَيَمْلِكُهَا كُلُّ إِنْسَانٍ."
 },
 {
  "i": 167,
  "start": 424.6,
  "end": 427.04,
  "text": "يُسَمِّيهَا الْعُلَمَاءُ تَأْثِيرَ حَفْلَةِ الْكُوكْتِيلِ."
 },
 {
  "i": 168,
  "start": 427.48,
  "end": 433.3,
  "text": "فِي غُرْفَةٍ مُزْدَحِمَةٍ يَتَكَلَّمُ فِيهَا الْجَمِيعُ، يَسْتَطِيعُ دِمَاغُكَ أَنْ يَخْتَارَ صَوْتًا وَاحِدًا وَيُتَابِعَهُ..."
 },
 {
  "i": 169,
  "start": 433.3,
  "end": 434.68,
  "text": "وَيُخَفِّضَ الْبَاقِي."
 },
 {
  "i": 170,
  "start": 435.1,
  "end": 438.5,
  "text": "وَإِذَا نَطَقَ أَحَدٌ اسْمَكَ فِي الطَّرَفِ الْآخَرِ مِنَ الْغُرْفَةِ..."
 },
 {
  "i": 171,
  "start": 438.58,
  "end": 439.84,
  "text": "الْتَفَتَّ إِلَيْهِ فَوْرًا."
 },
 {
  "i": 172,
  "start": 439.84,
  "end": 443.98,
  "text": "وَمَا زَالَ الْعُلَمَاءُ يَدْرُسُونَ كَيْفَ يَفْعَلُ الدِّمَاغُ ذَلِكَ بِالضَّبْطِ."
 },
 {
  "i": 173,
  "start": 443.98,
  "end": 445.0,
  "text": "فَأُذُنُكَ تَسْمَعُ..."
 },
 {
  "i": 174,
  "start": 445.38,
  "end": 447.38,
  "text": "لَكِنَّ دِمَاغَكَ هُوَ الَّذِي يَخْتَارُ."
 },
 {
  "i": 175,
  "start": 447.88,
  "end": 456.46,
  "text": "وَفِي الْحَلْقَةِ الْقَادِمَةِ: مَاذَا لَوِ احْتَجْتَ إِلَى سَاعَةِ نَوْمٍ وَاحِدَةٍ فَقَطْ؟ مَا رَأْيُكَ؟ أَخْبِرْنَا فِي التَّعْلِيقَاتِ: لَوْ سَمِعْتَ كُلَّ أَسْرَارِ مَنْ حَوْلَكَ..."
 },
 {
  "i": 176,
  "start": 456.7,
  "end": 457.86,
  "text": "هَلْ كُنْتَ سَتُخْبِرُهُمْ؟"
 }
]